{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Dotfiles Configuration",
  "description": "Configuration schema for dotfiles symlink mappings",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Path to the JSON schema"
    },
    "mappings": {
      "type": "array",
      "description": "List of symlink mappings",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "description": "Source path relative to repository root or absolute path"
          },
          "target": {
            "description": "Target path or paths (supports $HOME and ~ variables)",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              }
            ]
          },
          "comment": {
            "type": "string",
            "description": "Optional comment for this mapping"
          },
          "sudo": {
            "type": "boolean",
            "description": "Whether to use sudo when creating/removing the symlink (for system paths outside $HOME)"
          },
          "action": {
            "type": "string",
            "enum": ["nmcli-import"],
            "description": "Special action instead of symlinking. 'nmcli-import' imports a wg-quick conf via nmcli."
          }
        },
        "oneOf": [
          {
            "required": ["source", "target"],
            "not": {
              "required": ["action"]
            }
          },
          {
            "required": ["source", "action"],
            "not": {
              "required": ["target"]
            }
          }
        ],
        "required": ["source"],
        "additionalProperties": false
      }
    }
  },
  "required": ["mappings"],
  "additionalProperties": false
}
