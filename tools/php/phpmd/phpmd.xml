<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="Default PHPMD Ruleset"
    xmlns="http://pmd.sf.net/ruleset/1.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 http://pmd.sf.net/ruleset_xml_schema.xsd"
    xsi:noNamespaceSchemaLocation="http://pmd.sf.net/ruleset_xml_schema.xsd">
    <description>
        Global PHPMD ruleset for use across multiple projects.
        Includes rules for clean code, code size, controversial practices,
        design issues, naming conventions, and unused code detection.
    </description>

    <!-- Clean Code Rules -->
    <rule ref="rulesets/cleancode.xml">
        <!-- Allow else expressions, they're sometimes more readable -->
        <exclude name="ElseExpression" />
        <!-- Static access is fine for certain patterns (factories, helpers) -->
        <exclude name="StaticAccess" />
        <!-- Boolean flags in methods can be acceptable in some cases -->
        <exclude name="BooleanArgumentFlag" />
    </rule>

    <!-- Code Size Rules -->
    <rule ref="rulesets/codesize.xml">
        <!-- Exclude too many public methods - frameworks often require this -->
        <exclude name="TooManyPublicMethods" />
        <!-- Exclude excessive class complexity - better handled by other metrics -->
        <exclude name="ExcessiveClassComplexity" />
    </rule>

    <!-- Adjust cyclomatic complexity threshold -->
    <rule ref="rulesets/codesize.xml/CyclomaticComplexity">
        <properties>
            <property name="reportLevel" value="15" />
            <property name="showClassesComplexity" value="true" />
            <property name="showMethodsComplexity" value="true" />
        </properties>
    </rule>

    <!-- Adjust NPath complexity threshold -->
    <rule ref="rulesets/codesize.xml/NPathComplexity">
        <properties>
            <property name="minimum" value="300" />
        </properties>
    </rule>

    <!-- Adjust method length -->
    <rule ref="rulesets/codesize.xml/ExcessiveMethodLength">
        <properties>
            <property name="minimum" value="150" />
            <property name="ignore-whitespace" value="true" />
        </properties>
    </rule>

    <!-- Adjust parameter list length -->
    <rule ref="rulesets/codesize.xml/ExcessiveParameterList">
        <properties>
            <property name="minimum" value="8" />
        </properties>
    </rule>

    <!-- Adjust class length -->
    <rule ref="rulesets/codesize.xml/ExcessiveClassLength">
        <properties>
            <property name="minimum" value="1500" />
            <property name="ignore-whitespace" value="true" />
        </properties>
    </rule>

    <!-- Controversial Rules -->
    <rule ref="rulesets/controversial.xml">
        <!-- Superglobals are sometimes necessary -->
        <exclude name="Superglobals" />
        <!-- Camel case for method names is not always required (test methods) -->
        <exclude name="CamelCaseMethodName" />
        <!-- Camel case for parameter names is not always required -->
        <exclude name="CamelCaseParameterName" />
        <!-- Camel case for variable names is not always required -->
        <exclude name="CamelCaseVariableName" />
    </rule>

    <!-- Design Rules -->
    <rule ref="rulesets/design.xml">
        <!-- Exit expressions can be acceptable in CLI scripts -->
        <exclude name="ExitExpression" />
        <!-- Eval is rarely needed but has valid use cases (template engines) -->
        <exclude name="EvalExpression" />
    </rule>

    <!-- Adjust coupling between objects -->
    <rule ref="rulesets/design.xml/CouplingBetweenObjects">
        <properties>
            <property name="maximum" value="20" />
        </properties>
    </rule>

    <!-- Adjust depth of inheritance -->
    <rule ref="rulesets/design.xml/DepthOfInheritance">
        <properties>
            <property name="minimum" value="8" />
        </properties>
    </rule>

    <!-- Naming Rules -->
    <rule ref="rulesets/naming.xml">
        <!-- Short variable names are acceptable in specific contexts (loops, coordinates) -->
        <exclude name="ShortVariable" />
        <!-- Long variable names can be descriptive and readable -->
        <exclude name="LongVariable" />
        <!-- Short method names are acceptable for getters/setters -->
        <exclude name="ShortMethodName" />
    </rule>

    <!-- Customize short variable rule to allow common short names -->
    <rule ref="rulesets/naming.xml/ShortVariable">
        <properties>
            <property name="minimum" value="2" />
            <property name="exceptions" value="i,j,k,x,y,z,id,db,e,ex" />
        </properties>
    </rule>

    <!-- Customize long variable rule -->
    <rule ref="rulesets/naming.xml/LongVariable">
        <properties>
            <property name="maximum" value="30" />
        </properties>
    </rule>

    <!-- Unused Code Rules -->
    <rule ref="rulesets/unusedcode.xml">
        <!-- Unused formal parameters are sometimes required by interfaces -->
        <exclude name="UnusedFormalParameter" />
    </rule>

    <!-- Custom exclusions for specific patterns -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/cache/*</exclude-pattern>
    <exclude-pattern>*/storage/*</exclude-pattern>
    <exclude-pattern>*/bootstrap/cache/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/database/migrations/*</exclude-pattern>
    <exclude-pattern>*/_ide_helper.php</exclude-pattern>
    <exclude-pattern>*.blade.php</exclude-pattern>
</ruleset>
