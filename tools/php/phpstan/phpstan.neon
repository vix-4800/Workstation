includes:
    - /home/vix/.config/composer/vendor/phpstan/phpstan/conf/bleedingEdge.neon
    - /home/vix/.config/composer/vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - /home/vix/.config/composer/vendor/phpstan/phpstan-strict-rules/rules.neon

parameters:
    parallel:
        maximumNumberOfProcesses: 8

    level: 7

    # Default paths - can be overridden in project-specific config
    paths:
        - .

    excludePaths:
        - vendor/*
        - node_modules/*
        - storage/*
        - bootstrap/cache/*
        - public/build/*
        - tests/_support/*

    checkMissingCallableSignature: true
    checkUninitializedProperties: true
    checkExplicitMixed: true
    checkExplicitMixedMissingReturn: true
    checkFunctionNameCase: true
    checkInternalClassCaseSensitivity: true
    inferPrivatePropertyTypeFromConstructor: true
    treatPhpDocTypesAsCertain: false

    reportUnmatchedIgnoredErrors: true
    reportMaybesInMethodSignatures: true
    reportStaticMethodSignatures: true

    checkMissingVarTagTypehint: true
