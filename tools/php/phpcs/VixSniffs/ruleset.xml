<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    name="VixSniffs">
    <description>Custom coding standard sniffs</description>

    <!-- Register the custom sniffs -->
    <rule ref="VixSniffs.Functions.DisallowIsNull">
        <type>warning</type>
    </rule>

    <rule ref="VixSniffs.ControlStructures.DisallowThrowInTernary">
        <type>error</type>
    </rule>
</ruleset>
