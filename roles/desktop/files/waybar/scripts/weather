#!/usr/bin/env bash

set -euo pipefail

# Weather module using wttr.in with auto-location via Geoclue

CACHE_FILE="/tmp/waybar-weather-cache"
CACHE_TIME=1800
LOCATION="${WAYBAR_WEATHER_LOCATION:-Saratov}"

emit_json() {
    local text="$1"
    local tooltip="$2"

    jq -cn --arg text "${text}" --arg tooltip "${tooltip}" '{text: $text, tooltip: $tooltip}'
}

emit_unavailable() {
    emit_json "" "Weather data unavailable"
}

get_location() {
    if command -v curl &>/dev/null && command -v jq &>/dev/null; then
        local lat lon
        lat=$(curl -s --max-time 5 "http://127.0.0.1:1777/json" 2>/dev/null | jq -r '.[0].coordinates.latitude // empty')
        lon=$(curl -s --max-time 5 "http://127.0.0.1:1777/json" 2>/dev/null | jq -r '.[0].coordinates.longitude // empty')

        if [[ -n "${lat}" && -n "${lon}" ]]; then
            echo "${lat},${lon}"
            return 0
        fi
    fi
    return 1
}

if [[ -z "${LOCATION}" ]]; then
    LOCATION=""
fi

# Check cache
if [[ -f "${CACHE_FILE}" ]]; then
    cache_age=$(($(date +%s) - $(stat -c %Y "${CACHE_FILE}")))
    if [[ "${cache_age}" -lt "${CACHE_TIME}" ]] && jq -e '
        (.text | type == "string") and
        (.tooltip | type == "string") and
        (.text | contains("null") | not) and
        (.tooltip | contains("\\n") | not) and
        (.tooltip | contains("null") | not)
    ' "${CACHE_FILE}" >/dev/null 2>&1; then
        cat "${CACHE_FILE}"
        exit 0
    fi
fi

# Fetch weather data
weather_url="https://wttr.in/${LOCATION}?format=j1"
weather_data=$(curl -fsSL --max-time 10 "${weather_url}" 2>/dev/null || true)

if [[ -z "${weather_data}" ]] || ! printf '%s' "${weather_data}" | jq -e '
    (.data // .) as $weather
    | ($weather.current_condition | type == "array")
    and ($weather.current_condition | length > 0)
    and ($weather.current_condition[0].temp_C != null)
    and ($weather.current_condition[0].FeelsLikeC != null)
    and ($weather.current_condition[0].weatherCode != null)
    and ($weather.weather | type == "array")
    and ($weather.weather | length >= 3)
' >/dev/null 2>&1; then
    if [[ -f "${CACHE_FILE}" ]] && jq -e '
        (.text | type == "string") and
        (.tooltip | type == "string") and
        (.text | contains("null") | not) and
        (.tooltip | contains("\\n") | not) and
        (.tooltip | contains("null") | not)
    ' "${CACHE_FILE}" >/dev/null 2>&1; then
        cat "${CACHE_FILE}"
        exit 0
    fi

    emit_unavailable
    exit 0
fi

# Parse JSON
temp=$(printf '%s' "${weather_data}" | jq -r '(.data // .).current_condition[0].temp_C')
feels_like=$(printf '%s' "${weather_data}" | jq -r '(.data // .).current_condition[0].FeelsLikeC')
humidity=$(printf '%s' "${weather_data}" | jq -r '(.data // .).current_condition[0].humidity')
wind_speed=$(printf '%s' "${weather_data}" | jq -r '(.data // .).current_condition[0].windspeedKmph')
wind_dir=$(printf '%s' "${weather_data}" | jq -r '(.data // .).current_condition[0].winddir16Point')
description=$(printf '%s' "${weather_data}" | jq -r '(.data // .).current_condition[0].weatherDesc[0].value')
weather_code=$(printf '%s' "${weather_data}" | jq -r '(.data // .).current_condition[0].weatherCode')
location_name=$(printf '%s' "${weather_data}" | jq -r --arg fallback "${LOCATION:-Unknown}" '(.data // .).request[0].query // $fallback')

# Determine icon based on weather code
case ${weather_code} in
    113) icon="󰖙" ;;  # Sunny/Clear
    116) icon="󰖕" ;;  # Partly cloudy
    119|122) icon="󰖐" ;;  # Cloudy
    143|248|260) icon="󰖑" ;;  # Fog
    176|263|266|281|284|293|296|299|302|305|308|311|314) icon="󰖗" ;;  # Rain (light)
    179|182|185|227|230) icon="󰖘" ;;  # Snow (light)
    317|320|323|326|329|332|335|338) icon="󰖗" ;;  # Rain (moderate)
    350|353|356|359|362|365|368|371|374|377) icon="󰖘" ;;  # Snow (heavy)
    200|386|389|392|395) icon="󰙾" ;;  # Thunder
    *) icon="󰖐" ;;
esac

# Build tooltip
tooltip="<span font_size='x-large' color='#cba6f7'><b>${description}</b></span>"
tooltip+=$'\n\n'
tooltip+="<span font_size='large'>"
tooltip+="<b>Location:</b> ${location_name}"
tooltip+=$'\n'
tooltip+="<b>Temperature:</b> ${temp}°C (feels like ${feels_like}°C)"
tooltip+=$'\n'
tooltip+="<b>Humidity:</b> ${humidity}%"
tooltip+=$'\n'
tooltip+="<b>Wind:</b> ${wind_speed} km/h ${wind_dir}"
tooltip+="</span>"
tooltip+=$'\n\n'

# Add forecast
tooltip+="<span font_size='medium' color='#89b4fa'><b>Forecast:</b></span>"
tooltip+=$'\n'
tooltip+="<tt><span font_size='small'>"

for i in 0 1 2; do
    date=$(printf '%s' "${weather_data}" | jq -r "(.data // .).weather[${i}].date")
    max_temp=$(printf '%s' "${weather_data}" | jq -r "(.data // .).weather[${i}].maxtempC")
    min_temp=$(printf '%s' "${weather_data}" | jq -r "(.data // .).weather[${i}].mintempC")
    desc=$(printf '%s' "${weather_data}" | jq -r "(.data // .).weather[${i}].hourly[4].weatherDesc[0].value")

    day_name=$(date -d "${date}" +"%a")
    tooltip+="${day_name}: ${min_temp}°-${max_temp}°C, ${desc}"
    tooltip+=$'\n'
done

tooltip+="</span></tt>"

# Output
text="${icon} ${temp}°C"
output=$(emit_json "${text}" "${tooltip}")

# Cache the result
echo "${output}" > "${CACHE_FILE}"
echo "${output}"
