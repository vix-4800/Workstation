#!/usr/bin/env bash

ACTIVE_FILE="${HOME}/.config/sing-box/.active-profile"

get_active_wg() {
    nmcli -t -f NAME,TYPE,STATE connection show --active 2>/dev/null \
        | grep ':wireguard:activated' | cut -d: -f1 | head -1 || true
}

is_singbox_active() {
    systemctl is-active --quiet sing-box 2>/dev/null
}

get_active_vless() {
    [[ -f "$ACTIVE_FILE" ]] && cat "$ACTIVE_FILE" || echo ""
}

wg_name=$(get_active_wg)
vless_name=""
if is_singbox_active; then
    vless_name=$(get_active_vless)
fi

if [[ -n "$wg_name" ]]; then
    echo "{\"text\": \"󰦝\", \"class\": \"connected\", \"tooltip\": \"WireGuard: ${wg_name}\"}"
elif [[ -n "$vless_name" ]]; then
    echo "{\"text\": \"󰦝\", \"class\": \"connected\", \"tooltip\": \"VLESS: ${vless_name}\"}"
else
    echo "{\"text\": \"󰦞\", \"class\": \"disconnected\", \"tooltip\": \"VPN Disconnected\"}"
fi
