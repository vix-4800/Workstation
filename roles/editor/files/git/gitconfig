[include]
path = ~/.gitconfig.user
path = ~/.gitconfig.delta

[credential "https://github.com"]
helper =
helper = !/usr/bin/gh auth git-credential

[credential "https://gist.github.com"]
helper =
helper = !/usr/bin/gh auth git-credential

[core]
autocrlf = input
fscache = true
quotePath = false

[init]
defaultBranch = main

[commit]
verbose = true

[pull]
rebase = true

[push]
autoSetupRemote = true
default = current
useForceIfIncludes = true

[fetch]
prune = true
writeCommitGraph = true

[rebase]
autoStash = true
autoSquash = true
missingCommitsCheck = warn

[merge]
conflictStyle = zdiff3

[rerere]
enabled = true

[diff]
algorithm = histogram
colorMoved = default

[log]
date = relative

[status]
showStash = true

[branch]
sort = -committerdate

[tag]
sort = -version:refname

[http]
lowSpeedLimit = 1000
lowSpeedTime = 60

[feature]
manyFiles = true

[help]
autoCorrect = prompt

[maintenance]
strategy = incremental
