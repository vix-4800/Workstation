[user]
	name = Your Name
	email = your.email@example.com

[include]
	path = ~/.gitconfig.delta

[credential "https://github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential

[core]
	autocrlf = input
	untrackedCache = true
	preloadIndex = true
	fscache = true

[init]
	defaultBranch = main

[pull]
	rebase = true

[push]
	autoSetupRemote = true
	default = current

[fetch]
	prune = true
	pruneTags = true
	writeCommitGraph = true

[rebase]
	autoStash = true
	autoSquash = true

[diff]
	algorithm = histogram
	colorMoved = default

[log]
	date = relative

[branch]
	sort = -committerdate

[http]
	postBuffer = 524288000
	lowSpeedLimit = 1000
	lowSpeedTime = 60

[pack]
	threads = 0
	windowMemory = 256m

[feature]
	manyFiles = true

[gc]
	auto = 256

[maintenance]
	strategy = incremental
