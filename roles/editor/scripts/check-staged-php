#!/usr/bin/env bash
set -euo pipefail

root=$(git rev-parse --show-toplevel)
cd "${root}"

git diff --cached --name-only --diff-filter=ACMR -z -- '*.php' |
while IFS= read -r -d '' path; do
    if ! output=$(git show ":${path}" | php -l 2>&1); then
        printf '%s:\n%s\n' "${path}" "${output}" >&2
        exit 1
    fi
done
