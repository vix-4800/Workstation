#!/usr/bin/env bash
set -euo pipefail

if (( $# == 0 )); then
    exec gitleaks git --config "${HOME}/.gitleaks.toml" --staged --redact --no-banner
fi

# pre-push supplies the remote name and URL, plus ref updates on stdin.
while read -r _local_ref local_oid _remote_ref remote_oid; do
    [[ "${local_oid}" =~ ^0+$ ]] && continue

    range="${local_oid}"
    if [[ ! "${remote_oid}" =~ ^0+$ ]] && git cat-file -e "${remote_oid}^{commit}" 2>/dev/null; then
        range="${remote_oid}..${local_oid}"
    fi

    gitleaks git --config "${HOME}/.gitleaks.toml" --log-opts="${range}" --redact --no-banner
done
