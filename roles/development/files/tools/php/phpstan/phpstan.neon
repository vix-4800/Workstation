includes:
    - phar://phpstan.phar/conf/bleedingEdge.neon

parameters:
    parallel:
        processTimeout: 900.0

    level: max
    reportIgnoresWithoutComments: true

    excludePaths:
        - vendor/*
        - node_modules/*
        - storage/*
        - bootstrap/cache/*
        - public/build/*
        - tests/*

    # Vague typehints
    checkMissingCallableSignature: true

    # Property checks
    checkUninitializedProperties: true
    checkDynamicProperties: true

    # Mixed type checks
    checkImplicitMixed: true
    checkExplicitMixedMissingReturn: true

    # Make strict-rules intent explicit
    strictRules:
        allRules: true

    # Case sensitivity checks
    checkFunctionNameCase: true
    checkInternalClassCaseSensitivity: true

    # Type inference
    inferPrivatePropertyTypeFromConstructor: true
    treatPhpDocTypesAsCertain: false

    # Return type checks
    checkTooWideReturnTypesInProtectedAndPublicMethods: true
    checkTooWideParameterOutInProtectedAndPublicMethods: true
    checkTooWideThrowTypesInProtectedAndPublicMethods: true

    # Error reporting
    reportUnmatchedIgnoredErrors: true
    reportMaybesInMethodSignatures: true
    reportMaybesInPropertyPhpDocTypes: true
    reportStaticMethodSignatures: true
    reportNonIntStringArrayKey: true
    reportWrongPhpDocTypeInVarTag: true
    reportAnyTypeWideningInVarTag: true

    # Variable scoping (stricter analysis)
    polluteScopeWithLoopInitialAssignments: false
    polluteScopeWithAlwaysIterableForeach: false

    # PHPDoc checks
    checkMissingVarTagTypehint: true

    # Array offset checks
    reportPossiblyNonexistentGeneralArrayOffset: true
    reportPossiblyNonexistentConstantArrayOffset: true

    # Benevolent union types
    checkBenevolentUnionTypes: true

    # Conditional checks
    reportAlwaysTrueInLastCondition: true

    # Function purity
    rememberPossiblyImpureFunctionValues: true

    checkStrictPrintfPlaceholderTypes: true
    checkMissingOverrideMethodAttribute: true
    checkMissingOverridePropertyAttribute: true
    polluteScopeWithBlock: false

    # Reference parameter checks
    checkArgumentsPassedByReference: true

    usePathConstantsAsConstantString: true

    exceptions:
        implicitThrows: false

        uncheckedExceptionClasses:
            # - LogicException
            # - BadFunctionCallException
            # - BadMethodCallException
            # - DomainException
            # - InvalidArgumentException
            # - LengthException
            # - OutOfRangeException
            # - RuntimeException

            # PHP Native Errors
            - Error
            - TypeError
            - ValueError
            # - ArithmeticError
            # - DivisionByZeroError
            # - UnhandledMatchError
        reportUncheckedExceptionDeadCatch: true
        check:
            missingCheckedExceptionInThrows: true
            tooWideThrowType: true
            throwTypeCovariance: true
            tooWideImplicitThrowType: true

    phpat:
        ignore_built_in_classes: true

    phpstanRules:
        yii2:
            rules:
                all: false
