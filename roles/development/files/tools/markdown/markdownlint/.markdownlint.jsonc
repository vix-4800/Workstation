{
  "default": true,

  // ─────────────────────────────────────────────────────────────
  // Headings
  // ─────────────────────────────────────────────────────────────
  "MD001": true,
  "MD003": { "style": "atx" },
  "MD018": true,
  "MD019": true,
  "MD020": true,
  "MD021": true,
  "MD022": true,
  "MD023": true,
  "MD024": { "siblings_only": true },
  "MD025": true,
  "MD026": { "punctuation": ".,;:!。，；：！" },
  "MD036": true,
  "MD041": false,
  "MD043": true,

  // ─────────────────────────────────────────────────────────────
  // Lists
  // ─────────────────────────────────────────────────────────────
  "MD004": { "style": "dash" },
  "MD005": true,
  "MD006": true,
  "MD007": { "indent": 2, "start_indented": false },
  "MD029": { "style": "ordered" },
  "MD030": {
    "ul_single": 1,
    "ol_single": 1,
    "ul_multi": 1,
    "ol_multi": 1
  },
  "MD032": true,

  // ─────────────────────────────────────────────────────────────
  // Whitespace & Formatting
  // ─────────────────────────────────────────────────────────────
  "MD009": { "br_spaces": 2, "list_item_empty_lines": false, "strict": true },
  "MD010": { "code_blocks": true, "spaces_per_tab": 4 },
  "MD012": { "maximum": 1 },
  "MD027": true,
  "MD028": true,
  "MD037": true,
  "MD038": true,
  "MD039": true,
  "MD047": true,
  "MD049": { "style": "asterisk" },
  "MD050": { "style": "asterisk" },

  // ─────────────────────────────────────────────────────────────
  // Links & Images
  // ─────────────────────────────────────────────────────────────
  "MD034": true,
  "MD042": true,
  "MD044": true,
  "MD045": true,
  "MD051": true,
  "MD052": true,
  "MD053": true,

  // ─────────────────────────────────────────────────────────────
  // Code Blocks
  // ─────────────────────────────────────────────────────────────
  "MD014": true,
  "MD031": true,
  "MD040": true,
  "MD046": { "style": "fenced" },
  "MD048": { "style": "backtick" },

  // ─────────────────────────────────────────────────────────────
  // Line Length & Special Cases
  // ─────────────────────────────────────────────────────────────
  "MD013": {
    "line_length": 120,
    "heading_line_length": 120,
    "code_block_line_length": 120,
    "tables": false,
    "code_blocks": false,
    "headings": false,
    "strict": false,
    "stern": false
  },

  // ─────────────────────────────────────────────────────────────
  // HTML & Special Characters
  // ─────────────────────────────────────────────────────────────
  "MD033": false,

  // ─────────────────────────────────────────────────────────────
  // Misc Rules
  // ─────────────────────────────────────────────────────────────
  "MD011": true,
  "MD035": { "style": "---" },
  "MD054": { "autolink": true, "inline": true, "full": true, "collapsed": true, "shortcut": true }
}
