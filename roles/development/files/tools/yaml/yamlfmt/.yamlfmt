---
line_ending: lf
gitignore_excludes: true

formatter:
  type: basic
  indent: 2
  include_document_start: true
  retain_line_breaks_single: true
  trim_trailing_whitespace: true
  eof_newline: true
  pad_line_comments: 1
  max_line_length: 120
  force_quote_style: single
  force_array_style: block
