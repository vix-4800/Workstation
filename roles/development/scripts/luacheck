#!/usr/bin/env bash

set -euo pipefail

readonly local_luacheck="$HOME/.luarocks/bin/luacheck"

if [[ ! -x "$local_luacheck" ]]; then
    echo "luacheck is not installed for Lua 5.4" >&2
    echo "Run: luarocks --lua-version 5.4 install --local luacheck" >&2
    exit 1
fi

exec "$local_luacheck" "$@"
