#!/usr/bin/env bash

# Check for global Composer package updates
# Shows notification if updates are available

set -euo pipefail

readonly RED='\033[0;31m'
readonly GRN='\033[0;32m'
readonly YLW='\033[1;33m'
readonly NC='\033[0m'

msg() { echo -e "${1}"; }
ok() { msg "${GRN}✓${NC} ${1}"; }
warn() { msg "${YLW}⚠${NC} ${1}"; }
err() { msg "${RED}✗${NC} ${1}"; }

if ! command -v composer &>/dev/null; then
    err "Composer is not installed"
    exit 1
fi

OUTDATED=$(composer global outdated --direct --format=json 2>/dev/null || echo '{"installed":[]}')
COUNT=$(echo "${OUTDATED}" | jq '.installed | length')

if [[ "${COUNT}" -gt 0 ]]; then
    PACKAGES=$(echo "${OUTDATED}" | jq -r '.installed[] | "\(.name): \(.version) → \(.latest)"' | head -5)

    if [[ "${COUNT}" -gt 5 ]]; then
        PACKAGES="${PACKAGES}\n...and $((COUNT - 5)) more"
    fi

    notify-send \
        -u normal \
        -i software-update-available \
        "Composer Updates Available" \
        "${COUNT} package(s) can be updated:\n\n${PACKAGES}\n\nRun: composer global update"

    ok "${COUNT} package(s) have updates available"
else
    ok "All global Composer packages are up to date"
fi
