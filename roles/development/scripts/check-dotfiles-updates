#!/usr/bin/env bash

# Check for dotfiles repository updates on GitHub
# Shows notification if updates are available

set -euo pipefail

# Colors for output
readonly RED='\033[0;31m'
readonly GRN='\033[0;32m'
readonly YLW='\033[1;33m'
readonly NC='\033[0m'

# Logging functions
msg() { echo -e "${1}"; }
ok() { msg "${GRN}✓${NC} ${1}"; }
warn() { msg "${YLW}⚠${NC} ${1}"; }
err() { msg "${RED}✗${NC} ${1}"; }

# Determine repository root directory by following symlink
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "${SCRIPT_PATH}")"
if ! REPO_ROOT="$(git -C "${SCRIPT_DIR}" rev-parse --show-toplevel 2>/dev/null)"; then
    err "Unable to determine git repository root from: ${SCRIPT_DIR}"
    exit 1
fi
cd "${REPO_ROOT}"

if ! CURRENT_BRANCH="$(git symbolic-ref --quiet --short HEAD)"; then
    exit 0
fi

# Fetch latest changes from origin (quietly)
if ! git fetch origin --quiet 2>/dev/null; then
    err "Failed to fetch from origin"
    exit 1
fi

if ! git show-ref --verify --quiet "refs/remotes/origin/${CURRENT_BRANCH}"; then
    exit 0
fi

COMMITS_BEHIND=$(git rev-list --count "HEAD..refs/remotes/origin/${CURRENT_BRANCH}")
if (( COMMITS_BEHIND > 0 )); then
    # Send notification
    notify-send \
        -u normal \
        -i software-update-available \
        "Dotfiles Updates Available" \
        "${COMMITS_BEHIND} new commit(s) on ${CURRENT_BRANCH}\n\nRun: cd ${REPO_ROOT} && git pull"

    ok "Updates available: ${COMMITS_BEHIND} commit(s) behind origin/${CURRENT_BRANCH}"
    exit 0
else
    # No updates needed (only log when run manually)
    if [[ -t 1 ]]; then
        ok "Dotfiles are up to date"
    fi
    exit 0
fi
