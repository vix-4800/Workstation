# Codex rules only apply to commands that would run outside the sandbox.
# Unlike Claude's permissions model, they do not support path-based read rules.
# Read-only inspection commands are allowlisted here; mutating operations remain
# in prompt.rules so the user keeps explicit control outside the sandbox.

prefix_rule(
    pattern = ["ansible-lint"],
    decision = "allow",
    justification = "Low-risk inspection command approved for Codex outside the sandbox.",
)

prefix_rule(
    pattern = ["awk"],
    decision = "allow",
    justification = "Read-only text processing; no side effects.",
)

prefix_rule(
    pattern = ["basename"],
    decision = "allow",
    justification = "Read-only path utility; no side effects.",
)

prefix_rule(
    pattern = ["cat"],
    decision = "allow",
    justification = "Read-only file display; no side effects.",
)

prefix_rule(
    pattern = ["composer", ["info", "show", "validate"]],
    decision = "allow",
    justification = "Low-risk inspection command approved for Codex outside the sandbox.",
)

prefix_rule(
    pattern = ["cut"],
    decision = "allow",
    justification = "Read-only text processing; no side effects.",
)

prefix_rule(
    pattern = ["diff"],
    decision = "allow",
    justification = "Read-only comparison; no side effects.",
)

prefix_rule(
    pattern = ["dirname"],
    decision = "allow",
    justification = "Read-only path utility; no side effects.",
)

prefix_rule(
    pattern = ["docker", ["images", "info", "inspect", "logs", "ps", "stats", "version"]],
    decision = "allow",
    justification = "Low-risk inspection command approved for Codex outside the sandbox.",
)

prefix_rule(
    pattern = ["docker", "compose", ["logs", "ps"]],
    decision = "allow",
    justification = "Low-risk inspection command approved for Codex outside the sandbox.",
)

prefix_rule(
    pattern = ["echo"],
    decision = "allow",
    justification = "Read-only output command; no side effects.",
)

prefix_rule(
    pattern = ["env"],
    decision = "allow",
    justification = "Read-only environment inspection; no side effects.",
)

prefix_rule(
    pattern = ["file"],
    decision = "allow",
    justification = "Read-only file type detection; no side effects.",
)

prefix_rule(
    pattern = ["find"],
    decision = "allow",
    justification = "Read-only filesystem search; no side effects.",
)

prefix_rule(
    pattern = ["gh", "pr", "diff"],
    decision = "allow",
    justification = "Low-risk inspection command approved for Codex outside the sandbox.",
)

prefix_rule(
    pattern = ["gh", "pr", "view"],
    decision = "allow",
    justification = "Viewing PRs is allowed without user approval",
    match = [
        "gh pr view",
        "gh pr view *",
        "gh pr view * --repo",
        "gh pr view * --repo *",
        "gh pr view * --repo * --json",
        "gh pr view * --repo * --json *",
    ]
)

prefix_rule(
    pattern = ["git", ["branch", "diff", "grep", "log", "ls-files", "rev-parse", "show", "status"]],
    decision = "allow",
    justification = "Low-risk inspection command approved for Codex outside the sandbox.",
)

prefix_rule(
    pattern = ["git", "remote", "-v"],
    decision = "allow",
    justification = "Low-risk inspection command approved for Codex outside the sandbox.",
)

prefix_rule(
    pattern = ["go", ["build", "fmt", "test", "vet"]],
    decision = "allow",
    justification = "Standard Go toolchain commands; no destructive side effects.",
)

prefix_rule(
    pattern = ["gofmt"],
    decision = "allow",
    justification = "Standard Go formatter; consistent with go fmt.",
)

prefix_rule(
