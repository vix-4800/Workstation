# Codex rules only apply to commands that would run outside the sandbox.
# Unlike Claude's permissions model, they do not support path-based read rules.
# Read-only inspection commands are allowlisted here; mutating operations remain
# in prompt.rules so the user keeps explicit control outside the sandbox.

prefix_rule(
    pattern = ["ansible-lint"],
    decision = "allow",
    justification = "Low-risk inspection command approved for Codex outside the sandbox.",
)

prefix_rule(
    pattern = ["awk"],
    decision = "allow",
    justification = "Read-only text processing; no side effects.",
)

prefix_rule(
    pattern = ["basename"],
    decision = "allow",
    justification = "Read-only path utility; no side effects.",
)

prefix_rule(
    pattern = ["cat"],
    decision = "allow",
    justification = "Read-only file display; no side effects.",
)

prefix_rule(
    pattern = ["composer", ["info", "show", "validate", "prohibits"]],
    decision = "allow",
    justification = "Low-risk inspection command approved for Codex outside the sandbox.",
)

prefix_rule(
    pattern = ["cut"],
    decision = "allow",
    justification = "Read-only text processing; no side effects.",
)

prefix_rule(
    pattern = ["diff"],
    decision = "allow",
    justification = "Read-only comparison; no side effects.",
)

prefix_rule(
    pattern = ["dirname"],
    decision = "allow",
    justification = "Read-only path utility; no side effects.",
)

prefix_rule(
    pattern = ["docker", ["images", "info", "inspect", "logs", "ps", "stats", "version"]],
    decision = "allow",
    justification = "Low-risk inspection command approved for Codex outside the sandbox.",
)

prefix_rule(
    pattern = ["docker", "compose", ["logs", "ps"]],
    decision = "allow",
    justification = "Low-risk inspection command approved for Codex outside the sandbox.",
)

prefix_rule(
    pattern = ["echo"],
    decision = "allow",
    justification = "Read-only output command; no side effects.",
)

prefix_rule(
    pattern = ["env"],
    decision = "allow",
    justification = "Read-only environment inspection; no side effects.",
)

prefix_rule(
    pattern = ["file"],
    decision = "allow",
    justification = "Read-only file type detection; no side effects.",
)

prefix_rule(
    pattern = ["find"],
    decision = "allow",
    justification = "Read-only filesystem search; no side effects.",
)

prefix_rule(pattern=["gh", "auth", "status"], decision="allow")
prefix_rule(pattern=["gh", "run", "view"], decision="allow")

prefix_rule(
    pattern = ["gh", "pr", "diff"],
    decision = "allow",
    justification = "Viewing PR diffs is allowed without user approval",
    match = [
        "gh pr diff 1234",
    ],
    not_match = [
        "gh pr checkout 1234",
        "gh issue view 1",
    ],
)

prefix_rule(
    pattern = ["gh", "pr", "view"],
    decision = "allow",
    justification = "Viewing PR metadata is allowed without user approval",
    match = [
        "gh pr view 1234 --json number,title,url,body,headRefName,baseRefName,author,state,mergeStateStatus",
    ],
    not_match = [
        "gh pr checkout 1234",
        "gh issue view 1",
    ],
)

prefix_rule(
    pattern = ["gh", "repo", "view"],
    decision = "allow",
    justification = "Viewing repo metadata is allowed without user approval",
    match = [
        "gh repo view owner/repo --json name,description,url,createdAt,updatedAt,owner",
    ],
    not_match = [
        "gh pr view 1",
        "gh issue view 1",
    ],
)

prefix_rule(
    pattern = ["gh", "issue", "view"],
    decision = "allow",
    justification = "Viewing issue metadata is allowed without user approval",
    match = [
        "gh issue view 1234 --json number,title,url,body,author,state",
    ],
    not_match = [
        "gh pr checkout 1234",
        "gh pr view 1",
    ],
)

