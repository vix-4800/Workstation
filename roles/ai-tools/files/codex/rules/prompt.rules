prefix_rule(
    pattern = ["chmod"],
    decision = "prompt",
    justification = "Modifies file permissions; keep approval-gated outside the sandbox.",
)

prefix_rule(
    pattern = ["composer", ["install", "remove", "require", "update"]],
    decision = "prompt",
    justification = "Modifies vendor directory; keep approval-gated outside the sandbox.",
)

prefix_rule(
    pattern = ["docker", ["exec", "pull", "run", "start"]],
    decision = "prompt",
    justification = "Mutates container state; keep approval-gated outside the sandbox.",
)

prefix_rule(
    pattern = ["docker", "compose", ["exec", "pull"]],
    decision = "prompt",
    justification = "Mutates container state; keep approval-gated outside the sandbox.",
)

prefix_rule(
    pattern = ["git", ["checkout", "commit", "fetch", "pull", "restore", "stash", "switch", "tag"]],
    decision = "prompt",
    justification = "Mutates git state; keep approval-gated outside the sandbox.",
)

prefix_rule(
    pattern = ["npm", ["install", "update"]],
    decision = "prompt",
    justification = "Modifies node_modules; keep approval-gated outside the sandbox.",
)

prefix_rule(
    pattern = ["pip", "install"],
    decision = "prompt",
    justification = "Modifies Python environment; keep approval-gated outside the sandbox.",
)

prefix_rule(
    pattern = ["pnpm", ["add", "install", "update"]],
    decision = "prompt",
    justification = "Modifies node_modules; keep approval-gated outside the sandbox.",
)

prefix_rule(
    pattern = ["sed"],
    decision = "prompt",
    justification = "Can modify files in-place with -i; keep approval-gated outside the sandbox.",
)

prefix_rule(
    pattern = ["xargs"],
    decision = "prompt",
    justification = "Executes arbitrary commands from input; keep approval-gated outside the sandbox.",
)

prefix_rule(
    pattern = ["yarn", ["add", "install"]],
    decision = "prompt",
    justification = "Modifies node_modules; keep approval-gated outside the sandbox.",
)
