{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": "notify",
  "formatter": {
    "markdownlint": {
      "command": ["markdownlint", "$FILE"],
      "extensions": [".md"]
    },
    "php-cs-fixer": {
      "command": [
        "php-cs-fixer",
        "fix",
        "--config",
        "$HOME/.config/php-cs-fixer/php-cs-fixer.php",
        "--quiet",
        "$FILE"
      ],
      "extensions": [".php"]
    },
    "shfmt": {
      "command": ["shfmt", "-w", "-i", "4", "$FILE"],
      "extensions": [".sh", ".bash"]
    }
  },
  "mcp": {
    "context7": {
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"]
    }
  },
  "model": "github-copilot/claude-sonnet-4.6",
  "permission": {
    "bash": {
      "*": "ask",
      "git *": "allow",
      "git commit *": "deny",
      "git push *": "deny",
      "grep *": "allow"
    },
    "codesearch": "ask",
    "external_directory": "ask",
    "lsp": "allow",
    "question": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny"
    },
    "skill": "allow",
    "webfetch": "ask",
    "websearch": "ask"
  },
  "plugin": ["@mohak34/opencode-notifier@latest", "opencode-wakatime"]
}
