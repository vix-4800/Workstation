{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": "notify",
  "formatter": {
    "markdownlint": {
      "command": ["markdownlint", "$FILE"],
      "extensions": [".md"]
    },
    "php-cs-fixer": {
      "command": [
        "php-cs-fixer",
        "fix",
        "--config",
        "$HOME/.config/php-cs-fixer/php-cs-fixer.php",
        "--quiet",
        "$FILE"
      ],
      "extensions": [".php"]
    },
    "shfmt": {
      "command": ["shfmt", "-w", "-i", "4", "$FILE"],
      "extensions": [".sh", ".bash"]
    }
  },
  "mcp": {
    "context7": {
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "github": {
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "type": "local"
    },
    "serena": {
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "codex",
        "--open-web-dashboard",
        "False"
      ],
      "type": "local"
    },
    "playwright": {
      "command": ["npx", "-y", "@playwright/mcp@latest", "--browser=firefox"],
      "type": "local"
    }
  },
  "model": "openai/gpt-5.4",
  "provider": {
    "openai": {
      "models": {
        "gpt-5.4": {
          "options": {
            "textVerbosity": "low",
            "reasoningSummary": "auto"
          }
        }
      }
    }
  },
  "permission": {
    "bash": {
      "./vendor/bin/*": "allow",
      "ansible-lint *": "allow",
      "awk *": "allow",
      "basename *": "allow",
      "bat *": "allow",
      "cat *": "allow",
      "chmod *": "ask",
      "composer audit *": "allow",
      "composer check-platform-reqs *": "allow",
      "composer dump-autoload *": "allow",
      "composer info *": "allow",
      "composer install *": "ask",
      "composer outdated *": "allow",
      "composer remove *": "ask",
      "composer require *": "ask",
      "composer show *": "allow",
      "composer update *": "ask",
      "composer validate *": "allow",
      "curl *": "deny",
      "cut *": "allow",
      "diff *": "allow",
      "dirname *": "allow",
      "doas *": "deny",
      "docker compose down *": "deny",
      "docker compose exec *": "ask",
      "docker compose logs *": "allow",
      "docker compose ps *": "allow",
      "docker compose pull *": "ask",
      "docker compose restart *": "deny",
      "docker compose up *": "deny",
      "docker exec *": "ask",
      "docker images *": "allow",
      "docker info *": "allow",
      "docker inspect *": "allow",
      "docker kill *": "deny",
      "docker logs *": "allow",
      "docker network rm *": "deny",
      "docker ps *": "allow",
      "docker pull *": "ask",
      "docker restart *": "deny",
      "docker rm *": "deny",
      "docker rmi *": "deny",
      "docker run *": "ask",
      "docker start *": "ask",
      "docker stats *": "allow",
      "docker stop *": "deny",
      "docker system prune *": "deny",
      "docker version *": "allow",
      "docker volume rm *": "deny",
      "echo *": "allow",
      "env": "allow",
      "eza *": "allow",
      "fd *": "allow",
      "file *": "allow",
      "find *": "allow",
      "gh pr diff *": "allow",
      "gh pr view *": "allow",
      "git am *": "deny",
      "git apply *": "deny",
      "git branch *": "allow",
      "git checkout *": "ask",
      "git cherry-pick *": "deny",
      "git clean *": "deny",
      "git commit *": "ask",
      "git diff *": "allow",
      "git fetch *": "ask",
      "git grep *": "allow",
      "git log *": "allow",
      "git ls-files *": "allow",
      "git merge *": "deny",
      "git pull *": "ask",
      "git push *": "deny",
      "git rebase *": "deny",
      "git remote -v": "allow",
      "git reset *": "deny",
      "git restore *": "ask",
      "git rev-parse *": "allow",
      "git show *": "allow",
      "git stash *": "ask",
      "git status *": "allow",
      "git switch *": "ask",
      "git tag *": "ask",
      "go build *": "allow",
      "go fmt *": "allow",
      "go test *": "allow",
      "go vet *": "allow",
      "gofmt *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "jq *": "allow",
      "ls *": "allow",
      "luac *": "allow",
      "nc *": "deny",
      "netcat *": "deny",
      "npm audit *": "allow",
      "npm install *": "ask",
      "npm outdated *": "allow",
      "npm run test:*": "allow",
      "npm test:*": "allow",
      "npm update *": "ask",
      "php --version": "allow",
      "php -l *": "ask",
      "php -m *": "allow",
      "php artisan list *": "allow",
      "php artisan route:list *": "allow",
      "php artisan tinker *": "deny",
      "pip install *": "ask",
      "pnpm add *": "ask",
      "pnpm install *": "ask",
      "pnpm update *": "ask",
      "pwd": "allow",
      "readlink *": "allow",
      "realpath *": "allow",
      "rg *": "allow",
      "rm *": "deny",
      "rsync *": "deny",
      "scp *": "deny",
      "sed *": "allow",
      "sftp *": "deny",
      "shellcheck *": "allow",
      "sort *": "allow",
      "ssh *": "deny",
      "stat *": "allow",
      "sudo *": "deny",
      "tail *": "allow",
      "tree *": "allow",
      "uniq *": "allow",
      "vendor/bin/*": "allow",
      "wc *": "allow",
      "wget *": "deny",
      "which *": "allow",
      "xargs *": "allow",
      "yamllint *": "allow",
      "yarn add *": "ask",
      "yarn install *": "ask",
      "*": "ask"
    },
    "codesearch": "ask",
    "doom_loop": "ask",
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny"
    },
    "external_directory": "ask",
    "lsp": "allow",
    "question": "allow",
    "read": {
      "./inventory/host_vars/**": "deny",
      "./secrets/**": "deny",
      "./vault/**": "deny",
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "~/.aws/**": "deny",
      "~/.gnupg/**": "deny",
      "~/.kube/**": "deny",
      "~/.ssh/**": "deny"
    },
    "skill": "allow",
    "task": "ask",
    "webfetch": "ask",
    "websearch": "ask"
  },
  "plugin": ["@mohak34/opencode-notifier@latest", "opencode-wakatime"]
}
