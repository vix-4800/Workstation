{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "everything-claude-code@everything-claude-code": true,
    "github@claude-plugins-official": false,
    "lua-lsp@claude-plugins-official": true,
    "php-lsp@claude-plugins-official": true,
    "prompts.chat@prompts.chat": true,
    "security-guidance@claude-plugins-official": true,
    "serena@claude-plugins-official": true
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "MCP_TIMEOUT": "60000"
  },
  "extraKnownMarketplaces": {
    "everything-claude-code": {
      "source": {
        "repo": "affaan-m/everything-claude-code",
        "source": "github"
      }
    },
    "prompts.chat": {
      "source": {
        "repo": "f/prompts.chat",
        "source": "github"
      }
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "case \"$CLAUDE_FILE_PATH\" in *.php) php -l \"$CLAUDE_FILE_PATH\";; esac",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "Write|Edit"
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(awk)",
      "Bash(awk *)",
      "Bash(basename)",
      "Bash(basename *)",
      "Bash(cat)",
      "Bash(cat *)",
      "Bash(cut)",
      "Bash(cut *)",
      "Bash(diff)",
      "Bash(diff *)",
      "Bash(dirname)",
      "Bash(dirname *)",
      "Bash(docker compose logs)",
      "Bash(docker compose logs *)",
      "Bash(docker compose ps)",
      "Bash(docker compose ps *)",
      "Bash(docker images)",
      "Bash(docker images *)",
      "Bash(docker info)",
      "Bash(docker info *)",
      "Bash(docker inspect)",
      "Bash(docker inspect *)",
      "Bash(docker logs)",
      "Bash(docker logs *)",
      "Bash(docker ps)",
      "Bash(docker ps *)",
      "Bash(docker stats)",
      "Bash(docker stats *)",
      "Bash(docker version)",
      "Bash(docker version *)",
      "Bash(echo)",
      "Bash(echo *)",
      "Bash(env)",
      "Bash(file)",
      "Bash(file *)",
      "Bash(find)",
      "Bash(find *)",
      "Bash(git branch)",
      "Bash(git branch *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git grep)",
      "Bash(git grep *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git ls-files)",
      "Bash(git ls-files *)",
      "Bash(git remote -v)",
      "Bash(git rev-parse)",
      "Bash(git rev-parse *)",
      "Bash(git show)",
      "Bash(git show *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(grep)",
      "Bash(grep *)",
      "Bash(head)",
      "Bash(head *)",
      "Bash(jq)",
      "Bash(jq *)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(php --version)",
      "Bash(php -l *)",
      "Bash(php -m)",
      "Bash(php -m *)",
      "Bash(readlink)",
      "Bash(readlink *)",
      "Bash(realpath)",
      "Bash(realpath *)",
      "Bash(rg)",
      "Bash(rg *)",
      "Bash(sed)",
      "Bash(sed *)",
      "Bash(sort)",
      "Bash(sort *)",
      "Bash(stat)",
      "Bash(stat *)",
      "Bash(tail)",
      "Bash(tail *)",
      "Bash(tree)",
      "Bash(tree *)",
      "Bash(uniq)",
      "Bash(uniq *)",
      "Bash(wc)",
      "Bash(wc *)",
      "Bash(which)",
      "Bash(which *)",
      "Bash(xargs)",
      "Bash(xargs *)"
    ],
    "ask": [
      "Bash(chmod *)",
      "Bash(composer install *)",
      "Bash(composer remove *)",
      "Bash(composer require *)",
      "Bash(composer update *)",
      "Bash(docker compose exec *)",
      "Bash(docker compose pull *)",
      "Bash(docker exec *)",
      "Bash(docker pull *)",
      "Bash(docker run *)",
      "Bash(docker start *)",
      "Bash(git checkout *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git restore *)",
      "Bash(git stash *)",
      "Bash(git switch *)",
      "Bash(git tag *)",
      "Bash(npm install *)",
      "Bash(npm update *)",
      "Bash(pip install *)",
      "Bash(pnpm add *)",
      "Bash(pnpm install *)",
      "Bash(pnpm update *)",
      "Bash(yarn add *)",
      "Bash(yarn install *)"
    ],
    "defaultMode": "acceptEdits",
    "deny": [
      "Bash(curl *)",
      "Bash(doas *)",
      "Bash(git am *)",
      "Bash(git apply *)",
      "Bash(git cherry-pick *)",
      "Bash(git clean *)",
      "Bash(git merge *)",
      "Bash(git push *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(nc *)",
      "Bash(netcat *)",
      "Bash(rm *)",
      "Bash(rsync *)",
      "Bash(scp *)",
      "Bash(sftp *)",
      "Bash(ssh *)",
      "Bash(sudo *)",
      "Bash(wget *)",
      "Bash(docker compose build *)",
      "Bash(docker compose down *)",
      "Bash(docker compose restart *)",
      "Bash(docker compose up *)",
      "Bash(docker kill *)",
      "Bash(docker network rm *)",
      "Bash(docker restart *)",
      "Bash(docker rm *)",
      "Bash(docker rmi *)",
      "Bash(docker stop *)",
      "Bash(docker system prune *)",
      "Bash(docker volume rm *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./inventory/host_vars/**)",
      "Read(./secrets/**)",
      "Read(./vault/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/**)",
      "Read(~/.ssh/**)"
    ]
  },
  "statusLine": {
    "command": "npx -y @owloops/claude-powerline@latest --style=powerline --theme=custom --config=$HOME/.claude/claude-powerline.json",
    "type": "command"
  }
}
