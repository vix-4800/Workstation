{
  "theme": "custom",
  "display": {
    "colorCompatibility": "auto",
    "lines": [
      {
        "segments": {
          "directory": {
            "enabled": false,
            "style": "fish"
          },
          "git": {
            "enabled": true,
            "showWorkingTree": true,
            "showUpstream": false
          },
          "model": {
            "enabled": true
          },
          "context": {
            "enabled": true,
            "displayStyle": "blocks"
          }
        }
      }
    ]
  },
  "colors": {
    "custom": {
      "directory": {
        "bg": "#b4befe",
        "fg": "#1e1e2e"
      },
      "git": {
        "bg": "#74c7ec",
        "fg": "#1e1e2e"
      },
      "model": {
        "bg": "#cba6f7",
        "fg": "#1e1e2e"
      },
      "context": {
        "bg": "#89b4fa",
        "fg": "#1e1e2e"
      }
    }
  }
}
