#!/usr/bin/env python3
"""Server monitoring report — sends daily stats to Telegram."""

import subprocess
import time
import urllib.request
import urllib.parse
import socket
from datetime import datetime

BOT_TOKEN = '{{ server_telegram_bot_token }}'
CHAT_ID = '{{ server_telegram_chat_id }}'


def run(cmd: str) -> str:
    return subprocess.check_output(cmd, shell=True, text=True).strip()


def get_cpu_usage() -> float:
    def read_stat():
        with open('/proc/stat') as f:
            parts = f.readline().split()
        idle = int(parts[4]) + int(parts[5])
        total = sum(int(x) for x in parts[1:8])
        return idle, total

    idle1, total1 = read_stat()
    time.sleep(1)
    idle2, total2 = read_stat()

    delta_idle = idle2 - idle1
    delta_total = total2 - total1

    return round((1 - delta_idle / delta_total) * 100, 1) if delta_total else 0.0


def get_network_stats() -> list[str]:
    lines = []

    with open('/proc/net/dev') as f:
        for line in f:
            parts = line.split()

            if len(parts) < 10:
                continue

            iface = parts[0].rstrip(':')

            if iface in ('Inter-|', 'face', 'lo'):
                continue

            rx_mib = round(int(parts[1]) / 1048576, 1)
            tx_mib = round(int(parts[9]) / 1048576, 1)
            lines.append(f'{iface}: RX {rx_mib} MiB / TX {tx_mib} MiB')

    return lines


hostname = socket.gethostname()
now = datetime.now().strftime('%Y-%m-%d %H:%M')
uptime = run('uptime -p')

with open('/proc/loadavg') as f:
    la = f.read().split()

load = f'{la[0]} / {la[1]} / {la[2]}'
cpu = get_cpu_usage()

mem_raw = run("free -m | awk '/^Mem:/{print $2,$3,$7}'").split()
mem_total, mem_used, mem_avail = int(mem_raw[0]), int(mem_raw[1]), int(mem_raw[2])
mem_pct = round(mem_used / mem_total * 100, 1)

disk = run("df -h / | awk 'NR==2{print $3\"/\"$2,\"(\"$5\")\"}' ")

net = get_network_stats()

top_cpu = run("ps aux --sort=-%cpu | awk 'NR>1 && NR<=6{printf \"%5s%%  %s\\n\", $3, $11}'")
top_mem = run("ps aux --sort=-%mem | awk 'NR>1 && NR<=6{printf \"%5s%%  %s\\n\", $4, $11}'")

msg = (
    f'<b>{hostname} — Daily Report</b>\n'
    f'{now}\n'
    f'\n'
    f'<b>Uptime:</b> {uptime}\n'
    f'<b>Load avg (1m/5m/15m):</b> {load}\n'
    f'<b>CPU usage:</b> {cpu}%\n'
    f'\n'
    f'<b>Memory:</b> {mem_used}/{mem_total} MiB ({mem_pct}%)\n'
    f'<b>Available:</b> {mem_avail} MiB\n'
    f'\n'
    f'<b>Disk (/):</b> {disk}\n'
    f'\n'
    f'<b>Network (since boot):</b>\n'
    + '\n'.join(net) +
    f'\n'
    f'\n'
    f'<b>Top CPU:</b>\n'
    f'<pre>{top_cpu}</pre>\n'
    f'\n'
    f'<b>Top MEM:</b>\n'
    f'<pre>{top_mem}</pre>'
)

data = urllib.parse.urlencode({
    'chat_id': CHAT_ID,
    'text': msg,
    'parse_mode': 'HTML',
}).encode()

urllib.request.urlopen(
    f'https://api.telegram.org/bot{BOT_TOKEN}/sendMessage',
    data=data,
    timeout=30,
)
