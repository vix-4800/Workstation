{
  "$schema": "https://opencode.ai/config.json",
  "model": "github-copilot/claude-sonnet-4.6",
  "autoupdate": "notify",
  "formatter": {
    "php-cs-fixer": {
      "command": [
        "php-cs-fixer",
        "fix",
        "--config",
        "$HOME/.config/php-cs-fixer/php-cs-fixer.php",
        "--quiet",
        "$FILE"
      ],
      "extensions": [".php"]
    },
    "shfmt": {
      "command": ["shfmt", "-w", "-i", "4", "$FILE"],
      "extensions": [".sh", ".bash"]
    }
  }
}
