# ~/.aliases
# Common aliases for all shells

# ======= Editor aliases =======
alias vim='nvim'
alias vi='nvim'
alias neovim='nvim'

# ======= File operations =======
# Check if eza is available, otherwise fallback to ls
if command -v eza >/dev/null 2>&1; then
    alias ls='eza --color=auto --group-directories-first'
    alias ll='eza -la --color=auto --group-directories-first'
    alias tree='eza --tree'
else
    alias ls='ls --color=auto'
    alias ll='ls -alF'
    alias la='ls -A'
    alias l='ls -CF'
fi

# ======= Modern CLI tools =======
# Use bat instead of cat if available
if command -v bat >/dev/null 2>&1; then
    alias cat='bat --style=plain'
fi

# Use ripgrep instead of grep if available
if command -v rg >/dev/null 2>&1; then
    alias grep='rg'
else
    alias grep='grep --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'
fi

# Use fd instead of find if available
if command -v fd >/dev/null 2>&1; then
    alias find='fd'
fi

# ======= Package manager aliases =======
# Arch Linux / pacman
if command -v pacman >/dev/null 2>&1; then
    alias system-cleanup='sudo pacman -Rns $(pacman -Qtdq)'
    alias system-update='sudo pacman -Syu'
    alias system-search='pacman -Ss'
    alias system-install='sudo pacman -S'
fi

# ======= Wayland-specific aliases =======
# Only for wayland sessions
if [ "$XDG_SESSION_TYPE" = "wayland" ]; then
    if command -v code >/dev/null 2>&1; then
        alias code='code --ozone-platform=wayland'
    fi
    if command -v spotify >/dev/null 2>&1; then
        alias spotify='spotify --ozone-platform=wayland'
    fi
fi

# ======= Utility aliases =======
# Alert for long running commands (bash)
if [ -n "$BASH_VERSION" ]; then
    alias alert='notify-send --urgency=low -i "$([ $? = 0 ] && echo terminal || echo error)" "$(history|tail -n1|sed -e '\''s/^\s*[0-9]\+\s*//;s/[;&|]\s*alert$//'\'')"'
fi
