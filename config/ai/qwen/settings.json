{
  "security": {
    "auth": {
      "selectedType": "qwen-oauth"
    },
    "folderTrust": {
      "enabled:": true
    }
  },
  "$version": 3,
  "ide": {
    "enabled": true,
    "hasSeenNudge": true
  },
  "mcpServers": {},
  "general": {
    "preferredEditor": "vim",
    "gitCoAuthor": true
  },
  "ui": {
    "theme": "GitHub",
    "hideTips": false
  },
  "privacy": {
    "usageStatisticsEnabled": false
  },
  "telemetry": {
    "enabled": false
  },
  "context": {
    "fileName": ["QWEN.md", "AGENTS.md"],
    "fileFiltering": {
      "respectGitIgnore": true
    }
  }
}
