#!/usr/bin/env bash

wifi_icon_online() {
    local sig=$1
    if   [[ $sig -ge 75 ]]; then echo "󰤨"
    elif [[ $sig -ge 50 ]]; then echo "󰤥"
    elif [[ $sig -ge 25 ]]; then echo "󰤢"
    else                         echo "󰤟"
    fi
}

wifi_icon_nointernet() {
    local sig=$1
    if   [[ $sig -ge 75 ]]; then echo "󰤩"
    elif [[ $sig -ge 50 ]]; then echo "󰤦"
    elif [[ $sig -ge 25 ]]; then echo "󰤣"
    else                         echo "󰤠"
    fi
}

WIFI_DEVICE=$(nmcli -t -f DEVICE,TYPE,STATE device 2>/dev/null | awk -F: '$2=="wifi" && $3=="connected" {print $1; exit}')
ETH_DEVICE=$(nmcli -t -f DEVICE,TYPE,STATE device 2>/dev/null | awk -F: '$2=="ethernet" && $3=="connected" {print $1; exit}')

if [[ -z "$WIFI_DEVICE" && -z "$ETH_DEVICE" ]]; then
    WIFI_AVAIL=$(nmcli -t -f TYPE,STATE device 2>/dev/null | awk -F: '$1=="wifi" && $2!="unavailable" && $2!="unmanaged" {print 1; exit}')
    if [[ -n "$WIFI_AVAIL" ]]; then
        printf '{"text": "󰤮", "class": "disconnected", "tooltip": "Wi-Fi not connected"}\n'
    else
        printf '{"text": "󰤮", "class": "disconnected", "tooltip": "No network connection"}\n'
    fi
    exit 0
fi

if [[ -n "$WIFI_DEVICE" ]]; then
    CONNECTION_TYPE="wifi"
    SSID=$(nmcli -t -f ACTIVE,SSID device wifi 2>/dev/null | awk -F: '$1=="yes" {print $2; exit}')
    SIGNAL=$(nmcli -t -f ACTIVE,SIGNAL device wifi 2>/dev/null | awk -F: '$1=="yes" {print $2; exit}')
    SIGNAL=${SIGNAL:-0}
    CONN_INFO="${SSID} (${SIGNAL}%)"
else
    CONNECTION_TYPE="ethernet"
    CONN_INFO="Ethernet: ${ETH_DEVICE}"
fi

if ping -c 1 -W 1 1.1.1.1 &>/dev/null; then
    if [[ "$CONNECTION_TYPE" == "wifi" ]]; then
        ICON=$(wifi_icon_online "$SIGNAL")
    else
        ICON="󰈀"
    fi
    printf '{"text": "%s", "class": "online %s", "tooltip": "%s"}\n' "$ICON" "$CONNECTION_TYPE" "$CONN_INFO"
else
    if [[ "$CONNECTION_TYPE" == "wifi" ]]; then
        ICON=$(wifi_icon_nointernet "$SIGNAL")
    else
        ICON="󰤮"
    fi
    printf '{"text": "%s", "class": "no-internet %s", "tooltip": "%s — No internet"}\n' "$ICON" "$CONNECTION_TYPE" "$CONN_INFO"
fi
