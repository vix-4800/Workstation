#!/usr/bin/env bash
set -euo pipefail

# Cache configuration
CACHE_FILE="/tmp/waybar-docker-status.cache"
CACHE_TTL=5  # seconds

# Check cache freshness
if [ -f "$CACHE_FILE" ]; then
    cache_age=$(($(date +%s) - $(stat -c %Y "$CACHE_FILE")))
    if [ "$cache_age" -lt "$CACHE_TTL" ]; then
        cat "$CACHE_FILE"
        exit 0
    fi
fi

# Function to save result to cache
save_to_cache() {
    echo "$1" | tee "$CACHE_FILE"
}

# Check if Docker daemon is running (with timeout)
if ! timeout 1s systemctl is-active --quiet docker 2>/dev/null; then
    # Docker daemon is not running - hide the module
    save_to_cache '{"text": "", "tooltip": "Docker daemon is not running", "class": "hidden"}'
    exit 0
fi

# Get the number of running containers (with timeout)
running_containers=$(timeout 2s docker ps --format "table {{.Names}}" 2>/dev/null | wc -l) || {
    save_to_cache '{"text": "⚠", "tooltip": "Docker timeout", "class": "error"}'
    exit 0
}

# Subtract the table header
if [ "$running_containers" -gt 0 ]; then
    running_containers=$((running_containers - 1))
fi

# If there are no containers, show 0
if [ "$running_containers" -eq 0 ]; then
    save_to_cache '{"text": "0", "tooltip": "No running Docker containers", "class": "stopped"}'
    exit 0
fi

# Get the list of running containers for tooltip
container_list=$(timeout 2s docker ps --format "{{.Names}} ({{.Image}})" 2>/dev/null | head -10) || {
    save_to_cache '{"text": "⚠", "tooltip": "Docker timeout", "class": "error"}'
    exit 0
}

# If there are more than 10 containers, add a note
total_containers=$(echo "$container_list" | wc -l)
if [ "$total_containers" -eq 10 ]; then
    # Check if there are actually more
    actual_total=$(timeout 2s docker ps --format "{{.Names}}" 2>/dev/null | wc -l) || total_containers
    if [ "$actual_total" -gt 10 ]; then
        container_list="$container_list\n... and $((actual_total - 10)) more"
    fi
fi

# Format the output and save to cache
# shellcheck disable=SC2086
# shellcheck disable=SC2028
result='{"text": "'$running_containers'", "tooltip": "Running containers:\n'$container_list'", "class": "running"}'
save_to_cache "$result"
