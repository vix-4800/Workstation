#!/usr/bin/env bash

# System resources module - CPU, RAM, Disk usage

# Get CPU usage
cpu_usage=$(top -bn1 | grep "Cpu(s)" | sed "s/.*, *\([0-9.]*\)%* id.*/\1/" | awk '{print 100 - $1}')
cpu_temp=$(sensors 2>/dev/null | grep -i "Package id 0:\|Tdie:" | awk '{print $4}' | sed 's/+//;s/°C//' | head -1)

# Get RAM usage
mem_total=$(free -m | awk 'NR==2{print $2}')
mem_used=$(free -m | awk 'NR==2{print $3}')
mem_percent=$(free | awk 'NR==2{printf "%.0f", $3*100/$2}')

# Get disk usage for root
disk_usage=$(df -h / | awk 'NR==2{print $5}' | sed 's/%//')
disk_used=$(df -h / | awk 'NR==2{print $3}')
disk_total=$(df -h / | awk 'NR==2{print $2}')

# Determine CPU icon based on usage
cpu_usage_int=${cpu_usage%.*}
if (( cpu_usage_int >= 80 )); then
    cpu_icon="󰻠"  # High
    cpu_class="critical"
elif (( cpu_usage_int >= 50 )); then
    cpu_icon=""  # Medium
    cpu_class="warning"
else
    cpu_icon=""  # Low
    cpu_class="normal"
fi

# Determine RAM icon based on usage
if (( mem_percent >= 80 )); then
    mem_icon="󰍛"
    mem_class="critical"
elif (( mem_percent >= 50 )); then
    mem_icon="󰍛"
    mem_class="warning"
else
    mem_icon="󰍛"
    mem_class="normal"
fi

# Build tooltip
tooltip="<span font_size='large' color='#cba6f7'><b>System Resources</b></span>\n\n"

tooltip+="<span font_size='medium'>"
tooltip+="<b>CPU:</b> $(printf "%.1f" "$cpu_usage")%"
if [ -n "$cpu_temp" ]; then
    tooltip+=" @ ${cpu_temp}°C"
fi
tooltip+="\n"

tooltip+="<b>RAM:</b> ${mem_used}M / ${mem_total}M (${mem_percent}%)\n"
tooltip+="<b>Disk:</b> ${disk_used} / ${disk_total} (${disk_usage}%)"
tooltip+="</span>"

# Simple text output
text="$cpu_icon $(printf "%.0f" "$cpu_usage")% $mem_icon ${mem_percent}%"

echo "{\"text\":\"$text\", \"tooltip\":\"$tooltip\", \"class\":\"$cpu_class\"}"
