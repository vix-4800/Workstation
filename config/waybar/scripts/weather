#!/usr/bin/env bash

# Weather module using wttr.in with auto-location via Geoclue

CACHE_FILE="/tmp/waybar-weather-cache"
CACHE_TIME=1800

get_location() {
    if command -v curl &>/dev/null && command -v jq &>/dev/null; then
        local lat lon
        lat=$(curl -s --max-time 5 "http://127.0.0.1:1777/json" 2>/dev/null | jq -r '.[0].coordinates.latitude // empty')
        lon=$(curl -s --max-time 5 "http://127.0.0.1:1777/json" 2>/dev/null | jq -r '.[0].coordinates.longitude // empty')

        if [[ -n "${lat}" && -n "${lon}" ]]; then
            echo "${lat},${lon}"
            return 0
        fi
    fi
    return 1
}

LOCATION=$(get_location)
if [[ -z "${LOCATION}" ]]; then
    LOCATION=""
fi

# Check cache
if [[ -f "${CACHE_FILE}" ]]; then
    cache_age=$(($(date +%s) - $(stat -c %Y "${CACHE_FILE}")))
    if [[ "${cache_age}" -lt "${CACHE_TIME}" ]]; then
        cat "${CACHE_FILE}"
        exit 0
    fi
fi

# Fetch weather data
weather_url="https://wttr.in/${LOCATION}?format=j1"
weather_data=$(curl -s "${weather_url}" 2>/dev/null)

if [[ -z "${weather_data}" ]]; then
    echo '{"text":"", "tooltip":"Weather data unavailable"}'
    exit 0
fi

# Parse JSON
temp=$(echo "${weather_data}" | jq -r '.current_condition[0].temp_C')
feels_like=$(echo "${weather_data}" | jq -r '.current_condition[0].FeelsLikeC')
humidity=$(echo "${weather_data}" | jq -r '.current_condition[0].humidity')
wind_speed=$(echo "${weather_data}" | jq -r '.current_condition[0].windspeedKmph')
wind_dir=$(echo "${weather_data}" | jq -r '.current_condition[0].winddir16Point')
description=$(echo "${weather_data}" | jq -r '.current_condition[0].weatherDesc[0].value')
weather_code=$(echo "${weather_data}" | jq -r '.current_condition[0].weatherCode')
location_name=$(echo "${weather_data}" | jq -r '.nearest_area[0].areaName[0].value // .nearest_area[0].region[0].value // "Unknown"')

# Determine icon based on weather code
case ${weather_code} in
    113) icon="󰖙" ;;  # Sunny/Clear
    116) icon="󰖕" ;;  # Partly cloudy
    119|122) icon="󰖐" ;;  # Cloudy
    143|248|260) icon="󰖑" ;;  # Fog
    176|263|266|281|284|293|296|299|302|305|308|311|314) icon="󰖗" ;;  # Rain (light)
    179|182|185|227|230) icon="󰖘" ;;  # Snow (light)
    317|320|323|326|329|332|335|338) icon="󰖗" ;;  # Rain (moderate)
    350|353|356|359|362|365|368|371|374|377) icon="󰖘" ;;  # Snow (heavy)
    200|386|389|392|395) icon="󰙾" ;;  # Thunder
    *) icon="󰖐" ;;
esac

# Build tooltip
tooltip="<span font_size='x-large' color='#cba6f7'><b>${description}</b></span>\n\n"
tooltip+="<span font_size='large'>"
tooltip+="<b>Location:</b> ${location_name}\n"
tooltip+="<b>Temperature:</b> ${temp}°C (feels like ${feels_like}°C)\n"
tooltip+="<b>Humidity:</b> ${humidity}%\n"
tooltip+="<b>Wind:</b> ${wind_speed} km/h ${wind_dir}"
tooltip+="</span>\n\n"

# Add forecast
tooltip+="<span font_size='medium' color='#89b4fa'><b>Forecast:</b></span>\n"
tooltip+="<tt><span font_size='small'>"

for i in 0 1 2; do
    date=$(echo "${weather_data}" | jq -r ".weather[${i}].date")
    max_temp=$(echo "${weather_data}" | jq -r ".weather[${i}].maxtempC")
    min_temp=$(echo "${weather_data}" | jq -r ".weather[${i}].mintempC")
    desc=$(echo "${weather_data}" | jq -r ".weather[${i}].hourly[4].weatherDesc[0].value")

    day_name=$(date -d "${date}" +"%a")
    tooltip+="${day_name}: ${min_temp}°-${max_temp}°C, ${desc}\n"
done

tooltip+="</span></tt>"

# Output
text="${icon} ${temp}°C"
output="{\"text\":\"${text}\", \"tooltip\":\"${tooltip}\"}"

# Cache the result
echo "${output}" > "${CACHE_FILE}"
echo "${output}"
