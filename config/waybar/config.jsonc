{
  "layer": "top",
  "position": "top",
  "passthrough": false,
  "reload_style_on_change": true,

  "modules-left": ["custom/weather", "sway/workspaces"],
  "modules-center": ["custom/calendar"],
  "modules-right": [
    "custom/docker",
    "custom/vpn",
    "network",
    "bluetooth",
    "pulseaudio",
    "custom/microphone",
    "custom/resources",
    "battery",
    "sway/language",
    "custom/updates",
    "custom/notification"
  ],

  "sway/workspaces": {
    "disable-scroll": true,
    "sort-by-name": true,
    "format": " {icon} ",
    "format-icons": {
      "default": ""
    }
  },

  "network": {
    "format-wifi": "",
    "format-ethernet": "",
    "format-disconnected": "⚠",
    "tooltip-format": "{ifname} via {gwaddr}",
    "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
    "tooltip-format-ethernet": "{ifname} ",
    "tooltip-format-disconnected": "Disconnected",
    "max-length": 50,
    "on-click": "~/.config/waybar/scripts/network-menu"
  },

  "bluetooth": {
    "format": "󰂲",
    "format-on": "{icon}",
    "format-off": "{icon}",
    "format-connected": "{icon} {device_alias}",
    "format-connected-battery": "{icon} {device_alias} ({device_battery_percentage}%)",
    "format-icons": {
      "on": "󰂯",
      "off": "󰂲",
      "connected": "󰂱"
    },
    "on-click": "blueman-manager",
    "tooltip-format": "{status}",
    "tooltip-format-connected": "Connected: {device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t({device_battery_percentage}%)"
  },

  "tray": {
    "icon-size": 21,
    "spacing": 10
  },

  "clock": {
    "timezone": "Europe/Saratov",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format": "  {:%H:%M | %e %B}",
    "format-alt": "  {:%d/%m/%Y}",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "left",
      "on-scroll": 1,
      "on-click-right": "mode",
      "format": {
        "months": "<span color='#cba6f7'><b>{}</b></span>",
        "days": "<span color='#cdd6f4'>{}</span>",
        "weeks": "<span color='#a6e3a1'><b>W{}</b></span>",
        "weekdays": "<span color='#89b4fa'><b>{}</b></span>",
        "today": "<span color='#f38ba8'><b><u>{}</u></b></span>"
      }
    }
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": "{capacity}% ",
    "format-icons": ["", "", "", "", ""]
  },

  "pulseaudio": {
    "scroll-step": 2,
    "format": "{icon} {volume}%",
    "format-muted": "",
    "format-icons": {
      "default": ["", "", " "]
    },
    "on-click": "~/.config/waybar/scripts/audio-output-menu",
    "on-click-middle": "flatpak run com.github.wwmm.easyeffects",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },

  "custom/microphone": {
    "format": "{}",
    "tooltip-format": "Microphone (click to mute/unmute)",
    "interval": 1,
    "on-click": "~/.config/waybar/scripts/audio-input-menu",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "exec": "~/.config/waybar/scripts/mic-status",
    "return-type": "json"
  },

  "sway/language": {
    "format": "{short} {variant}",
    "on-click": "swaymsg input type:keyboard xkb_switch_layout next",
    "tooltip": false
  },

  "custom/vpn": {
    "format": "{}",
    "tooltip": true,
    "exec": "~/.config/waybar/scripts/vpn-status",
    "return-type": "json",
    "interval": 5,
    "on-click": "~/.config/waybar/scripts/vpn-toggle"
  },

  "custom/docker": {
    "format": " {}",
    "tooltip": true,
    "exec": "~/.config/waybar/scripts/docker-status",
    "return-type": "json",
    "interval": 10,
    "on-click": "~/.config/waybar/scripts/docker-menu"
  },

  "custom/notification": {
    "tooltip": false,
    "format": "{} {icon}",
    "format-icons": {
      "notification": "",
      "none": "",
      "dnd-notification": "",
      "dnd-none": "",
      "inhibited-notification": "",
      "inhibited-none": "",
      "dnd-inhibited-notification": "",
      "dnd-inhibited-none": ""
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },

  "custom/calendar": {
    "format": "{}",
    "return-type": "json",
    "interval": 60,
    "exec": "~/.config/waybar/scripts/calendar",
    "tooltip": true
  },

  "custom/resources": {
    "format": "",
    "return-type": "json",
    "interval": 15,
    "exec": "~/.config/waybar/scripts/system-resources",
    "tooltip": true
  },

  "custom/weather": {
    "format": "{}",
    "return-type": "json",
    "interval": 1800,
    "exec": "~/.config/waybar/scripts/weather",
    "on-click": "xdg-open https://wttr.in/Saratov",
    "tooltip": true
  },

  "custom/updates": {
    "format": "{} {icon}",
    "return-type": "json",
    "format-icons": {
      "has-updates": "󱍷",
      "updated": ""
    },
    "exec-if": "which waybar-module-pacman-updates",
    "exec": "waybar-module-pacman-updates --no-zero-output"
  }
}
