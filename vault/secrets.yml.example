---
# Copy this file to vault/secrets.yml and fill in real values.
# vault/secrets.yml is gitignored and must never be committed.

# WireGuard
vault_wg_profiles:
	- name: wg0
		private_key: "CHANGEME"
		address:
			- "10.0.0.2/32"
			- "fd00::2/128"
		dns:
			- "1.1.1.1"
			- "2606:4700:4700::1111"
		peer_public_key: "CHANGEME"
		preshared_key: "CHANGEME"
		persistent_keepalive: 25
		endpoint: "vpn-1.example.com:51820"
		allowed_ips:
			- "0.0.0.0/0"
			- "::/0"
	- name: wg1
		private_key: "CHANGEME"
		address: "10.10.0.2/32"
		dns: "9.9.9.9"
		peer_public_key: "CHANGEME"
		preshared_key: ""
		persistent_keepalive: 0
		endpoint: "vpn-2.example.com:51820"
