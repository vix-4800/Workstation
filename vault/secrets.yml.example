---
# Copy this file to vault/secrets.yml and fill in real values.
# vault/secrets.yml is gitignored and must never be committed.

# WireGuard
vault_wg_private_key: "CHANGEME"
vault_wg_address: "CHANGEME"
vault_wg_dns: "CHANGEME"
vault_wg_peer_public_key: "CHANGEME"
vault_wg_preshared_key: "CHANGEME"
vault_wg_persistent_keepalive: 0
vault_wg_endpoint: "CHANGEME"

# Server monitoring (Telegram bot)
server_telegram_bot_token: 'YOUR_BOT_TOKEN'
server_telegram_chat_id: 'YOUR_CHAT_ID'
