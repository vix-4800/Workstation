# General for all shells
.aliases	$HOME/.aliases
.prettierrc	$HOME/.prettierrc
.profile	$HOME/.profile

# Bash
bash/.bash_aliases	$HOME/.bash_aliases
bash/.bash_profile	$HOME/.bash_profile
bash/bashrc	$HOME/.bashrc

# Fish
fish	$HOME/.config/fish

# Zsh
zsh/.zsh_aliases	$HOME/.zsh_aliases
zsh/zshrc	$HOME/.zshrc

# Terminals
alacritty	$HOME/.config/alacritty
tmux/.tmux.conf	$HOME/.config/tmux/tmux.conf

# Development - Python
development/python/flake8	$HOME/.config/flake8
development/python/mypy	$HOME/.config/mypy

# Development - PHP
development/php/php-cs-fixer	$HOME/.config/php-cs-fixer
development/php/phpcs	$HOME/.config/phpcs
development/php/phpstan	$HOME/.config/phpstan
development/php/rector	$HOME/.config/rector

# Desktop Environment - Sway
sway	$HOME/.config/sway
swaync	$HOME/.config/swaync
swaylock	$HOME/.config/swaylock
waybar	$HOME/.config/waybar
wlogout	$HOME/.config/wlogout
wofi	$HOME/.config/wofi
swayosd	$HOME/.config/swayosd

# Applications
git/gitconfig	$HOME/.gitconfig
nvim	$HOME/.config/nvim
bat	$HOME/.config/bat
zathura	$HOME/.config/zathura

wallpapers	$HOME/Pictures/Wallpapers
