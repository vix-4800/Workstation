# General for all shells
config/.aliases	$HOME/.aliases
config/.prettierrc	$HOME/.prettierrc
config/.profile	$HOME/.profile

# Bash
config/bash/.bash_aliases	$HOME/.bash_aliases
config/bash/.bash_profile	$HOME/.bash_profile
config/bash/bashrc	$HOME/.bashrc

# Fish
config/fish	$HOME/.config/fish

# Zsh
config/zsh/.zsh_aliases	$HOME/.zsh_aliases
config/zsh/zshrc	$HOME/.zshrc

# Terminals
config/alacritty	$HOME/.config/alacritty
config/tmux/.tmux.conf	$HOME/.config/tmux/tmux.conf

# Development - Python
config/development/python/flake8	$HOME/.config/flake8
config/development/python/mypy	$HOME/.config/mypy

# Development - PHP
config/development/php/php-cs-fixer	$HOME/.config/php-cs-fixer
config/development/php/phpcs	$HOME/.config/phpcs
config/development/php/phpstan	$HOME/.config/phpstan
config/development/php/rector	$HOME/.config/rector

# Desktop Environment - Sway
config/sway	$HOME/.config/sway
config/swaync	$HOME/.config/swaync
config/swaylock	$HOME/.config/swaylock
config/waybar	$HOME/.config/waybar
config/wlogout	$HOME/.config/wlogout
config/wofi	$HOME/.config/wofi
config/swayosd	$HOME/.config/swayosd
config/swappy	$HOME/.config/swappy
config/waypaper	$HOME/.config/waypaper

# Systemd user services
systemd/user	$HOME/.config/systemd/user

# Applications
config/git/gitconfig	$HOME/.gitconfig
config/nvim	$HOME/.config/nvim
config/bat	$HOME/.config/bat
config/zathura	$HOME/.config/zathura

wallpapers	$HOME/Pictures/Wallpapers
themes	$HOME/.config/themes
