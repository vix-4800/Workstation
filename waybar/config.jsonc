{
  /* === Appearance === */
  "layer": "top",
  "position": "top",
  "passthrough": false,
  "reload_style_on_change": true,
  "margin": "5 10 0 10",

  /* === Modules Position === */
  "modules-left": ["custom/archicon", "clock", "custom/weather"],
  "modules-center": ["sway/mode", "sway/workspaces"],
  "modules-right": [
    "tray",
    "idle_inhibitor",
    "bluetooth",
    "network",
    "custom/vpn",
    "custom/docker",
    "pulseaudio",
    "custom/microphone",
    "group/system",
    "battery",
    "sway/language",
    "custom/notification"
  ],

  /* === Modules === */
  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{icon}",
    "format-icons": {
      "1": "",
      "2": "",
      "3": "",
      "4": "",
      "5": "",
      "default": "",
      "urgent": "",
      "focused": ""
    }
  },

  "sway/mode": {
    "format": "<span style=\"italic\">{}</span>"
  },

  "sway/language": {
    "format": "{short} {variant}",
    "on-click": "swaymsg input type:keyboard xkb_switch_layout next"
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    },
    "tooltip-format-activated": "Idle inhibitor active",
    "tooltip-format-deactivated": "Idle inhibitor inactive"
  },

  "tray": {
    "icon-size": 21,
    "spacing": 10,
    "show-passive-items": true
  },

  "clock": {
    "format": "{:%H:%M  %d.%m.%Y} 📅",
    "format-alt": "{:%A, %B %d, %Y (%R)}",
    "tooltip": true,
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "on-click-right": "mode",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "on-click-right": "mode",
      "format": {
        "months": "<span color='#d3c6aa'><b>{}</b></span>",
        "days": "<span color='#e67e80'>{}</span>",
        "weeks": "<span color='#a7c080'><b>W{}</b></span>",
        "weekdays": "<span color='#7fbbb3'><b>{}</b></span>",
        "today": "<span color='#dbbc7f'><b><u>{}</u></b></span>"
      }
    }
  },

  "cpu": {
    "format": "{usage}% ",
    "tooltip": true,
    "interval": 5
  },

  "memory": {
    "format": "{}% ",
    "tooltip": true,
    "tooltip-format": "Memory: {used:0.1f}G/{total:0.1f}G ({percentage}%)\nSwap: {swapUsed}G/{swapTotal}G"
  },

  "temperature": {
    "critical-threshold": 80,
    "format": "{temperatureC}°C {icon}",
    "format-icons": ["", "", ""],
    "tooltip": true,
    "tooltip-format": "CPU Temperature: {temperatureC}°C",
    "interval": 5
  },

  "battery": {
    "format": "{capacity}% {icon}",
    "format-charging": "{capacity}% ",
    "format-plugged": "{capacity}% ",
    "format-alt": "{time} {icon}",
    "format-icons": ["", "", "", "", ""],
    "states": {
      "warning": 30,
      "critical": 15
    },
    "tooltip": true,
    "tooltip-format": "{timeTo}"
  },

  "network": {
    "format-wifi": "{essid} ({signalStrength}%) ",
    "format-ethernet": "",
    "format-disconnected": "⚠",
    "tooltip-format": "{ifname} via {gwaddr}",
    "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
    "tooltip-format-ethernet": "{ifname} ",
    "tooltip-format-disconnected": "Disconnected",
    "max-length": 50,
    "on-click": "nm-connection-editor"
  },

  "pulseaudio": {
    "format": "{volume}% {icon}",
    "format-muted": "",
    "format-icons": ["", "", ""],
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ --limit 1.0",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
    "tooltip": true,
    "tooltip-format": "{desc}"
  },

  "bluetooth": {
    "format": "󰂲",
    "format-on": "{icon}",
    "format-off": "{icon}",
    "format-connected": "{icon} {device_alias}",
    "format-connected-battery": "{icon} {device_alias} ({device_battery_percentage}%)",
    "format-icons": {
      "on": "󰂯",
      "off": "󰂲",
      "connected": "󰂱"
    },
    "on-click": "blueman-manager",
    "tooltip-format": "{status}",
    "tooltip-format-connected": "Connected: {device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t({device_battery_percentage}%)"
  },

  "custom/archicon": {
    "format": "",
    "on-click": "wofi --show drun",
    "tooltip": false
  },

  "custom/weather": {
    "exec": "curl -s 'wttr.in/Saratov?format=%t+%c' | sed 's/+/ /'",
    "interval": 1800,
    "return-type": "string",
    "format": "{}",
    "tooltip": true,
    "tooltip-format": "Weather in Saratov"
  },

  "custom/notification": {
    "tooltip": false,
    "format": "{} {icon}",
    "format-icons": {
      "notification": "",
      "none": "",
      "dnd-notification": "",
      "dnd-none": "",
      "inhibited-notification": "",
      "inhibited-none": "",
      "dnd-inhibited-notification": "",
      "dnd-inhibited-none": ""
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },

  "custom/gpu-temp": {
    "format": "{}°C 󰍛",
    "exec": "nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits 2>/dev/null || sensors | grep -i gpu | awk '{print $2}' | tr -d '+°C' | head -n1 || echo 'N/A'",
    "interval": 5,
    "tooltip": true,
    "tooltip-format": "GPU Temperature: {}°C"
  },

  "group/system": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 500,
      "children-class": "system-hidden",
      "click-to-reveal": true,
      "transition-left-to-right": false
    },
    "modules": ["custom/system-icon", "memory", "cpu", "temperature", "custom/gpu-temp"]
  },

  "custom/system-icon": {
    "format": "",
    "tooltip": true,
    "tooltip-format": "System monitoring (click to expand)"
  },

  "custom/microphone": {
    "format": "{}",
    "tooltip": true,
    "tooltip-format": "Microphone (click to mute/unmute)",
    "interval": 1,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "exec": "~/.config/waybar/mic-status",
    "return-type": "json"
  },

  "custom/vpn": {
    "format": "{}",
    "tooltip": true,
    "exec": "~/.config/waybar/vpn-status",
    "return-type": "json",
    "interval": 5,
    "on-click": "~/.config/waybar/vpn-toggle"
  },

  "custom/docker": {
    "format": " {}",
    "tooltip": true,
    "exec": "~/.config/waybar/docker-status",
    "return-type": "json",
    "interval": 10,
    "on-click": "alacritty -e sh -c 'docker ps -a; echo \"\nPress Enter to close...\"; read'"
  }
}
