{
  "debian": {
    "description": "Debian/Ubuntu packages",
    "packages": [
      "git",
      "curl",
      "fish",
      "neovim",
      "firefox",
      "alacritty",
      "i3",
      "polybar",
      "rofi",
      "feh",
      "jq",
      "ripgrep",
      "fd-find",
      "tmux",
      "python3-pip",
      "python3-pipx",
      "php",
      "composer"
    ]
  },
  "arch": {
    "description": "Arch Linux packages",
    "essential": [
      "base-devel",
      "git",
      "curl",
      "jq",
      "make",
      "less",
      "unzip",
      "gcc",
      "openssh",
      "udiskie",
      "ffmpeg",
      "reflector"
    ],
    "shell": ["fish", "zsh"],
    "editors": ["neovim"],
    "terminal": ["alacritty", "tmux"],
    "wayland": [
      "sway",
      "waybar",
      "wofi",
      "mako",
      "swaylock",
      "swayidle",
      "swaybg",
      "wl-clipboard",
      "grim",
      "slurp",
      "brightnessctl"
    ],
    "x11": ["i3", "polybar", "rofi", "feh", "xorg-xauth"],
    "audio": ["pipewire", "pipewire-alsa", "pipewire-pulse", "wireplumber", "pavucontrol"],
    "bluetooth": ["bluez", "bluez-utils"],
    "security": ["ufw"],
    "microcode": ["amd-ucode", "intel-ucode"],
    "fonts": ["ttf-jetbrains-mono-nerd", "otf-font-awesome"],
    "development": [
      "php",
      "php-gd",
      "php-intl",
      "composer",
      "docker",
      "docker-compose",
      "python-pip",
      "python-pipx"
    ],
    "utilities": [
      "ripgrep",
      "fd",
      "bottom",
      "firefox",
      "wireguard-tools",
      "github-cli",
      "mesa",
      "networkmanager-wireguard",
      "flatpak"
    ],
    "display": ["sddm", "greetd", "greetd-regreet"],
    "desktop_environments": ["plasma", "plasma-wayland-session", "kde-applications"]
  },
  "aur": {
    "description": "AUR packages for Arch Linux",
    "essential": ["visual-studio-code-bin"],
    "optional": ["swayfx", "sddm-theme-corners-git", "ttf-cascadia-code", "grub-customizer"]
  },
  "pipx": {
    "description": "Python tools installed via pipx",
    "packages": ["pre-commit", "ansible-lint", "black", "flake8", "mypy"]
  },
  "npm": {
    "description": "Node.js packages installed globally",
    "packages": ["prettier", "@commitlint/cli", "@commitlint/config-conventional"]
  },
  "composer": {
    "description": "PHP packages installed globally",
    "packages": [
      "phpstan/phpstan",
      "friendsofphp/php-cs-fixer",
      "squizlabs/php_codesniffer",
      "rector/rector"
    ]
  },
  "manual_installs": {
    "description": "Software that needs manual installation",
    "items": [
      {
        "name": "Nerd Fonts",
        "url": "https://github.com/ryanoasis/nerd-fonts",
        "description": "Additional programming fonts"
      },
      {
        "name": "Fisher",
        "url": "https://github.com/jorgebucaran/fisher",
        "description": "Fish shell plugin manager",
        "install_cmd": "curl -sL https://raw.githubusercontent.com/jorgebucaran/fisher/main/functions/fisher.fish | source && fisher install jorgebucaran/fisher"
      }
    ]
  }
}
