{
    "label" : "lock",
    "action" : "swaylock -f --clock --image ~/Pictures/Wallpapers/forest-1.jpg --effect-blur 7x5 --fade-in 0.5 --effect-vignette 0.3:1 --indicator-radius 75 --indicator-thickness 5 --ring-color 61afef --separator-color 00000000 --key-hl-color 4163EC --hide-keyboard-layout --inside-clear-color 4163EC --line-clear-color 1741E8",
    "text" : "Lock",
    "keybind" : "l"
}
{
    "label" : "logout",
    "action" : "swaymsg exit",
    "text" : "Logout",
    "keybind" : "e"
}
{
    "label" : "suspend",
    "action" : "systemctl suspend",
    "text" : "Suspend",
    "keybind" : "u"
}
{
    "label" : "hibernate",
    "action" : "systemctl hibernate",
    "text" : "Hibernate",
    "keybind" : "h"
}
{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "text" : "Reboot",
    "keybind" : "r"
}
{
    "label" : "shutdown",
    "action" : "systemctl poweroff",
    "text" : "Shutdown",
    "keybind" : "s"
}
