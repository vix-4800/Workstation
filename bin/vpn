#!/usr/bin/env bash
# vpn — WireGuard + VLESS/sing-box connection manager
set -euo pipefail

PROFILES_DIR="${HOME}/.config/sing-box/profiles"
SING_CONFIG="/etc/sing-box/config.json"
ACTIVE_FILE="${HOME}/.config/sing-box/.active-profile"

if [[ -t 1 ]]; then
    RED="$(printf '\033[31m')"
    GRN="$(printf '\033[32m')"
    YLW="$(printf '\033[33m')"
    BLU="$(printf '\033[34m')"
    BLD="$(printf '\033[1m')"
    RST="$(printf '\033[0m')"
else
    RED="" GRN="" YLW="" BLU="" BLD="" RST=""
fi

ok()   { printf '%s✓%s %s\n' "$GRN" "$RST" "$*"; }
warn() { printf '%s⚠%s %s\n' "$YLW" "$RST" "$*"; }
err()  { printf '%s✗%s %s\n' "$RED" "$RST" "$*" >&2; }
msg()  { printf '%s→%s %s\n' "$BLU" "$RST" "$*"; }

usage() {
    printf '%svpn%s — VPN manager (WireGuard + VLESS/sing-box)\n\n' "$BLD" "$RST"
    printf '%sUsage:%s\n' "$BLD" "$RST"
    printf '  vpn status              Show current VPN status\n'
    printf '  vpn list                List available profiles\n'
    printf '  vpn wg [name]           Connect via WireGuard (NetworkManager)\n'
    printf '  vpn vless <profile>     Connect via VLESS (sing-box)\n'
    printf '  vpn off                 Disconnect all\n'
    printf '  vpn import <url> [name] Import a vless:// connection link\n'
    printf '  vpn help                Show this help\n'
}

get_active_wg() {
    nmcli -t -f NAME,TYPE,STATE connection show --active 2>/dev/null \
        | grep ':wireguard:activated' | cut -d: -f1 || true
}

get_all_wg() {
    nmcli -t -f NAME,TYPE connection show 2>/dev/null \
        | grep ':wireguard$' | cut -d: -f1 || true
}

is_singbox_active() {
    systemctl is-active --quiet sing-box 2>/dev/null
}

get_active_vless() {
    [[ -f "$ACTIVE_FILE" ]] && cat "$ACTIVE_FILE" || echo ""
}

set_active_vless() {
    printf '%s' "$1" > "$ACTIVE_FILE"
}

clear_active_vless() {
    rm -f "$ACTIVE_FILE"
}

cmd_status() {
    printf '%sVPN Status%s\n' "$BLD" "$RST"
    printf '%s\n' "──────────────────────"

    local active_wg
    active_wg=$(get_active_wg)
    if [[ -n "$active_wg" ]]; then
        ok "WireGuard:  ${BLD}${active_wg}${RST}"
    else
        printf '  WireGuard:  %sdisconnected%s\n' "$YLW" "$RST"
    fi

    if is_singbox_active; then
        local pname
        pname=$(get_active_vless)
        ok "sing-box:   ${BLD}${pname:-unknown}${RST}"
    else
        printf '  sing-box:   %sstopped%s\n' "$YLW" "$RST"
    fi
}

cmd_list() {
    printf '%sWireGuard profiles (NetworkManager):%s\n' "$BLD" "$RST"
    local active_wg
    active_wg=$(get_active_wg)
    local wg_list
    wg_list=$(get_all_wg)

    if [[ -n "$wg_list" ]]; then
        while IFS= read -r name; do
            if [[ "$name" == "$active_wg" ]]; then
                printf '  %s● %s%s (active)\n' "$GRN" "$name" "$RST"
            else
                printf '  ○ %s\n' "$name"
            fi
        done <<< "$wg_list"
    else
        printf '  (none)\n'
    fi

    printf '\n%ssing-box profiles:%s\n' "$BLD" "$RST"
    local active_vless
    active_vless=$(get_active_vless)
    local any_vless=0

    if [[ -d "$PROFILES_DIR" ]]; then
        for f in "${PROFILES_DIR}"/*.json; do
            [[ -e "$f" ]] || continue
            any_vless=1
            local name
            name=$(basename "$f" .json)
            if is_singbox_active && [[ "$name" == "$active_vless" ]]; then
                printf '  %s● %s%s (active)\n' "$GRN" "$name" "$RST"
            else
                printf '  ○ %s\n' "$name"
            fi
        done
    fi

    if [[ "$any_vless" -eq 0 ]]; then
        printf '  (none — use: vpn import <vless://...>)\n'
    fi
}

cmd_wg() {
    local conn_name="${1:-}"

    if is_singbox_active; then
        msg "Stopping sing-box..."
        sudo systemctl stop sing-box
        clear_active_vless
    fi

    if [[ -z "$conn_name" ]]; then
        local wg_list
        wg_list=$(get_all_wg)
        if [[ -z "$wg_list" ]]; then
            err "No WireGuard connections in NetworkManager."
            printf 'Add one: sudo nmcli connection import type wireguard file /path/to/wg.conf\n'
            exit 1
        fi
        local count
        count=$(printf '%s\n' "$wg_list" | wc -l)
        if [[ "$count" -eq 1 ]]; then
            conn_name="$wg_list"
        else
            printf '%sAvailable WireGuard connections:%s\n' "$BLD" "$RST"
            printf '%s\n' "$wg_list"
            err "Multiple connections found. Specify one: vpn wg <name>"
            exit 1
        fi
    fi

    msg "Connecting WireGuard: ${conn_name}..."
    nmcli connection up "$conn_name"
    ok "WireGuard connected: ${conn_name}"
}

cmd_vless() {
    local profile="${1:-}"
    if [[ -z "$profile" ]]; then
        err "Profile name required. Use: vpn list"
        exit 1
    fi

    local profile_file="${PROFILES_DIR}/${profile}.json"
    if [[ ! -f "$profile_file" ]]; then
        err "Profile not found: ${profile}"
        printf 'Use: vpn import <vless://...>\n'
        exit 1
    fi

    local active_wg
    active_wg=$(get_active_wg)
    if [[ -n "$active_wg" ]]; then
        msg "Disconnecting WireGuard: ${active_wg}..."
        nmcli connection down "$active_wg"
    fi

    msg "Loading profile: ${profile}..."
    sudo tee "$SING_CONFIG" < "$profile_file" > /dev/null

    if is_singbox_active; then
        sudo systemctl restart sing-box
    else
        sudo systemctl start sing-box
    fi

    set_active_vless "$profile"
    ok "VLESS connected: ${profile}"
}

cmd_off() {
    local any=0

    local active_wg
    active_wg=$(get_active_wg)
    if [[ -n "$active_wg" ]]; then
        msg "Disconnecting WireGuard: ${active_wg}..."
        nmcli connection down "$active_wg"
        any=1
    fi

    if is_singbox_active; then
        msg "Stopping sing-box..."
        sudo systemctl stop sing-box
        clear_active_vless
        any=1
    fi

    if [[ "$any" -eq 1 ]]; then
        ok "All VPN connections stopped"
    else
        warn "No active VPN connections"
    fi
}

cmd_import() {
    local url="${1:-}"
    local name_hint="${2:-}"

    if [[ -z "$url" ]]; then
        err "URL required. Usage: vpn import <vless://...> [name]"
        exit 1
    fi

    if [[ "$url" != vless://* ]]; then
        err "Unsupported URL format. Only vless:// is currently supported."
        exit 1
    fi

    mkdir -p "$PROFILES_DIR"
    msg "Parsing VLESS URL..."

    local config
    config=$(VLESS_URL="$url" python3 <<'PYEOF'
import os, sys, json, urllib.parse

url = os.environ['VLESS_URL']

# Strip schema and extract fragment (tag/name)
rest = url[8:]
tag = 'vless-profile'
if '#' in rest:
    rest, fragment = rest.rsplit('#', 1)
    tag = urllib.parse.unquote(fragment).strip()

# Split UUID from host
if '@' not in rest:
    print("ERROR: invalid VLESS URL — missing @", file=sys.stderr)
    sys.exit(1)

uuid, hostpart = rest.split('@', 1)

# Split host from query string
querystring = ''
if '?' in hostpart:
    hostpart, querystring = hostpart.split('?', 1)

# Parse host:port (handles IPv6)
if hostpart.startswith('['):
    bracket = hostpart.index(']')
    host = hostpart[1:bracket]
    port = int(hostpart[bracket + 2:])
else:
    host, port_str = hostpart.rsplit(':', 1)
    port = int(port_str)

params = dict(urllib.parse.parse_qsl(querystring))

transport_type = params.get('type', 'tcp')
security       = params.get('security', 'none')
flow           = params.get('flow', '')
sni            = params.get('sni', '') or params.get('peer', '')
pbk            = params.get('pbk', '')   # Reality public key
sid            = params.get('sid', '')   # Reality short ID
fp             = params.get('fp', 'chrome')
path           = params.get('path', '/')
host_header    = params.get('host', '') or sni

# Build VLESS outbound
outbound = {
    "type": "vless",
    "tag": "vless-out",
    "server": host,
    "server_port": port,
    "uuid": uuid,
}

if flow:
    outbound["flow"] = flow

# TLS / Reality
if security in ('reality', 'tls'):
    tls = {
        "enabled": True,
        "server_name": sni,
        "utls": {"enabled": True, "fingerprint": fp},
    }
    if security == 'reality' and pbk:
        tls["reality"] = {
            "enabled": True,
            "public_key": pbk,
            "short_id": sid,
        }
    outbound["tls"] = tls

# Transport layer
if transport_type in ('xhttp', 'httpupgrade'):
    outbound["transport"] = {
        "type": transport_type,
        "host": host_header,
        "path": path,
    }
elif transport_type == 'ws':
    outbound["transport"] = {
        "type": "ws",
        "path": path,
        "headers": {"Host": host_header} if host_header else {},
    }
elif transport_type == 'grpc':
    outbound["transport"] = {
        "type": "grpc",
        "service_name": params.get('serviceName', ''),
    }

# Full sing-box config with TUN inbound (routes all traffic)
config = {
    "log": {"level": "warn", "timestamp": True},
    "dns": {
        "servers": [
            {
                "tag": "dns-remote",
                "address": "tls://1.1.1.1",
                "address_resolver": "dns-local",
                "detour": "vless-out",
            },
            {
                "tag": "dns-local",
                "address": "223.5.5.5",
                "detour": "direct",
            },
        ],
        "rules": [
            {"outbound": "any", "server": "dns-local"},
        ],
        "independent_cache": True,
    },
    "inbounds": [
        {
            "type": "tun",
            "tag": "tun-in",
            "address": ["172.19.0.1/30", "fdfe:dcba:9876::1/126"],
            "mtu": 9000,
            "auto_route": True,
            "strict_route": True,
            "sniff": True,
            "sniff_override_destination": True,
            "stack": "system",
        }
    ],
    "outbounds": [
        outbound,
        {"type": "direct", "tag": "direct"},
        {"type": "block",  "tag": "block"},
        {"type": "dns",    "tag": "dns-out"},
    ],
    "route": {
        "rules": [
            {
                "type": "logical",
                "mode": "or",
                "rules": [{"protocol": "dns"}, {"port": 53}],
                "outbound": "dns-out",
            },
            {"ip_is_private": True, "outbound": "direct"},
        ],
        "auto_detect_interface": True,
    },
}

print(json.dumps(config, indent=2, ensure_ascii=False))
PYEOF
    )

    if [[ -z "$config" ]]; then
        err "Failed to parse VLESS URL"
        exit 1
    fi

    # Derive profile name
    local name="$name_hint"
    if [[ -z "$name" ]]; then
        name=$(VLESS_URL="$url" python3 -c "
import os, urllib.parse
url = os.environ['VLESS_URL']
tag = 'vless-profile'
if '#' in url:
    tag = urllib.parse.unquote(url.split('#')[-1]).strip()
safe = ''.join(c if c.isalnum() or c in '-_.' else '-' for c in tag).strip('-')
print(safe[:48] or 'vless-profile')
")
    fi

    # Sanitize name for use as filename
    name="${name// /-}"
    name="$(printf '%s' "$name" | tr -cd 'a-zA-Z0-9._-')"
    name="${name:-vless-profile}"

    local profile_file="${PROFILES_DIR}/${name}.json"
    printf '%s\n' "$config" > "$profile_file"
    chmod 600 "$profile_file"

    ok "Profile saved: ${name}"
    printf '  Path: %s\n\n' "$profile_file"
    printf 'Connect with: %svpn vless %s%s\n' "$BLD" "$name" "$RST"
}

case "${1:-help}" in
    status)         cmd_status ;;
    list)           cmd_list ;;
    wg)             cmd_wg "${2:-}" ;;
    vless)          cmd_vless "${2:-}" ;;
    off)            cmd_off ;;
    import)         cmd_import "${2:-}" "${3:-}" ;;
    help|--help|-h) usage ;;
    *)
        err "Unknown command: ${1}"
        printf '\n'
        usage
        exit 1
        ;;
esac
