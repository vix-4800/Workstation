#!/bin/bash

# Quick Package Installation Script
# Installs essential packages without interactive prompts

set -e

# Get the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
INSTALL_PACKAGES_SCRIPT="$SCRIPT_DIR/install-packages"

# Colors for output
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Check if running on Arch Linux
if ! command -v pacman &> /dev/null; then
    log_error "This script is designed for Arch Linux only!"
    exit 1
fi

# Check if install-packages script exists
if [ ! -f "$INSTALL_PACKAGES_SCRIPT" ]; then
    log_error "Package installer script not found: $INSTALL_PACKAGES_SCRIPT"
    exit 1
fi

log_info "=== Quick Package Installation ==="
log_info "Installing essential packages for Arch Linux desktop environment"

# Update system first
log_info "Updating system packages..."
sudo pacman -Syu --noconfirm

# Install yay first
log_info "Installing yay AUR helper..."
"$INSTALL_PACKAGES_SCRIPT" yay

# Install all basic packages
log_info "Installing all basic packages..."
"$INSTALL_PACKAGES_SCRIPT" all-basic

# Install audio system
log_info "Installing audio system..."
"$INSTALL_PACKAGES_SCRIPT" audio

# Detect CPU and install appropriate microcode
if grep -q "vendor_id.*AuthenticAMD" /proc/cpuinfo; then
    log_info "AMD CPU detected, installing AMD microcode..."
    "$INSTALL_PACKAGES_SCRIPT" cpu-microcode amd
elif grep -q "vendor_id.*GenuineIntel" /proc/cpuinfo; then
    log_info "Intel CPU detected, installing Intel microcode..."
    "$INSTALL_PACKAGES_SCRIPT" cpu-microcode intel
else
    log_warn "Could not detect CPU vendor, skipping microcode installation"
fi

# Install multimedia codecs
log_info "Installing multimedia codecs..."
"$INSTALL_PACKAGES_SCRIPT" multimedia

# Install some essential AUR packages
if command -v yay &> /dev/null; then
    log_info "Installing essential AUR packages..."
    "$INSTALL_PACKAGES_SCRIPT" aur-essentials
fi

log_info "=== Quick Installation Complete! ==="
log_warn "Additional configuration may be needed:"
echo "  - Configure display manager with: sudo systemctl enable sddm"
echo "  - Install GPU drivers as needed"
echo "  - Run full setup with: arch-setup"
echo ""
log_info "Reboot recommended to ensure all changes take effect"
