#!/usr/bin/env bash
# Dotfiles configuration helper

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

usage() {
    cat <<EOF
Dotfiles Configuration Helper

Usage:
    $(basename "$0") edit-config      Edit dotfiles.yaml configuration
    $(basename "$0") generate         Generate linux.confmap from dotfiles.yaml  
    $(basename "$0") validate         Validate dotfiles.yaml syntax
    $(basename "$0") help            Show this help

The configuration is now managed via dotfiles.yaml for better readability.
The old linux.confmap is generated automatically from the YAML file.
EOF
}

edit_config() {
    local config_file="${REPO_ROOT}/dotfiles.yaml"
    "${EDITOR:-nvim}" "$config_file"
}

generate_confmap() {
    echo "Generating linux.confmap from dotfiles.yaml..."
    cd "${REPO_ROOT}/cmd/config-manager"
    go run . generate
    echo "✓ Generated linux.confmap"
}

validate_config() {
    echo "Validating dotfiles.yaml..."
    cd "${REPO_ROOT}/cmd/config-manager"
    if go run . parse >/dev/null 2>&1; then
        echo "✓ Configuration is valid"
        return 0
    else
        echo "✗ Configuration has errors"
        go run . parse
        return 1
    fi
}

case "${1:-help}" in
    edit-config|edit)
        edit_config
        ;;
    generate)
        generate_confmap
        ;;
    validate)
        validate_config
        ;;
    help|--help|-h)
        usage
        ;;
    *)
        echo "Unknown command: $1"
        echo ""
        usage
        exit 1
        ;;
esac