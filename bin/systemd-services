#!/usr/bin/env bash

# Systemd User Services Management Script
# Manages systemd user services defined in dotfiles

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

log_prompt() {
    echo -e "${BLUE}[PROMPT]${NC} $1"
}

# Get the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(dirname "$SCRIPT_DIR")"
SYSTEMD_DIR="$REPO_ROOT/systemd/user"

# Check if systemd directory exists
if [ ! -d "$SYSTEMD_DIR" ]; then
    log_error "Systemd user directory not found: $SYSTEMD_DIR"
    exit 1
fi

# Function to enable and start a service
enable_service() {
    local service="$1"
    log_info "Enabling and starting $service..."
    systemctl --user daemon-reload
    systemctl --user enable "$service"
    systemctl --user start "$service" 2>/dev/null || true
    log_info "✓ $service enabled"
}

# Function to disable a service
disable_service() {
    local service="$1"
    log_info "Disabling $service..."
    systemctl --user stop "$service" 2>/dev/null || true
    systemctl --user disable "$service" 2>/dev/null || true
    log_info "✓ $service disabled"
}

# Function to restart a service
restart_service() {
    local service="$1"
    log_info "Restarting $service..."
    systemctl --user restart "$service"
    log_info "✓ $service restarted"
}

# Function to show status of a service
show_status() {
    local service="$1"
    systemctl --user status "$service"
}

# Function to list all services in dotfiles
list_services() {
    log_info "Services available in dotfiles:"
    echo ""
    find "$SYSTEMD_DIR" -type f \( -name "*.service" -o -name "*.timer" \) | while read -r file; do
        basename "$file"
    done | sort
}

# Function to enable all services
enable_all() {
    log_info "Enabling all systemd services from dotfiles..."
    systemctl --user daemon-reload

    # Enable timers (they auto-enable their services)
    find "$SYSTEMD_DIR" -type f -name "*.timer" | while read -r timer; do
        service_name=$(basename "$timer")
        enable_service "$service_name"
    done

    # Enable standalone services (not triggered by timers)
    find "$SYSTEMD_DIR" -type f -name "*.service" | while read -r service_file; do
        service_name=$(basename "$service_file")
        timer_file="${service_file%.service}.timer"

        # Skip if there's a timer for this service
        if [ ! -f "$timer_file" ]; then
            # Check if it's not a oneshot service
            if ! grep -q "Type=oneshot" "$service_file"; then
                enable_service "$service_name"
            fi
        fi
    done
}

# Function to reload systemd daemon
reload_daemon() {
    log_info "Reloading systemd user daemon..."
    systemctl --user daemon-reload
    log_info "✓ Daemon reloaded"
}

# Function to list enabled timers
list_timers() {
    log_info "Active timers:"
    echo ""
    systemctl --user list-timers
}

# Function to show help
show_help() {
    cat << EOF
Usage: $(basename "$0") [COMMAND] [SERVICE]

Manage systemd user services from dotfiles.

Commands:
    enable <service>    - Enable and start a service/timer
    disable <service>   - Disable and stop a service/timer
    restart <service>   - Restart a service
    status <service>    - Show status of a service
    list                - List all services in dotfiles
    enable-all          - Enable all services from dotfiles
    reload              - Reload systemd user daemon
    timers              - Show active timers
    help                - Show this help message

Examples:
    $(basename "$0") enable arch-update.timer
    $(basename "$0") status arch-update.timer
    $(basename "$0") enable-all
    $(basename "$0") timers

Services in dotfiles:
EOF
    find "$SYSTEMD_DIR" -type f \( -name "*.service" -o -name "*.timer" \) | while read -r file; do
        echo "    - $(basename "$file")"
    done | sort
}

# Main script logic
case "${1:-help}" in
    enable)
        if [ -z "$2" ]; then
            log_error "Please specify a service name"
            exit 1
        fi
        enable_service "$2"
        ;;
    disable)
        if [ -z "$2" ]; then
            log_error "Please specify a service name"
            exit 1
        fi
        disable_service "$2"
        ;;
    restart)
        if [ -z "$2" ]; then
            log_error "Please specify a service name"
            exit 1
        fi
        restart_service "$2"
        ;;
    status)
        if [ -z "$2" ]; then
            log_error "Please specify a service name"
            exit 1
        fi
        show_status "$2"
        ;;
    list)
        list_services
        ;;
    enable-all)
        enable_all
        ;;
    reload)
        reload_daemon
        ;;
    timers)
        list_timers
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        log_error "Unknown command: $1"
        echo ""
        show_help
        exit 1
        ;;
esac
