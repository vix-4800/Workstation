#!/bin/bash

# Package Installation Script for Arch Linux
# Idempotent package installation with optional packages

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

log_prompt() {
    echo -e "${BLUE}[PROMPT]${NC} $1"
}

# Check if package is installed
is_package_installed() {
    local package="$1"
    pacman -Q "$package" &> /dev/null
}

# Check if AUR package is installed
is_aur_package_installed() {
    local package="$1"
    yay -Q "$package" &> /dev/null 2>&1
}

# Install packages with pacman
install_packages() {
    local description="$1"
    shift
    local packages=("$@")
    local packages_to_install=()

    # Filter out already installed packages
    for package in "${packages[@]}"; do
        if ! is_package_installed "$package"; then
            packages_to_install+=("$package")
        else
            log_info "Package $package is already installed, skipping..."
        fi
    done

    if [ ${#packages_to_install[@]} -gt 0 ]; then
        log_info "Installing $description: ${packages_to_install[*]}"
        sudo pacman -S --noconfirm --needed "${packages_to_install[@]}"
    else
        log_info "All packages for $description are already installed"
    fi
}

# Install AUR packages with yay (idempotent)
install_aur_packages() {
    local description="$1"
    shift
    local packages=("$@")
    local packages_to_install=()

    if ! command -v yay &> /dev/null; then
        log_warn "yay not found, skipping AUR packages: $description"
        return
    fi

    # Filter out already installed packages
    for package in "${packages[@]}"; do
        if ! is_aur_package_installed "$package"; then
            packages_to_install+=("$package")
        else
            log_info "AUR package $package is already installed, skipping..."
        fi
    done

    if [ ${#packages_to_install[@]} -gt 0 ]; then
        log_info "Installing AUR $description: ${packages_to_install[*]}"
        yay -S --noconfirm --needed "${packages_to_install[@]}"
    else
        log_info "All AUR packages for $description are already installed"
    fi
}

# Install essential packages
install_essential_packages() {
    install_packages "essential packages" \
        base-devel \
        git \
        curl \
        jq \
        make \
        less \
        unzip \
        gcc \
        udiskie \
        ffmpeg
}

# Install shell and terminal
install_shell_terminal() {
    install_packages "shell and terminal" \
        fish \
        alacritty \
        tmux
}

# Install editors
install_editors() {
    install_packages "editors" neovim
}

# Install Wayland desktop environment
install_wayland_desktop() {
    install_packages "Wayland desktop environment" \
        sway \
        waybar \
        wofi \
        mako \
        swaylock \
        swayidle \
        swaybg \
        wl-clipboard \
        cliphist \
        grim \
        slurp \
        brightnessctl \
        xorg-xwayland \
        nm-connection-editor
}

# Install display managers
install_display_manager() {
    local choice="$1"

    case $choice in
        1|sddm)
            install_packages "SDDM" sddm
            ;;
        2|greetd)
            install_packages "greetd with ReGreet" greetd greetd-regreet
            ;;
        3|kde)
            install_packages "KDE Plasma" plasma kde-applications sddm xorg
            ;;
        *)
            log_info "Skipping display manager installation..."
            ;;
    esac
}

# Install CPU microcode
install_cpu_microcode() {
    local choice="$1"

    case $choice in
        1|amd)
            install_packages "AMD microcode" amd-ucode
            ;;
        2|intel)
            install_packages "Intel microcode" intel-ucode
            ;;
        *)
            log_info "Skipping CPU microcode installation..."
            ;;
    esac
}

# Install GPU drivers
install_gpu_drivers() {
    local choice="$1"

    case $choice in
        1|nvidia)
            log_info "Installing NVIDIA drivers..."
            install_packages "NVIDIA drivers" nvidia nvidia-utils nvidia-settings
            ;;
        2|amd-intel)
            log_info "Installing AMD/Intel drivers..."
            install_packages "AMD/Intel drivers" xf86-video-amdgpu xf86-video-intel vulkan-radeon vulkan-intel
            ;;
        *)
            log_info "Skipping GPU drivers installation..."
            ;;
    esac
}

# Install audio system
install_audio_system() {
    install_packages "audio system" \
        pipewire \
        pipewire-alsa \
        pavucontrol \
        pipewire-pulse \
        wireplumber
}

# Install fonts
install_fonts() {
    install_packages "fonts" \
        ttf-jetbrains-mono-nerd \
        otf-font-awesome
}

# Install development tools
install_development_tools() {
    install_packages "development tools" \
        php \
        php-gd \
        php-intl \
        composer \
        docker \
        docker-compose \
        python-pip \
        python-pipx \
        go
}

# Install utilities
install_utilities() {
    install_packages "utilities" \
        ripgrep \
        fd \
        bottom \
        firefox \
        wireguard-tools \
        github-cli \
        mesa \
        flatpak \
        bluez \
        bluez-utils \
        ufw \
        networkmanager \
        openssh \
        openssl
}

# Install multimedia codecs
install_multimedia_codecs() {
    install_packages "multimedia codecs" \
        a52dec \
        faac \
        faad2 \
        flac \
        jasper \
        lame \
        libdca \
        libdv \
        libmad \
        libmpeg2 \
        libtheora \
        libvorbis \
        libxv \
        wavpack \
        x264 \
        xvidcore \
        gstreamer \
        gst-libav \
        libdvdnav \
        fuse-exfat \
        libdvdcss \
        libdvdread \
        exfat-utils
}

# Install optional applications
install_optional_apps() {
    local app="$1"

    case $app in
        discord)
            install_packages "Discord" discord
            ;;
        telegram)
            install_packages "Telegram" telegram-desktop
            ;;
        spotify)
            if command -v yay &> /dev/null; then
                install_aur_packages "Spotify" spotify
            else
                install_packages "Spotify Launcher" spotify-launcher
            fi
            ;;
        vlc)
            install_packages "VLC media player" vlc
            ;;
        obsidian)
            install_packages "Obsidian" obsidian
            ;;
        *)
            log_warn "Unknown optional application: $app"
            ;;
    esac
}

# Install AUR packages
install_aur_essentials() {
    if ! command -v yay &> /dev/null; then
        log_warn "yay not found, skipping AUR packages"
        return
    fi

    # Essential AUR packages can be added here
    # install_aur_packages "essential AUR packages" package1 package2
}

# Install specific AUR applications
install_aur_app() {
    local app="$1"

    case $app in
        vscode)
            install_aur_packages "Visual Studio Code" visual-studio-code-bin
            ;;
        swayfx)
            # Remove sway first if installing swayfx
            if is_package_installed "sway" && ! is_aur_package_installed "swayfx"; then
                log_info "Removing sway to install swayfx..."
                sudo pacman -R --noconfirm sway
            fi
            install_aur_packages "SwayFX" swayfx
            ;;
        swaylock-effects)
            # Remove swaylock first if installing swaylock-effects
            if is_package_installed "swaylock" && ! is_aur_package_installed "swaylock-effects"; then
                log_info "Removing swaylock to install swaylock-effects..."
                sudo pacman -R --noconfirm swaylock
            fi
            install_aur_packages "Swaylock Effects" swaylock-effects
            ;;
        wlogout)
            install_aur_packages "wlogout" wlogout
            ;;
        grub-customizer)
            install_aur_packages "GRUB Customizer" grub-customizer
            ;;
        *)
            log_warn "Unknown AUR application: $app"
            ;;
    esac
}

# Install yay AUR helper
install_yay() {
    if command -v yay &> /dev/null; then
        log_info "yay is already installed"
        return
    fi

    log_info "Installing yay AUR helper..."
    cd /tmp
    git clone https://aur.archlinux.org/yay.git
    cd yay

    # Build and install yay
    log_info "Building yay from source..."
    makepkg -si --noconfirm --needed

    cd ~
    rm -rf /tmp/yay

    if command -v yay &> /dev/null; then
        log_info "yay AUR helper installed successfully!"
    else
        log_error "Failed to install yay AUR helper"
        return 1
    fi
}

# Main installation function
main() {
    local action="$1"
    shift

    case $action in
        essential)
            install_essential_packages
            ;;
        shell)
            install_shell_terminal
            ;;
        editors)
            install_editors
            ;;
        wayland)
            install_wayland_desktop
            ;;
        display-manager)
            install_display_manager "$1"
            ;;
        cpu-microcode)
            install_cpu_microcode "$1"
            ;;
        gpu-drivers)
            install_gpu_drivers "$1"
            ;;
        audio)
            install_audio_system
            ;;
        fonts)
            install_fonts
            ;;
        development)
            install_development_tools
            ;;
        utilities)
            install_utilities
            ;;
        multimedia)
            install_multimedia_codecs
            ;;
        yay)
            install_yay
            ;;
        aur-essentials)
            install_aur_essentials
            ;;
        optional-app)
            install_optional_apps "$1"
            ;;
        aur-app)
            install_aur_app "$1"
            ;;
        all-basic)
            install_essential_packages
            install_shell_terminal
            install_editors
            install_wayland_desktop
            install_audio_system
            install_fonts
            install_development_tools
            install_utilities
            ;;
        help|--help|-h)
            echo "Usage: $0 <action> [options]"
            echo ""
            echo "Actions:"
            echo "  essential           - Install essential packages"
            echo "  shell              - Install shell and terminal"
            echo "  editors            - Install editors"
            echo "  wayland            - Install Wayland desktop environment"
            echo "  display-manager <type> - Install display manager (1|sddm, 2|greetd, 3|kde)"
            echo "  cpu-microcode <type>   - Install CPU microcode (1|amd, 2|intel)"
            echo "  gpu-drivers <type>     - Install GPU drivers (1|nvidia, 2|amd-intel)"
            echo "  audio              - Install audio system"
            echo "  fonts              - Install fonts"
            echo "  development        - Install development tools"
            echo "  utilities          - Install utilities"
            echo "  multimedia         - Install multimedia codecs"
            echo "  yay                - Install yay AUR helper"
            echo "  aur-essentials     - Install essential AUR packages"
            echo "  optional-app <app> - Install optional app (discord|telegram|spotify|vlc|obsidian)"
            echo "  aur-app <app>      - Install AUR app (vscode|swayfx|swaylock-effects|wlogout|grub-customizer)"
            echo "  all-basic          - Install all basic packages"
            echo ""
            echo "Examples:"
            echo "  $0 all-basic"
            echo "  $0 display-manager sddm"
            echo "  $0 cpu-microcode amd"
            echo "  $0 optional-app discord"
            echo "  $0 aur-app vscode"
            ;;
        *)
            log_error "Unknown action: $action"
            echo "Use '$0 help' for usage information"
            exit 1
            ;;
    esac
}

# Check if running on Arch Linux
if ! command -v pacman &> /dev/null; then
    log_error "This script is designed for Arch Linux only!"
    exit 1
fi

# Run main function with all arguments
main "$@"
