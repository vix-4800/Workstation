#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
THEME_SOURCE="$SCRIPT_DIR/../grub/catppuccin-mocha"
THEME_NAME="catppuccin-mocha-grub-theme"
GRUB_THEMES_DIR="/usr/share/grub/themes"
GRUB_CONFIG="/etc/default/grub"

echo "Copying theme to GRUB themes directory..."
sudo cp -r "$THEME_SOURCE" "$GRUB_THEMES_DIR/$THEME_NAME"

echo "Updating GRUB configuration..."
sudo sed -i 's|^#\?GRUB_THEME=.*|GRUB_THEME="'$GRUB_THEMES_DIR/$THEME_NAME'/theme.txt"|' "$GRUB_CONFIG"

if ! grep -q "^GRUB_THEME=" "$GRUB_CONFIG"; then
    echo 'GRUB_THEME="'$GRUB_THEMES_DIR/$THEME_NAME'/theme.txt"' | sudo tee -a "$GRUB_CONFIG" > /dev/null
fi

sudo sed -i 's|^GRUB_TERMINAL_OUTPUT=|#GRUB_TERMINAL_OUTPUT=|' "$GRUB_CONFIG"

echo "Generating GRUB configuration..."
if [ -f /boot/grub/grub.cfg ]; then
    sudo grub-mkconfig -o /boot/grub/grub.cfg
elif [ -f /boot/grub2/grub.cfg ]; then
    sudo grub2-mkconfig -o /boot/grub2/grub.cfg
else
    echo "Error: grub.cfg file not found"
    exit 1
fi

echo "Done! Theme installed."
