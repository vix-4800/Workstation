#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
CONF_MAP_DEFAULT="${REPO_ROOT}/linux.confmap"
CONF_MAP="${DOTFILES_MAP:-${CONF_MAP_DEFAULT}}"
BACKUP_DIR="${HOME}/.local/share/dotfiles/backups"
LOG_PREFIX="[dotfiles]"

if [ -t 1 ]; then
    BOLD="$(printf '\033[1m')";
    DIM="$(printf '\033[2m')";
    RED="$(printf '\033[31m')"
    GRN="$(printf '\033[32m')";
    YLW="$(printf '\033[33m')";
    OFF="$(printf '\033[0m')"
else
    BOLD="";
    DIM="";
    RED="";
    GRN="";
    YLW="";
    OFF=""
fi

usage() {
    cat <<EOF
${BOLD}dotfiles${OFF} — manages symbolic links from repository.

${BOLD}Usage:${OFF}
    dotfiles link [-n] [--map PATH]     Create/update links (dry-run with -n)
    dotfiles unlink [-n] [--map PATH]   Remove links (dry-run with -n)
    dotfiles status [--map PATH]        Show link status
    dotfiles doctor [--map PATH]        Environment checks
    dotfiles which [--map PATH]         Show path to repo and map
    dotfiles edit  [--map PATH]         Open map in \$EDITOR
    dotfiles help                       Help

${BOLD}Map format:${OFF}
    Line format: <source_relpath>\t<target_absolute_path>
    Empty lines and #comments are ignored.
EOF
}

msg() { echo -e "${LOG_PREFIX} $*"; }
ok()  { echo -e "${GRN}${LOG_PREFIX}${OFF} $*"; }
warn(){ echo -e "${YLW}${LOG_PREFIX}${OFF} $*"; }
err() { echo -e "${RED}${LOG_PREFIX}${OFF} $*" >&2; }

maybe_pick_map() {
    local next_is_map=0
    for arg in "$@"; do
        if [ "${next_is_map}" -eq 1 ]; then
            CONF_MAP="$arg"
            next_is_map=0
            continue
        fi
        case "$arg" in
            --map)
                next_is_map=1
                ;;
            --map=*)
                CONF_MAP="${arg#--map=}"
                ;;
        esac
    done
}

require_map() {
    [ -f "${CONF_MAP}" ] || { err "Map not found: ${CONF_MAP}"; exit 1; }
}

timestamp() { date +"%Y%m%d-%H%M%S"; }

resolve_variables() {
    local path="$1"
    path="${path//\$HOME/$HOME}"
    path="${path/#\~/$HOME}"
    echo "$path"
}

read_map() {
    require_map
    awk -v repo="${REPO_ROOT}" '
        BEGIN{ FS="\t" }
        /^[[:space:]]*$/ {next}
        /^[[:space:]]*#/ {next}
        {
            src = $1
            tgt = $2
            for (i=3; i<=NF; i++) { tgt = tgt "\t" $i }

            if (src ~ /^\//) print src "\t" tgt;
            else print repo "/" src "\t" tgt;
        }' "${CONF_MAP}"
}

ensure_parent_dir() {
    local path="$1"
    local dir
    dir="$(dirname "$path")"
    mkdir -p "$dir"
}

backup_if_exists() {
    local target="$1"
    if [ -e "${target}" ] && [ ! -L "${target}" ]; then
        mkdir -p "${BACKUP_DIR}"
        local ts base dest
        ts="$(timestamp)"
        base="$(basename "${target}")"
        dest="${BACKUP_DIR}/${base}.${ts}.bak"
        mv "${target}" "${dest}"
        ok "Backup ${target} -> ${dest}"
    fi
}

canonical() {
    if command -v realpath >/dev/null 2>&1; then
        realpath "$1"
    else
        printf '%s' "$1"
    fi
}

do_link() {
    local dryrun="${1:-0}"
    read_map | while IFS=$'\t' read -r SRC TGT_RAW; do
        TGT="$(resolve_variables "$TGT_RAW")"

        if [ ! -e "${SRC}" ]; then
            warn "Source missing: ${SRC} — skipping"
            continue
        fi
        ensure_parent_dir "${TGT}"

        if [ "${dryrun}" -eq 1 ]; then
            msg "DRY-RUN: ln -sfn ${SRC} ${TGT}"
        else
            backup_if_exists "${TGT}"
            ln -sfn "${SRC}" "${TGT}"
            ok "Linked: ${TGT} -> ${SRC}"
        fi
    done

    # BAT
    bat cache --build

    # GRUB
    sudo grub-mkconfig -o /boot/grub/grub.cfg
}

do_unlink() {
    local dryrun="${1:-0}"
    read_map | while IFS=$'\t' read -r _ TGT_RAW; do
        TGT="$(resolve_variables "$TGT_RAW")"
        if [ -L "${TGT}" ]; then
            if [ "${dryrun}" -eq 1 ]; then
                msg "DRY-RUN: rm ${TGT}"
            else
                rm "${TGT}"
                ok "Removed symlink: ${TGT}"
            fi
        else
            warn "No symlink: ${TGT}"
        fi
    done
}

do_status() {
    read_map | while IFS=$'\t' read -r SRC TGT_RAW; do
        TGT="$(resolve_variables "$TGT_RAW")"
        if [ -L "${TGT}" ]; then

            local points expect
            points="$(readlink "${TGT}")"

            case "$points" in
                /*) ;;
                *) points="$(cd "$(dirname "${TGT}")" && pwd)/${points}";;
            esac
            expect="${SRC}"
            local cpoints cexpected
            cpoints="$(canonical "$points")"
            cexpected="$(canonical "$expect")"
            if [ -n "$cexpected" ] && [ -n "$cpoints" ] && [ "$cpoints" = "$cexpected" ]; then
                echo -e "✓ ${TGT} ${DIM}->${OFF} ${SRC}"
            else
                echo -e "✗ ${TGT} ${DIM}->${OFF} ${points} ${RED}(expected ${SRC})${OFF}"
            fi
        elif [ -e "${TGT}" ]; then
            echo -e "⚠ ${TGT} — regular file/folder, not symlink"
        else
            echo -e "– ${TGT} — missing"
        fi
    done
}

do_doctor() {
    local ok_all=1
    command -v git >/dev/null || { err "git not found in PATH"; ok_all=0; }
    [ -d "${REPO_ROOT}/.git" ] || { err "This doesn't appear to be a git repository: ${REPO_ROOT}"; ok_all=0; }
    require_map || ok_all=0
    if [ "${ok_all}" -eq 1 ]; then ok "All checks passed"; else exit 1; fi
}

cmd="${1:-}"
shift || true
maybe_pick_map "$@"

case "${cmd}" in
    help|-h|--help|"") usage ;;
    which) echo -e "REPO: ${REPO_ROOT}\nMAP:  ${CONF_MAP}";;
    edit)  ${EDITOR:-vi} "${CONF_MAP}";;
    init)  usage ;;
    link)    if [ "${1:-}" = "-n" ]; then do_link 1; else do_link 0; fi ;;
    unlink)  if [ "${1:-}" = "-n" ]; then do_unlink 1; else do_unlink 0; fi ;;
    status) do_status ;;
    doctor) do_doctor ;;
    *) err "Unknown command: ${cmd}"; usage; exit 1 ;;
esac
