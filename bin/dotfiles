#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
CONF_JSON_DEFAULT="${REPO_ROOT}/dotfiles.json"
CONF_JSON="${DOTFILES_JSON:-${CONF_JSON_DEFAULT}}"
BACKUP_DIR="${HOME}/.local/share/dotfiles/backups"
LOG_PREFIX="[dotfiles]"

if [ -t 1 ]; then
    BOLD="$(printf '\033[1m')";
    DIM="$(printf '\033[2m')";
    RED="$(printf '\033[31m')"
    GRN="$(printf '\033[32m')";
    YLW="$(printf '\033[33m')";
    OFF="$(printf '\033[0m')"
else
    BOLD="";
    DIM="";
    RED="";
    GRN="";
    YLW="";
    OFF=""
fi

usage() {
    cat <<EOF
${BOLD}dotfiles${OFF} — manages symbolic links from repository (JSON-based).

${BOLD}Usage:${OFF}
    dotfiles link [-n] [--json PATH]       Create/update symlinks
    dotfiles unlink [-n] [--json PATH]     Remove symlinks
    dotfiles status [--json PATH]          Show link status
    dotfiles doctor [--json PATH]          Environment checks
    dotfiles which [--json PATH]           Show repo and config paths
    dotfiles edit [--json PATH]            Open config in \$EDITOR
    dotfiles help                          Show this help

${BOLD}Options:${OFF}
    -n            Dry-run mode (don't make changes)
    --json PATH   Path to dotfiles.json (default: ${CONF_JSON_DEFAULT})

${BOLD}JSON format:${OFF}
    {
      "version": "1.0",
      "mappings": [
        {
          "source": "config/file",
          "target": "\$HOME/.config/file",
          "comment": "Optional comment"
        }
      ]
    }
EOF
}

msg() { echo -e "${LOG_PREFIX} $*"; }
ok()  { echo -e "${GRN}${LOG_PREFIX}${OFF} $*"; }
warn(){ echo -e "${YLW}${LOG_PREFIX}${OFF} $*"; }
err() { echo -e "${RED}${LOG_PREFIX}${OFF} $*" >&2; }

parse_args() {
    DRYRUN=0

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --json)
                CONF_JSON="${2:-}"
                shift 2
                ;;
            --json=*)
                CONF_JSON="${1#--json=}"
                shift
                ;;
            -n)
                DRYRUN=1
                shift
                ;;
            *)
                shift
                ;;
        esac
    done
}

require_json() {
    if [ ! -f "${CONF_JSON}" ]; then
        err "JSON config not found: ${CONF_JSON}"
        exit 1
    fi

    if ! command -v jq >/dev/null 2>&1; then
        err "jq is required but not installed"
        exit 1
    fi
}

timestamp() { date +"%Y%m%d-%H%M%S"; }

resolve_variables() {
    local path="$1"
    path="${path//\$HOME/$HOME}"
    path="${path/#\~/$HOME}"
    echo "$path"
}

read_mappings() {
    require_json
    jq -r '.mappings[] | "\(.source)\t\(.target)"' "${CONF_JSON}"
}

ensure_parent_dir() {
    local path="$1"
    local dir
    dir="$(dirname "$path")"
    mkdir -p "$dir"
}

backup_if_exists() {
    local target="$1"
    if [ -e "${target}" ] && [ ! -L "${target}" ]; then
        mkdir -p "${BACKUP_DIR}"
        local ts base dest
        ts="$(timestamp)"
        base="$(basename "${target}")"
        dest="${BACKUP_DIR}/${base}.${ts}.bak"
        mv "${target}" "${dest}"
        ok "Backup ${target} -> ${dest}"
    fi
}

canonical() {
    if command -v realpath >/dev/null 2>&1; then
        realpath "$1" 2>/dev/null || echo "$1"
    else
        echo "$1"
    fi
}

make_absolute_source() {
    local src="$1"
    if [[ "$src" =~ ^/ ]]; then
        echo "$src"
    else
        echo "${REPO_ROOT}/${src}"
    fi
}

do_link() {
    read_mappings | while IFS=$'\t' read -r SRC_RAW TGT_RAW; do
        local SRC TGT
        SRC="$(make_absolute_source "$SRC_RAW")"
        TGT="$(resolve_variables "$TGT_RAW")"

        if [ ! -e "${SRC}" ]; then
            warn "Source missing: ${SRC} — skipping"
            continue
        fi

        ensure_parent_dir "${TGT}"

        if [ "${DRYRUN}" -eq 1 ]; then
            msg "DRY-RUN: ln -sfn ${SRC} ${TGT}"
        else
            backup_if_exists "${TGT}"
            ln -sfn "${SRC}" "${TGT}"
            ok "Linked: ${TGT} -> ${SRC}"
        fi
    done

    if [ "${DRYRUN}" -eq 0 ]; then
        if command -v bat >/dev/null 2>&1; then
            bat cache --build >/dev/null 2>&1 || true
        fi
    fi
}

do_unlink() {
    read_mappings | while IFS=$'\t' read -r _ TGT_RAW; do
        local TGT
        TGT="$(resolve_variables "$TGT_RAW")"

        if [ -L "${TGT}" ]; then
            if [ "${DRYRUN}" -eq 1 ]; then
                msg "DRY-RUN: rm ${TGT}"
            else
                rm "${TGT}"
                ok "Removed symlink: ${TGT}"
            fi
        else
            warn "No symlink: ${TGT}"
        fi
    done
}

do_status() {
    read_mappings | while IFS=$'\t' read -r SRC_RAW TGT_RAW; do
        local SRC TGT
        SRC="$(make_absolute_source "$SRC_RAW")"
        TGT="$(resolve_variables "$TGT_RAW")"

        if [ -L "${TGT}" ]; then
            local points
            points="$(readlink "${TGT}")"

            case "$points" in
                /*) ;;
                *) points="$(cd "$(dirname "${TGT}")" && pwd)/${points}";;
            esac

            local cpoints cexpected
            cpoints="$(canonical "$points")"
            cexpected="$(canonical "$SRC")"

            if [ -n "$cexpected" ] && [ -n "$cpoints" ] && [ "$cpoints" = "$cexpected" ]; then
                echo -e "✓ ${TGT} ${DIM}->${OFF} ${SRC}"
            else
                echo -e "✗ ${TGT} ${DIM}->${OFF} ${points} ${RED}(expected ${SRC})${OFF}"
            fi
        elif [ -e "${TGT}" ]; then
            echo -e "⚠ ${TGT} — regular file/folder, not symlink"
        else
            echo -e "– ${TGT} — missing"
        fi
    done
}

do_doctor() {
    local ok_all=1

    command -v git >/dev/null || { err "git not found in PATH"; ok_all=0; }
    command -v jq >/dev/null || { err "jq not found in PATH"; ok_all=0; }
    [ -d "${REPO_ROOT}/.git" ] || { err "Not a git repository: ${REPO_ROOT}"; ok_all=0; }

    if [ -f "${CONF_JSON}" ]; then
        if ! jq empty "${CONF_JSON}" 2>/dev/null; then
            err "Invalid JSON in ${CONF_JSON}"
            ok_all=0
        fi
    else
        err "JSON config not found: ${CONF_JSON}"
        ok_all=0
    fi

    if [ "${ok_all}" -eq 1 ]; then
        ok "All checks passed"
    else
        exit 1
    fi
}

cmd="${1:-}"
shift || true
parse_args "$@"

case "${cmd}" in
    help|-h|--help|"")
        usage
        ;;
    which)
        echo -e "REPO: ${REPO_ROOT}\nJSON: ${CONF_JSON}"
        ;;
    edit)
        ${EDITOR:-vi} "${CONF_JSON}"
        ;;
    link)
        do_link
        ;;
    unlink)
        do_unlink
        ;;
    status)
        do_status
        ;;
    doctor)
        do_doctor
        ;;
    *)
        err "Unknown command: ${cmd}"
        usage
        exit 1
        ;;
esac
