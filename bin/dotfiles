#!/usr/bin/env bash
set -euo pipefail

# -------- Конфиг по умолчанию --------
# Корень репозитория — по расположению скрипта (надёжно, даже если вызван из другого каталога)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Карта соответствий: env DOTFILES_MAP или --map или по умолчанию linux.confmap в корне репо
CONF_MAP_DEFAULT="${REPO_ROOT}/linux.confmap"
CONF_MAP="${DOTFILES_MAP:-${CONF_MAP_DEFAULT}}"

BACKUP_DIR="${HOME}/.local/share/dotfiles/backups"
LOG_PREFIX="[dotfiles]"

# Цвета (если TTY)
if [ -t 1 ]; then
  BOLD="$(printf '\033[1m')"; DIM="$(printf '\033[2m')"; RED="$(printf '\033[31m')"
  GRN="$(printf '\033[32m')"; YLW="$(printf '\033[33m')"; BLU="$(printf '\033[34m')"
  OFF="$(printf '\033[0m')"
else
  BOLD=""; DIM=""; RED=""; GRN=""; YLW=""; BLU=""; OFF=""
fi

usage() {
  cat <<EOF
${BOLD}dotfiles${OFF} — управляет символическими ссылками из репозитория.

${BOLD}Использование:${OFF}
  dotfiles link [-n] [--map PATH]     Создать/обновить ссылки (dry-run с -n)
  dotfiles unlink [-n] [--map PATH]   Удалить ссылки (dry-run с -n)
  dotfiles update [--map PATH]        git pull в репозитории + relink
  dotfiles status [--map PATH]        Показать статус ссылок
  dotfiles doctor [--map PATH]        Проверки окружения
  dotfiles which [--map PATH]         Показать путь к репо и карту
  dotfiles edit  [--map PATH]         Открыть карту в \$EDITOR
  dotfiles help                       Помощь

${BOLD}Карта соответствий:${OFF}
  Формат строк: <source_relpath>\t<target_absolute_path>
  Пустые строки и #комментарии игнорируются.
EOF
}

msg() { echo -e "${LOG_PREFIX} $*"; }
ok()  { echo -e "${GRN}${LOG_PREFIX}${OFF} $*"; }
warn(){ echo -e "${YLW}${LOG_PREFIX}${OFF} $*"; }
err() { echo -e "${RED}${LOG_PREFIX}${OFF} $*" >&2; }

# --- парсинг --map (минимальный) ---
maybe_pick_map() {
  local next_is_map=0
  for arg in "$@"; do
    if [ "${next_is_map}" -eq 1 ]; then
      CONF_MAP="$arg"
      next_is_map=0
      continue
    fi
    case "$arg" in
      --map)
        next_is_map=1
        ;;
      --map=*)
        CONF_MAP="${arg#--map=}"
        ;;
    esac
  done
}

require_map() {
  [ -f "${CONF_MAP}" ] || { err "Не найдена карта: ${CONF_MAP}"; exit 1; }
}

timestamp() { date +"%Y%m%d-%H%M%S"; }

resolve_variables() {
  local path="$1"
  # Раскрываем $HOME
  path="${path//\$HOME/$HOME}"
  # Раскрываем ~
  path="${path/#\~/$HOME}"
  echo "$path"
}

# Читает карту, отдаёт строки "SRC_ABS<TAB>TGT_ABS"
read_map() {
  require_map
  awk -v repo="${REPO_ROOT}" '
    BEGIN{ FS="\t" }
    /^[[:space:]]*$/ {next}
    /^[[:space:]]*#/ {next}
    {
      src = $1
      tgt = $2
      for (i=3; i<=NF; i++) { tgt = tgt "\t" $i } # на случай табов внутри пути

      if (src ~ /^\//) print src "\t" tgt;
      else print repo "/" src "\t" tgt;
    }' "${CONF_MAP}"
}

ensure_parent_dir() {
  local path="$1"
  local dir
  dir="$(dirname "$path")"
  mkdir -p "$dir"
}

backup_if_exists() {
  local target="$1"
  if [ -e "${target}" ] && [ ! -L "${target}" ]; then
    mkdir -p "${BACKUP_DIR}"
    local ts base dest
    ts="$(timestamp)"
    base="$(basename "${target}")"
    dest="${BACKUP_DIR}/${base}.${ts}.bak"
    mv "${target}" "${dest}"
    ok "Бэкап ${target} -> ${dest}"
  fi
}

canonical() {
  # Пытаемся получить канонический путь (если realpath есть)
  if command -v realpath >/dev/null 2>&1; then
    realpath "$1"
  else
    # fallback: просто возвращаем как есть
    printf '%s' "$1"
  fi
}

do_link() {
  local dryrun="${1:-0}"
  read_map | while IFS=$'\t' read -r SRC TGT_RAW; do
    # раскрываем переменные и ~ в цели
    TGT="$(resolve_variables "$TGT_RAW")"

    if [ ! -e "${SRC}" ]; then
      warn "Источник отсутствует: ${SRC} — пропуск"
      continue
    fi
    ensure_parent_dir "${TGT}"

    if [ "${dryrun}" -eq 1 ]; then
      msg "DRY-RUN: ln -sfn ${SRC} ${TGT}"
    else
      backup_if_exists "${TGT}"
      ln -sfn "${SRC}" "${TGT}"
      ok "Связано: ${TGT} -> ${SRC}"
    fi
  done
}

do_unlink() {
  local dryrun="${1:-0}"
  read_map | while IFS=$'\t' read -r _ TGT_RAW; do
    TGT="$(resolve_variables "$TGT_RAW")"
    if [ -L "${TGT}" ]; then
      if [ "${dryrun}" -eq 1 ]; then
        msg "DRY-RUN: rm ${TGT}"
      else
        rm "${TGT}"
        ok "Удалён symlink: ${TGT}"
      fi
    else
      warn "Нет symlink: ${TGT}"
    fi
  done
}

do_status() {
  read_map | while IFS=$'\t' read -r SRC TGT_RAW; do
    TGT="$(resolve_variables "$TGT_RAW")"
    if [ -L "${TGT}" ]; then

      local points expect
      points="$(readlink "${TGT}")"

      case "$points" in
        /*) ;;
        *) points="$(cd "$(dirname "${TGT}")" && pwd)/${points}";;
      esac
      expect="${SRC}"
      local cpoints cexpect
      cpoints="$(canonical "$points")"
      cexpect="$(canonical "$expect")"
      if [ -n "$cexpect" ] && [ -n "$cpoints" ] && [ "$cpoints" = "$cexpect" ]; then
        echo -e "✓ ${TGT} ${DIM}->${OFF} ${SRC}"
      else
        echo -e "✗ ${TGT} ${DIM}->${OFF} ${points} ${RED}(ожидалось ${SRC})${OFF}"
      fi
    elif [ -e "${TGT}" ]; then
      echo -e "⚠ ${TGT} — обычный файл/папка, не symlink"
    else
      echo -e "– ${TGT} — отсутствует"
    fi
  done
}

do_update() {
  (cd "${REPO_ROOT}" && git pull --ff-only)
  do_link 0
}

do_doctor() {
  local ok_all=1
  command -v git >/dev/null || { err "git не найден в PATH"; ok_all=0; }
  [ -d "${REPO_ROOT}/.git" ] || { err "Похоже, это не git-репозиторий: ${REPO_ROOT}"; ok_all=0; }
  require_map || ok_all=0
  if [ "${ok_all}" -eq 1 ]; then ok "Проверки пройдены"; else exit 1; fi
}

# -------- Точка входа --------
cmd="${1:-}"
shift || true
maybe_pick_map "$@"

case "${cmd}" in
  help|-h|--help|"") usage ;;
  which) echo -e "REPO: ${REPO_ROOT}\nMAP:  ${CONF_MAP}";;
  edit)  ${EDITOR:-vi} "${CONF_MAP}";;
  init)  usage ;;
  link)    [ "${1:-}" = "-n" ] && do_link 1 || do_link 0 ;;
  unlink)  [ "${1:-}" = "-n" ] && do_unlink 1 || do_unlink 0 ;;
  update) do_update ;;
  status) do_status ;;
  doctor) do_doctor ;;
  *) err "Неизвестная команда: ${cmd}"; usage; exit 1 ;;
esac
