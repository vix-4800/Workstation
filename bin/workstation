#!/usr/bin/env bash
set -euo pipefail

# Resolve the real path of the script (following symlinks)
SCRIPT_PATH="${BASH_SOURCE[0]}"
while [[ -L "${SCRIPT_PATH}" ]]; do
    SCRIPT_DIR="$(cd "$(dirname "${SCRIPT_PATH}")" && pwd)"
    SCRIPT_PATH="$(readlink "${SCRIPT_PATH}")"
    [[ ${SCRIPT_PATH} != /* ]] && SCRIPT_PATH="${SCRIPT_DIR}/${SCRIPT_PATH}"
done
SCRIPT_DIR="$(cd "$(dirname "${SCRIPT_PATH}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

CONF_JSON_DEFAULT="${REPO_ROOT}/dotfiles.json"
CONF_JSON="${DOTFILES_JSON:-${CONF_JSON_DEFAULT}}"
BACKUP_DIR="${HOME}/.local/share/dotfiles/backups"
SYSTEMD_DIR="${REPO_ROOT}/systemd/user"
LOG_PREFIX="[workstation]"

if [[ -t 1 ]]; then
    BOLD="$(printf '\033[1m')";
    DIM="$(printf '\033[2m')";
    RED="$(printf '\033[31m')"
    GRN="$(printf '\033[32m')";
    YLW="$(printf '\033[33m')";
    BLU="$(printf '\033[34m')";
    OFF="$(printf '\033[0m')"
else
    BOLD="";
    DIM="";
    RED="";
    GRN="";
    YLW="";
    BLU="";
    OFF=""
fi

usage() {
    cat <<EOF
${BOLD}workstation${OFF} — unified dotfiles and systemd services management.

${BOLD}Usage:${OFF}
    workstation <command> [options]

${BOLD}Setup Commands:${OFF}
    setup                         Bootstrap dotfiles on a new system
    update [-n]                   Pull changes from git and reapply config

${BOLD}Dotfiles Commands:${OFF}
    dotfiles link [-n] [--json PATH]      Create/update symlinks
    dotfiles unlink [-n] [--json PATH]    Remove symlinks
    dotfiles status [--json PATH]         Show link status
    dotfiles doctor [--json PATH]         Environment checks
    dotfiles which [--json PATH]          Show repo and config paths
    dotfiles edit [--json PATH]           Open config in \$EDITOR

${BOLD}Services Commands:${OFF}
    services enable-all           Enable and start all services/timers
    services disable-all          Disable and stop all services/timers
    services status               Show status of all services/timers
    services list                 List all services in dotfiles

${BOLD}Global Options:${OFF}
    -n            Dry-run mode (don't make changes)
    --json PATH   Path to dotfiles.json (default: ${CONF_JSON_DEFAULT})
    -h, --help    Show this help

${BOLD}Examples:${OFF}
    workstation setup                      # Bootstrap new system
    workstation update                     # Update from git repo
    workstation dotfiles link -n           # Dry-run symlinks
    workstation dotfiles status            # Check link status
    workstation dotfiles doctor            # Run environment checks
    workstation services enable-all        # Enable all services
    workstation services status            # Show services status
EOF
}

msg() { echo -e "${LOG_PREFIX} $*"; }
ok()  { echo -e "${GRN}${LOG_PREFIX}${OFF} $*"; }
warn(){ echo -e "${YLW}${LOG_PREFIX}${OFF} $*"; }
err() { echo -e "${RED}${LOG_PREFIX}${OFF} $*" >&2; }

parse_args() {
    DRYRUN=0

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --json)
                CONF_JSON="${2:-}"
                shift 2
                ;;
            --json=*)
                CONF_JSON="${1#--json=}"
                shift
                ;;
            -n)
                DRYRUN=1
                shift
                ;;
            *)
                shift
                ;;
        esac
    done
}

require_json() {
    if [[ ! -f "${CONF_JSON}" ]]; then
        err "JSON config not found: ${CONF_JSON}"
        exit 1
    fi

    if ! command -v jq >/dev/null 2>&1; then
        err "jq is required but not installed"
        exit 1
    fi
}

timestamp() { date +"%Y%m%d-%H%M%S"; }

resolve_variables() {
    local path="$1"
    path="${path//\$HOME/${HOME}}"
    path="${path/#\~/${HOME}}"
    echo "${path}"
}

read_mappings() {
    require_json
    jq -r '.mappings[] | "\(.source)\t\(.target)"' "${CONF_JSON}"
}

ensure_parent_dir() {
    local path="$1"
    local dir
    dir="$(dirname "${path}")"
    mkdir -p "${dir}"
}

backup_if_exists() {
    local target="$1"
    if [[ -e "${target}" ]] && [[ ! -L "${target}" ]]; then
        mkdir -p "${BACKUP_DIR}"
        local ts base dest
        ts="$(timestamp)"
        base="$(basename "${target}")"
        dest="${BACKUP_DIR}/${base}.${ts}.bak"
        mv "${target}" "${dest}"
        ok "Backup ${BOLD}${target}${OFF} ${DIM}->${OFF} ${BLU}${dest}${OFF}"
    fi
}

canonical() {
    if command -v realpath >/dev/null 2>&1; then
        realpath "$1" 2>/dev/null || echo "$1"
    else
        echo "$1"
    fi
}

make_absolute_source() {
    local src="$1"
    if [[ "${src}" =~ ^/ ]]; then
        echo "${src}"
    else
        echo "${REPO_ROOT}/${src}"
    fi
}

# Dotfiles commands
do_link() {
    read_mappings | while IFS=$'\t' read -r SRC_RAW TGT_RAW; do
        local SRC TGT
        SRC="$(make_absolute_source "${SRC_RAW}")"
        TGT="$(resolve_variables "${TGT_RAW}")"

        if [[ ! -e "${SRC}" ]]; then
            warn "Source missing: ${DIM}${SRC}${OFF} — skipping"
            continue
        fi

        ensure_parent_dir "${TGT}"

        if [[ "${DRYRUN}" -eq 1 ]]; then
            msg "${DIM}DRY-RUN:${OFF} ln -sfn ${BLU}${SRC}${OFF} ${BOLD}${TGT}${OFF}"
        else
            backup_if_exists "${TGT}"
            ln -sfn "${SRC}" "${TGT}"
            ok "Linked: ${BOLD}${TGT}${OFF} ${DIM}->${OFF} ${BLU}${SRC}${OFF}"
        fi
    done

    if [[ "${DRYRUN}" -eq 0 ]]; then
        if command -v bat >/dev/null 2>&1; then
            bat cache --build >/dev/null 2>&1 || true
        fi
        # shellcheck disable=SC2015
        command -v fisher >/dev/null 2>&1 && fisher update >/dev/null 2>&1 || true
    fi
}

do_unlink() {
    read_mappings | while IFS=$'\t' read -r _ TGT_RAW; do
        local TGT
        TGT="$(resolve_variables "${TGT_RAW}")"

        if [[ -L "${TGT}" ]]; then
            if [[ "${DRYRUN}" -eq 1 ]]; then
                msg "${DIM}DRY-RUN:${OFF} rm ${BOLD}${TGT}${OFF}"
            else
                rm "${TGT}"
                ok "Removed symlink: ${BOLD}${TGT}${OFF}"
            fi
        else
            warn "No symlink: ${BOLD}${TGT}${OFF}"
        fi
    done
}

do_status() {
    read_mappings | while IFS=$'\t' read -r SRC_RAW TGT_RAW; do
        local SRC TGT
        SRC="$(make_absolute_source "${SRC_RAW}")"
        TGT="$(resolve_variables "${TGT_RAW}")"

        if [[ -L "${TGT}" ]] && [[ ! -e "${TGT}" ]]; then
            echo -e "${RED}💀${OFF} ${BOLD}${TGT}${OFF} ${DIM}->${OFF} ${RED}BROKEN LINK${OFF} ${DIM}(source missing: ${SRC})${OFF}"
            continue
        fi

        if [[ -L "${TGT}" ]]; then
            local points
            points="$(readlink "${TGT}")"

            case "${points}" in
                /*) ;;
                *) points="$(cd "$(dirname "${TGT}")" && pwd)/${points}";;
            esac

            local cpoints cexpected
            cpoints="$(canonical "${points}")"
            cexpected="$(canonical "${SRC}")"

            if [[ -n "${cexpected}" ]] && [[ -n "${cpoints}" ]] && [[ "${cpoints}" = "${cexpected}" ]]; then
                echo -e "${GRN}✓${OFF} ${BOLD}${TGT}${OFF} ${DIM}->${OFF} ${BLU}${SRC}${OFF}"
            else
                echo -e "${RED}✗${OFF} ${BOLD}${TGT}${OFF} ${DIM}->${OFF} ${YLW}${points}${OFF} ${RED}(expected ${SRC})${OFF}"
            fi
        elif [[ -e "${TGT}" ]]; then
            echo -e "${YLW}⚠${OFF} ${BOLD}${TGT}${OFF} ${DIM}— regular file/folder, not symlink${OFF}"
        else
            echo -e "${DIM}–${OFF} ${BOLD}${TGT}${OFF} ${DIM}— missing${OFF}"
        fi
    done
}

do_doctor() {
    local ok_all=1

    echo "${BOLD}Running environment checks...${OFF}"
    echo ""

    if command -v git >/dev/null 2>&1; then
        ok "${GRN}✓${OFF} git found in PATH"
    else
        err "${RED}✗${OFF} git not found in PATH"
        ok_all=0
    fi

    if command -v jq >/dev/null 2>&1; then
        ok "${GRN}✓${OFF} jq found in PATH"
    else
        err "${RED}✗${OFF} jq not found in PATH"
        ok_all=0
    fi

    if [[ -d "${REPO_ROOT}/.git" ]]; then
        ok "${GRN}✓${OFF} Git repository: ${BLU}${REPO_ROOT}${OFF}"
    else
        err "${RED}✗${OFF} Not a git repository: ${REPO_ROOT}"
        ok_all=0
    fi

    if [[ -f "${CONF_JSON}" ]]; then
        if jq empty "${CONF_JSON}" 2>/dev/null; then
            ok "${GRN}✓${OFF} JSON config valid: ${BLU}${CONF_JSON}${OFF}"
        else
            err "${RED}✗${OFF} Invalid JSON in ${CONF_JSON}"
            ok_all=0
        fi
    else
        err "${RED}✗${OFF} JSON config not found: ${CONF_JSON}"
        ok_all=0
    fi

    echo ""
    if [[ "${ok_all}" -eq 1 ]]; then
        ok "${GRN}All checks passed!${OFF}"
    else
        err "${RED}Some checks failed${OFF}"
        exit 1
    fi
}

# Systemd commands
services_enable_all() {
    if [[ ! -d "${SYSTEMD_DIR}" ]]; then
        err "Systemd user directory not found: ${SYSTEMD_DIR}"
        exit 1
    fi

    ok "Enabling all services and timers..."
    systemctl --user daemon-reload

    find "${SYSTEMD_DIR}" -type f \( -name "*.service" -o -name "*.timer" \) | while read -r file; do
        local service
        service="$(basename "${file}")"

        if systemctl --user enable "${service}" 2>/dev/null; then
            systemctl --user start "${service}" 2>/dev/null || true
            ok "✓ Enabled: ${service}"
        else
            warn "⚠ Failed to enable: ${service}"
        fi
    done

    echo ""
    ok "All services enabled!"
}

services_disable_all() {
    if [[ ! -d "${SYSTEMD_DIR}" ]]; then
        err "Systemd user directory not found: ${SYSTEMD_DIR}"
        exit 1
    fi

    ok "Disabling all services and timers..."

    find "${SYSTEMD_DIR}" -type f \( -name "*.service" -o -name "*.timer" \) | while read -r file; do
        local service
        service="$(basename "${file}")"

        systemctl --user stop "${service}" 2>/dev/null || true
        if systemctl --user disable "${service}" 2>/dev/null; then
            ok "✓ Disabled: ${service}"
        else
            warn "⚠ Failed to disable: ${service}"
        fi
    done

    echo ""
    ok "All services disabled!"
}

services_status() {
    if [[ ! -d "${SYSTEMD_DIR}" ]]; then
        err "Systemd user directory not found: ${SYSTEMD_DIR}"
        exit 1
    fi

    ok "Services status:"
    echo ""

    find "${SYSTEMD_DIR}" -type f \( -name "*.service" -o -name "*.timer" \) | sort | while read -r file; do
        local service
        service="$(basename "${file}")"

        local state
        state="$(systemctl --user is-enabled "${service}" 2>/dev/null || echo "disabled")"
        local active
        active="$(systemctl --user is-active "${service}" 2>/dev/null || echo "inactive")"

        local status_icon
        if [[ "${active}" = "active" ]]; then
            status_icon="${GRN}●${OFF}"
        elif [[ "${active}" = "inactive" ]] && [[ "${state}" = "enabled" ]]; then
            status_icon="${YLW}●${OFF}"
        else
            status_icon="${DIM}○${OFF}"
        fi

        printf "%s ${BOLD}%-40s${OFF} %s / %s\n" "${status_icon}" "${service}" "${state}" "${active}"
    done
}

services_list() {
    if [[ ! -d "${SYSTEMD_DIR}" ]]; then
        err "Systemd user directory not found: ${SYSTEMD_DIR}"
        exit 1
    fi

    ok "Services available in dotfiles:"
    echo ""
    find "${SYSTEMD_DIR}" -type f \( -name "*.service" -o -name "*.timer" \) | while read -r file; do
        basename "${file}"
    done | sort
}

# Setup command - bootstrap dotfiles on new system
do_setup() {
    cat <<EOF
${BOLD}╔═══════════════════════════════════════════════════════════╗
║           Workstation Dotfiles Bootstrap                  ║
╚═══════════════════════════════════════════════════════════╝${OFF}

This will:
  1. Check if running on Arch Linux
  2. Install Ansible (if needed)
  3. Run Ansible playbooks to provision system
  4. Create symlinks for dotfiles
  5. Enable systemd user services

EOF

    # Confirmation
    read -rp "${YLW}Continue? [y/N]${OFF} " confirm
    if [[ ! "${confirm}" =~ ^[Yy]$ ]]; then
        warn "Setup cancelled"
        exit 0
    fi

    echo ""
    ok "Starting bootstrap..."
    echo ""

    # Check if on Arch Linux
    if ! command -v pacman >/dev/null 2>&1; then
        err "This script is designed for Arch Linux"
        err "Please install dependencies manually"
        exit 1
    fi

    # Install Ansible if not present
    if ! command -v ansible-playbook >/dev/null 2>&1; then
        ok "Installing Ansible..."
        sudo pacman -S --needed --noconfirm ansible
    else
        ok "✓ Ansible already installed"
    fi

    # Install aur helper
    if ! ansible-galaxy collection list | grep -q '^kewlfft.aur '; then
        ok "Installing kewlfft.aur Ansible collection..."
        ansible-galaxy collection install kewlfft.aur
    else
        ok "✓ kewlfft.aur collection already installed"
    fi

    # Run Ansible playbooks
    ok "Running Ansible playbooks..."
    echo ""

    if [[ -f "${REPO_ROOT}/ansible/main.yml" ]]; then
        cd "${REPO_ROOT}"
        ansible-playbook ansible/main.yml --ask-become-pass
    else
        err "Ansible playbook not found: ${REPO_ROOT}/ansible/main.yml"
        exit 1
    fi

    echo ""
    ok "Ansible provisioning complete"
    echo ""

    # Enable systemd services
    ok "Setting up systemd services..."
    services_enable_all

    echo ""
    cat <<EOF
${GRN}╔═══════════════════════════════════════════════════════════╗
║                  Bootstrap Complete! 🎉                   ║
╚═══════════════════════════════════════════════════════════╝${OFF}

${BOLD}Next steps:${OFF}
  1. Logout and login again for changes to take effect
  2. Run ${BLU}workstation dotfiles doctor${OFF} to verify setup
  3. Check ${BLU}workstation dotfiles status${OFF} for symlink status
  4. View services with ${BLU}workstation services status${OFF}

${DIM}For help: workstation --help${OFF}
EOF
}

# Update command - pull changes from git and reapply configuration
do_update() {
    cat <<EOF
${BOLD}╔═══════════════════════════════════════════════════════════╗
║         Workstation Dotfiles Update from Git              ║
╚═══════════════════════════════════════════════════════════╝${OFF}

This will:
  1. Stop and disable all systemd services
  2. Remove existing symlinks
  3. Pull latest changes from git
  4. Recreate symlinks
  5. Enable and start services again

EOF

    # Check if in git repo
    if [[ ! -d "${REPO_ROOT}/.git" ]]; then
        err "Not a git repository: ${REPO_ROOT}"
        exit 1
    fi

    # Check for uncommitted changes
    cd "${REPO_ROOT}"
    if ! git diff-index --quiet HEAD -- 2>/dev/null; then
        warn "You have uncommitted changes in the repository"
        warn "These changes might be lost during update"
        echo ""
        git status --short
        echo ""
        read -rp "${YLW}Continue anyway? [y/N]${OFF} " confirm
        if [[ ! "${confirm}" =~ ^[Yy]$ ]]; then
            warn "Update cancelled"
            exit 0
        fi
    fi

    if [[ "${DRYRUN}" -eq 1 ]]; then
        msg "${DIM}DRY-RUN MODE: No changes will be made${OFF}"
        echo ""
    else
        # Confirmation
        read -rp "${YLW}Continue with update? [y/N]${OFF} " confirm
        if [[ ! "${confirm}" =~ ^[Yy]$ ]]; then
            warn "Update cancelled"
            exit 0
        fi
    fi

    echo ""
    ok "Starting update process..."
    echo ""

    # Step 1: Disable services
    if [[ "${DRYRUN}" -eq 1 ]]; then
        msg "${DIM}[1/5]${OFF} Would stop and disable all services"
    else
        ok "${BOLD}[1/5]${OFF} Stopping and disabling services..."
        services_disable_all
    fi
    echo ""

    # Step 2: Unlink dotfiles
    if [[ "${DRYRUN}" -eq 1 ]]; then
        msg "${DIM}[2/5]${OFF} Would remove symlinks"
        DRYRUN=1 do_unlink
    else
        ok "${BOLD}[2/5]${OFF} Removing symlinks..."
        do_unlink
    fi
    echo ""

    # Step 3: Git pull
    if [[ "${DRYRUN}" -eq 1 ]]; then
        msg "${DIM}[3/5]${OFF} Would pull from git (currently on branch: $(git branch --show-current))"
        msg "${DIM}      Remote commits:${OFF}"
        git log 'HEAD..@{u}' --oneline 2>/dev/null || msg "${DIM}      (no remote changes)${OFF}"
    else
        ok "${BOLD}[3/5]${OFF} Pulling latest changes from git..."
        local current_branch
        current_branch="$(git branch --show-current)"

        if ! git pull --rebase origin "${current_branch}"; then
            err "Git pull failed!"
            err "Please resolve conflicts manually and run update again"
            exit 1
        fi

        ok "Successfully pulled changes from ${BLU}${current_branch}${OFF}"
    fi
    echo ""

    # Step 4: Relink dotfiles
    if [[ "${DRYRUN}" -eq 1 ]]; then
        msg "${DIM}[4/5]${OFF} Would create symlinks"
        DRYRUN=1 do_link
    else
        ok "${BOLD}[4/5]${OFF} Creating symlinks..."
        do_link
    fi
    echo ""

    # Step 5: Enable services
    if [[ "${DRYRUN}" -eq 1 ]]; then
        msg "${DIM}[5/5]${OFF} Would enable and start all services"
    else
        ok "${BOLD}[5/5]${OFF} Enabling and starting services..."
        services_enable_all
    fi
    echo ""

    if [[ "${DRYRUN}" -eq 1 ]]; then
        cat <<EOF
${YLW}╔═══════════════════════════════════════════════════════════╗
║             Dry-run Complete (no changes made)            ║
╚═══════════════════════════════════════════════════════════╝${OFF}

Run ${BLU}workstation update${OFF} without -n to apply changes.
EOF
    else
        cat <<EOF
${GRN}╔═══════════════════════════════════════════════════════════╗
║                Update Complete! 🎉                        ║
╚═══════════════════════════════════════════════════════════╝${OFF}

${BOLD}Your dotfiles are now up to date!${OFF}

${DIM}Check status:${OFF}
  • ${BLU}workstation dotfiles status${OFF}  - verify symlinks
  • ${BLU}workstation services status${OFF}  - check services

${DIM}Recent changes:${OFF}
EOF
        git log -5 --oneline --decorate
    fi
}


# Main command router
cmd="${1:-}"
shift || true

case "${cmd}" in
    # Setup command
    setup)
        do_setup
        ;;

    # Update command
    update)
        parse_args "$@"
        do_update
        ;;

    # Dotfiles commands
    dotfiles)
        subcmd="${1:-}"
        shift || true
        parse_args "$@"
        case "${subcmd}" in
            link) do_link ;;
            unlink) do_unlink ;;
            status) do_status ;;
            doctor) do_doctor ;;
            which)
                echo -e "${BOLD}Repository:${OFF} ${BLU}${REPO_ROOT}${OFF}"
                echo -e "${BOLD}Config JSON:${OFF} ${BLU}${CONF_JSON}${OFF}"
                ;;
            edit)
                ${EDITOR:-vi} "${CONF_JSON}"
                ;;
            *)
                err "Unknown dotfiles command: ${subcmd}"
                usage
                exit 1
                ;;
        esac
        ;;

    # Services commands
    services)
        subcmd="${1:-}"
        shift || true
        case "${subcmd}" in
            enable-all)
                services_enable_all
                ;;
            disable-all)
                services_disable_all
                ;;
            status)
                services_status
                ;;
            list)
                services_list
                ;;
            *)
                err "Unknown services command: ${subcmd}"
                usage
                exit 1
                ;;
        esac
        ;;

    help|-h|--help|"")
        usage
        ;;

    *)
        err "Unknown command: ${cmd}"
        usage
        exit 1
        ;;
esac
