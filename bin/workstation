#!/usr/bin/env bash
set -euo pipefail

# Resolve the real path of the script (following symlinks)
SCRIPT_PATH="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT_PATH" ]; do
    SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
    SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
    [[ $SCRIPT_PATH != /* ]] && SCRIPT_PATH="$SCRIPT_DIR/$SCRIPT_PATH"
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

CONF_JSON_DEFAULT="${REPO_ROOT}/dotfiles.json"
CONF_JSON="${DOTFILES_JSON:-${CONF_JSON_DEFAULT}}"
BACKUP_DIR="${HOME}/.local/share/dotfiles/backups"
SYSTEMD_DIR="${REPO_ROOT}/systemd/user"
LOG_PREFIX="[workstation]"

if [ -t 1 ]; then
    BOLD="$(printf '\033[1m')";
    DIM="$(printf '\033[2m')";
    RED="$(printf '\033[31m')"
    GRN="$(printf '\033[32m')";
    YLW="$(printf '\033[33m')";
    BLU="$(printf '\033[34m')";
    OFF="$(printf '\033[0m')"
else
    BOLD="";
    DIM="";
    RED="";
    GRN="";
    YLW="";
    BLU="";
    OFF=""
fi

usage() {
    cat <<EOF
${BOLD}workstation${OFF} — unified dotfiles and systemd services management.

${BOLD}Usage:${OFF}
    workstation <command> [options]

${BOLD}Dotfiles Commands:${OFF}
    link [-n] [--json PATH]       Create/update symlinks
    unlink [-n] [--json PATH]     Remove symlinks
    status [--json PATH]          Show link status
    doctor [--json PATH]          Environment checks
    which [--json PATH]           Show repo and config paths
    edit [--json PATH]            Open config in \$EDITOR

${BOLD}Systemd Commands:${OFF}
    service enable <name>         Enable and start a service/timer
    service disable <name>        Disable and stop a service/timer
    service restart <name>        Restart a service
    service status <name>         Show status of a service
    service list                  List all services in dotfiles
    service reload                Reload systemd user daemon
    timers [list]                 Show active timers
    timers setup                  Setup health & productivity timers

${BOLD}Global Options:${OFF}
    -n            Dry-run mode (don't make changes)
    --json PATH   Path to dotfiles.json (default: ${CONF_JSON_DEFAULT})
    -h, --help    Show this help

${BOLD}Examples:${OFF}
    workstation link -n                    # Dry-run symlinks
    workstation status                     # Check link status
    workstation service enable batsignal.service
    workstation timers                     # Show active timers
    workstation doctor                     # Run environment checks
EOF
}

msg() { echo -e "${LOG_PREFIX} $*"; }
ok()  { echo -e "${GRN}${LOG_PREFIX}${OFF} $*"; }
warn(){ echo -e "${YLW}${LOG_PREFIX}${OFF} $*"; }
err() { echo -e "${RED}${LOG_PREFIX}${OFF} $*" >&2; }

parse_args() {
    DRYRUN=0

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --json)
                CONF_JSON="${2:-}"
                shift 2
                ;;
            --json=*)
                CONF_JSON="${1#--json=}"
                shift
                ;;
            -n)
                DRYRUN=1
                shift
                ;;
            *)
                shift
                ;;
        esac
    done
}

require_json() {
    if [ ! -f "${CONF_JSON}" ]; then
        err "JSON config not found: ${CONF_JSON}"
        exit 1
    fi

    if ! command -v jq >/dev/null 2>&1; then
        err "jq is required but not installed"
        exit 1
    fi
}

timestamp() { date +"%Y%m%d-%H%M%S"; }

resolve_variables() {
    local path="$1"
    path="${path//\$HOME/$HOME}"
    path="${path/#\~/$HOME}"
    echo "$path"
}

read_mappings() {
    require_json
    jq -r '.mappings[] | "\(.source)\t\(.target)"' "${CONF_JSON}"
}

ensure_parent_dir() {
    local path="$1"
    local dir
    dir="$(dirname "$path")"
    mkdir -p "$dir"
}

backup_if_exists() {
    local target="$1"
    if [ -e "${target}" ] && [ ! -L "${target}" ]; then
        mkdir -p "${BACKUP_DIR}"
        local ts base dest
        ts="$(timestamp)"
        base="$(basename "${target}")"
        dest="${BACKUP_DIR}/${base}.${ts}.bak"
        mv "${target}" "${dest}"
        ok "Backup ${target} -> ${dest}"
    fi
}

canonical() {
    if command -v realpath >/dev/null 2>&1; then
        realpath "$1" 2>/dev/null || echo "$1"
    else
        echo "$1"
    fi
}

make_absolute_source() {
    local src="$1"
    if [[ "$src" =~ ^/ ]]; then
        echo "$src"
    else
        echo "${REPO_ROOT}/${src}"
    fi
}

# Dotfiles commands
do_link() {
    read_mappings | while IFS=$'\t' read -r SRC_RAW TGT_RAW; do
        local SRC TGT
        SRC="$(make_absolute_source "$SRC_RAW")"
        TGT="$(resolve_variables "$TGT_RAW")"

        if [ ! -e "${SRC}" ]; then
            warn "Source missing: ${SRC} — skipping"
            continue
        fi

        ensure_parent_dir "${TGT}"

        if [ "${DRYRUN}" -eq 1 ]; then
            msg "DRY-RUN: ln -sfn ${SRC} ${TGT}"
        else
            backup_if_exists "${TGT}"
            ln -sfn "${SRC}" "${TGT}"
            ok "Linked: ${TGT} -> ${SRC}"
        fi
    done

    if [ "${DRYRUN}" -eq 0 ]; then
        if command -v bat >/dev/null 2>&1; then
            bat cache --build >/dev/null 2>&1 || true
        fi
        command -v fisher >/dev/null 2>&1 && fisher update >/dev/null 2>&1 || true
    fi
}

do_unlink() {
    read_mappings | while IFS=$'\t' read -r _ TGT_RAW; do
        local TGT
        TGT="$(resolve_variables "$TGT_RAW")"

        if [ -L "${TGT}" ]; then
            if [ "${DRYRUN}" -eq 1 ]; then
                msg "DRY-RUN: rm ${TGT}"
            else
                rm "${TGT}"
                ok "Removed symlink: ${TGT}"
            fi
        else
            warn "No symlink: ${TGT}"
        fi
    done
}

do_status() {
    read_mappings | while IFS=$'\t' read -r SRC_RAW TGT_RAW; do
        local SRC TGT
        SRC="$(make_absolute_source "$SRC_RAW")"
        TGT="$(resolve_variables "$TGT_RAW")"

        if [ -L "${TGT}" ]; then
            local points
            points="$(readlink "${TGT}")"

            case "$points" in
                /*) ;;
                *) points="$(cd "$(dirname "${TGT}")" && pwd)/${points}";;
            esac

            local cpoints cexpected
            cpoints="$(canonical "$points")"
            cexpected="$(canonical "$SRC")"

            if [ -n "$cexpected" ] && [ -n "$cpoints" ] && [ "$cpoints" = "$cexpected" ]; then
                echo -e "✓ ${TGT} ${DIM}->${OFF} ${SRC}"
            else
                echo -e "✗ ${TGT} ${DIM}->${OFF} ${points} ${RED}(expected ${SRC})${OFF}"
            fi
        elif [ -e "${TGT}" ]; then
            echo -e "⚠ ${TGT} — regular file/folder, not symlink"
        else
            echo -e "– ${TGT} — missing"
        fi
    done
}

do_doctor() {
    local ok_all=1

    command -v git >/dev/null || { err "git not found in PATH"; ok_all=0; }
    command -v jq >/dev/null || { err "jq not found in PATH"; ok_all=0; }
    [ -d "${REPO_ROOT}/.git" ] || { err "Not a git repository: ${REPO_ROOT}"; ok_all=0; }

    if [ -f "${CONF_JSON}" ]; then
        if ! jq empty "${CONF_JSON}" 2>/dev/null; then
            err "Invalid JSON in ${CONF_JSON}"
            ok_all=0
        fi
    else
        err "JSON config not found: ${CONF_JSON}"
        ok_all=0
    fi

    if [ "${ok_all}" -eq 1 ]; then
        ok "All checks passed"
    else
        exit 1
    fi
}

# Systemd commands
service_enable() {
    local service="$1"
    ok "Enabling and starting ${service}..."
    systemctl --user daemon-reload
    systemctl --user enable "$service"
    systemctl --user start "$service" 2>/dev/null || true
    ok "✓ ${service} enabled"
}

service_disable() {
    local service="$1"
    ok "Disabling ${service}..."
    systemctl --user stop "$service" 2>/dev/null || true
    systemctl --user disable "$service" 2>/dev/null || true
    ok "✓ ${service} disabled"
}

service_restart() {
    local service="$1"
    ok "Restarting ${service}..."
    systemctl --user restart "$service"
    ok "✓ ${service} restarted"
}

service_status() {
    local service="$1"
    systemctl --user status "$service"
}

service_list() {
    if [ ! -d "${SYSTEMD_DIR}" ]; then
        err "Systemd user directory not found: ${SYSTEMD_DIR}"
        exit 1
    fi

    ok "Services available in dotfiles:"
    echo ""
    find "$SYSTEMD_DIR" -type f \( -name "*.service" -o -name "*.timer" \) | while read -r file; do
        basename "$file"
    done | sort
}

service_reload() {
    ok "Reloading systemd user daemon..."
    systemctl --user daemon-reload
    ok "✓ Daemon reloaded"
}

timers_list() {
    ok "Active timers:"
    echo ""
    systemctl --user list-timers
}

timers_setup() {
    ok "Setting up health & productivity timers..."
    echo ""

    local TIMERS=(
        "break-reminder.timer"
        "water-reminder.timer"
        "posture-check.timer"
    )

    ok "Enabling timers..."
    systemctl --user daemon-reload

    for timer in "${TIMERS[@]}"; do
        if systemctl --user enable "$timer" 2>/dev/null; then
            systemctl --user start "$timer" 2>/dev/null || true
            ok "✓ Started: ${timer}"
        else
            warn "⚠ Failed to enable: ${timer}"
        fi
    done

    echo ""
    ok "All timers configured!"
    echo ""
    msg "Check status with: workstation timers"
    msg "Disable a timer with: systemctl --user disable --now <timer-name>"
}

# Main command router
cmd="${1:-}"
shift || true

case "${cmd}" in
    # Dotfiles commands
    link|unlink|status|doctor)
        parse_args "$@"
        case "${cmd}" in
            link) do_link ;;
            unlink) do_unlink ;;
            status) do_status ;;
            doctor) do_doctor ;;
        esac
        ;;

    which)
        parse_args "$@"
        echo -e "REPO: ${REPO_ROOT}\nJSON: ${CONF_JSON}"
        ;;

    edit)
        parse_args "$@"
        ${EDITOR:-vi} "${CONF_JSON}"
        ;;

    # Systemd commands
    service)
        subcmd="${1:-}"
        shift || true
        case "${subcmd}" in
            enable)
                [ -z "${1:-}" ] && { err "Please specify a service name"; exit 1; }
                service_enable "$1"
                ;;
            disable)
                [ -z "${1:-}" ] && { err "Please specify a service name"; exit 1; }
                service_disable "$1"
                ;;
            restart)
                [ -z "${1:-}" ] && { err "Please specify a service name"; exit 1; }
                service_restart "$1"
                ;;
            status)
                [ -z "${1:-}" ] && { err "Please specify a service name"; exit 1; }
                service_status "$1"
                ;;
            list)
                service_list
                ;;
            reload)
                service_reload
                ;;
            *)
                err "Unknown service command: ${subcmd}"
                usage
                exit 1
                ;;
        esac
        ;;

    timers)
        subcmd="${1:-list}"
        case "${subcmd}" in
            list) timers_list ;;
            setup) timers_setup ;;
            *)
                err "Unknown timers command: ${subcmd}"
                usage
                exit 1
                ;;
        esac
        ;;

    help|-h|--help|"")
        usage
        ;;

    *)
        err "Unknown command: ${cmd}"
        usage
        exit 1
        ;;
esac
