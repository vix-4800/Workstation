#!/usr/bin/env bash
set -euo pipefail

# Resolve the real path of the script (following symlinks)
SCRIPT_PATH="${BASH_SOURCE[0]}"
while [[ -L "${SCRIPT_PATH}" ]]; do
    SCRIPT_DIR="$(cd "$(dirname "${SCRIPT_PATH}")" && pwd)"
    SCRIPT_PATH="$(readlink "${SCRIPT_PATH}")"
    [[ ${SCRIPT_PATH} != /* ]] && SCRIPT_PATH="${SCRIPT_DIR}/${SCRIPT_PATH}"
done
SCRIPT_DIR="$(cd "$(dirname "${SCRIPT_PATH}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

CONF_JSON_DEFAULT="${REPO_ROOT}/dotfiles.json"
CONF_JSON="${DOTFILES_JSON:-${CONF_JSON_DEFAULT}}"
BACKUP_DIR="${HOME}/.local/share/dotfiles/backups"
SYSTEMD_DIR="${REPO_ROOT}/systemd/user"
LOG_PREFIX="[workstation]"

if [[ -t 1 ]]; then
    BOLD="$(printf '\033[1m')";
    DIM="$(printf '\033[2m')";
    RED="$(printf '\033[31m')"
    GRN="$(printf '\033[32m')";
    YLW="$(printf '\033[33m')";
    BLU="$(printf '\033[34m')";
    OFF="$(printf '\033[0m')"
else
    BOLD="";
    DIM="";
    RED="";
    GRN="";
    YLW="";
    BLU="";
    OFF=""
fi

usage() {
    cat <<EOF
${BOLD}workstation${OFF} — unified dotfiles and systemd services management.

${BOLD}Usage:${OFF}
    workstation <command> [options]

${BOLD}Setup Commands:${OFF}
    setup                         Bootstrap dotfiles on a new system

${BOLD}Dotfiles Commands:${OFF}
    dotfiles link [-n] [--json PATH]      Create/update symlinks
    dotfiles unlink [-n] [--json PATH]    Remove symlinks
    dotfiles status [--json PATH]         Show link status
    dotfiles doctor [--json PATH]         Environment and schema checks
    dotfiles which [--json PATH]          Show repo and config paths
    dotfiles edit [--json PATH]           Open config in \$EDITOR

${BOLD}Services Commands:${OFF}
    services enable-all           Enable and start all services/timers
    services disable-all          Disable and stop all services/timers
    services status               Show status of all services/timers
    services list                 List all services in dotfiles

${BOLD}Global Options:${OFF}
    -n            Dry-run mode (don't make changes)
    --json PATH   Path to dotfiles.json (default: ${CONF_JSON_DEFAULT})
    -h, --help    Show this help

${BOLD}Examples:${OFF}
    workstation setup                      # Bootstrap new system
    workstation dotfiles link -n           # Dry-run symlinks
    workstation dotfiles status            # Check link status
    workstation dotfiles doctor            # Run environment checks
    workstation services enable-all        # Enable all services
    workstation services status            # Show services status
EOF
}

msg() { echo -e "${LOG_PREFIX} $*"; }
ok()  { echo -e "${GRN}${LOG_PREFIX}${OFF} $*"; }
warn(){ echo -e "${YLW}${LOG_PREFIX}${OFF} $*"; }
err() { echo -e "${RED}${LOG_PREFIX}${OFF} $*" >&2; }

parse_args() {
    DRYRUN=0

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --json)
                CONF_JSON="${2:-}"
                shift 2
                ;;
            --json=*)
                CONF_JSON="${1#--json=}"
                shift
                ;;
            -n)
                DRYRUN=1
                shift
                ;;
            *)
                shift
                ;;
        esac
    done
}

require_json() {
    if [[ ! -f "${CONF_JSON}" ]]; then
        err "JSON config not found: ${CONF_JSON}"
        exit 1
    fi

    if ! command -v jq >/dev/null 2>&1; then
        err "jq is required but not installed"
        exit 1
    fi
}

validate_json_schema() {
    local schema_path="${REPO_ROOT}/dotfiles.schema.json"

    if [[ ! -f "${schema_path}" ]]; then
        err "JSON schema not found: ${schema_path}"
        return 1
    fi

    if ! command -v python3 >/dev/null 2>&1; then
        err "python3 is required for schema validation"
        return 1
    fi

    python3 - "${CONF_JSON}" "${schema_path}" <<'PY'
import json
import sys


class ValidationError(Exception):
    pass


def validate(value, schema, path="$"):
    if "oneOf" in schema:
        matched = 0
        for candidate in schema["oneOf"]:
            try:
                validate(value, candidate, path)
            except ValidationError:
                continue
            matched += 1
        if matched != 1:
            raise ValidationError(f"{path}: expected exactly one matching schema, got {matched}")

    if "not" in schema:
        try:
            validate(value, schema["not"], path)
        except ValidationError:
            pass
        else:
            raise ValidationError(f"{path}: matched a forbidden schema")

    if "enum" in schema and value not in schema["enum"]:
        allowed = ", ".join(repr(item) for item in schema["enum"])
        raise ValidationError(f"{path}: expected one of {allowed}, got {value!r}")

    expected_type = schema.get("type")
    if expected_type == "object" and not isinstance(value, dict):
        raise ValidationError(f"{path}: expected object, got {type(value).__name__}")
    if expected_type == "array" and not isinstance(value, list):
        raise ValidationError(f"{path}: expected array, got {type(value).__name__}")
    if expected_type == "string" and not isinstance(value, str):
        raise ValidationError(f"{path}: expected string, got {type(value).__name__}")
    if expected_type == "boolean" and not isinstance(value, bool):
        raise ValidationError(f"{path}: expected boolean, got {type(value).__name__}")

    if isinstance(value, dict):
        properties = schema.get("properties", {})
        for key in schema.get("required", []):
            if key not in value:
                raise ValidationError(f"{path}: missing required property {key!r}")

        if schema.get("additionalProperties") is False:
            extra_keys = sorted(set(value) - set(properties))
            if extra_keys:
                raise ValidationError(f"{path}: unexpected properties {extra_keys!r}")

        for key, subschema in properties.items():
            if key in value:
                validate(value[key], subschema, f"{path}.{key}")

    if isinstance(value, list):
        min_items = schema.get("minItems")
        if min_items is not None and len(value) < min_items:
            raise ValidationError(f"{path}: expected at least {min_items} item(s), got {len(value)}")

        item_schema = schema.get("items")
        if item_schema is not None:
            for index, item in enumerate(value):
                validate(item, item_schema, f"{path}[{index}]")


config_path, schema_path = sys.argv[1], sys.argv[2]

with open(config_path, "r", encoding="utf-8") as config_handle:
    config = json.load(config_handle)

with open(schema_path, "r", encoding="utf-8") as schema_handle:
    schema = json.load(schema_handle)

try:
    validate(config, schema)
except ValidationError as error:
    print(error, file=sys.stderr)
    sys.exit(1)
PY
}

timestamp() { date +"%Y%m%d-%H%M%S"; }

resolve_variables() {
    local path="$1"
    path="${path//\$HOME/${HOME}}"
    path="${path/#\~/${HOME}}"
    echo "${path}"
}

read_mappings() {
    require_json
    jq -r '
        .mappings[]
        | if has("target") then
            . as $mapping
            | (
                if (.target | type) == "array" then
                    .target[]
                else
                    .target
                end
            ) as $target
            | "\($mapping.source)\t\($target)\t\($mapping.sudo // false)\t\($mapping.action // "")"
        else
            "\(.source)\t__NONE__\t\(.sudo // false)\t\(.action // "")"
        end
    ' "${CONF_JSON}"
}

maybe_sudo() {
    local needs_sudo="$1"
    shift
    if [[ "${needs_sudo}" == "true" ]]; then
        sudo "$@"
    else
        "$@"
    fi
}

ensure_parent_dir() {
    local path="$1"
    local needs_sudo="${2:-false}"
    local dir
    dir="$(dirname "${path}")"
    maybe_sudo "${needs_sudo}" mkdir -p "${dir}"
}

backup_if_exists() {
    local target="$1"
    local needs_sudo="${2:-false}"
    if maybe_sudo "${needs_sudo}" test -e "${target}" && ! maybe_sudo "${needs_sudo}" test -L "${target}"; then
        mkdir -p "${BACKUP_DIR}"
        local ts base dest
        ts="$(timestamp)"
        base="$(basename "${target}")"
        dest="${BACKUP_DIR}/${base}.${ts}.bak"
        maybe_sudo "${needs_sudo}" mv "${target}" "${dest}"
        ok "Backup ${BOLD}${target}${OFF} ${DIM}->${OFF} ${BLU}${dest}${OFF}"
    fi
}

canonical() {
    if command -v realpath >/dev/null 2>&1; then
        realpath "$1" 2>/dev/null || echo "$1"
    else
        echo "$1"
    fi
}

is_git_repo() {
    git -C "${REPO_ROOT}" rev-parse --is-inside-work-tree >/dev/null 2>&1
}

make_absolute_source() {
    local src="$1"
    if [[ "${src}" =~ ^/ ]]; then
        echo "${src}"
    else
        echo "${REPO_ROOT}/${src}"
    fi
}

# Returns the NM connection name derived from a wg-quick config file path
# (e.g. /repo/wireguard/wg0.conf -> wg0)
nmcli_conn_name() {
    local src="$1"
    basename "${src}" .conf
}

# Dotfiles commands
do_link() {
    read_mappings | while IFS=$'\t' read -r SRC_RAW TGT_RAW NEEDS_SUDO ACTION; do
        local SRC
        SRC="$(make_absolute_source "${SRC_RAW}")"

        if [[ ! -e "${SRC}" ]]; then
            warn "Source missing: ${DIM}${SRC}${OFF} — skipping"
            continue
        fi

        if [[ "${ACTION}" == "nmcli-import" ]]; then
            local conn_name
            conn_name="$(nmcli_conn_name "${SRC}")"
            if [[ "${DRYRUN}" -eq 1 ]]; then
                msg "${DIM}DRY-RUN:${OFF} sudo nmcli connection import type wireguard file ${BLU}${SRC}${OFF}"
            else
                # Delete existing connection with the same name to allow re-import
                sudo nmcli connection delete "${conn_name}" 2>/dev/null || true
                sudo nmcli connection import type wireguard file "${SRC}"
                ok "Imported: ${BOLD}${conn_name}${OFF} ${DIM}(${SRC})${OFF}"
            fi
            continue
        fi

        local TGT
        TGT="$(resolve_variables "${TGT_RAW}")"
        ensure_parent_dir "${TGT}" "${NEEDS_SUDO}"

        if [[ "${DRYRUN}" -eq 1 ]]; then
            local prefix=""
            [[ "${NEEDS_SUDO}" == "true" ]] && prefix="sudo "
            msg "${DIM}DRY-RUN:${OFF} ${prefix}ln -sfn ${BLU}${SRC}${OFF} ${BOLD}${TGT}${OFF}"
        else
            backup_if_exists "${TGT}" "${NEEDS_SUDO}"
            maybe_sudo "${NEEDS_SUDO}" ln -sfn "${SRC}" "${TGT}"
            ok "Linked: ${BOLD}${TGT}${OFF} ${DIM}->${OFF} ${BLU}${SRC}${OFF}"
        fi
    done

    if [[ "${DRYRUN}" -eq 0 ]]; then
        if command -v bat >/dev/null 2>&1; then
            bat cache --build >/dev/null 2>&1 || true
        fi
        # shellcheck disable=SC2015
        command -v fisher >/dev/null 2>&1 && fisher update >/dev/null 2>&1 || true
    fi
}

do_unlink() {
    read_mappings | while IFS=$'\t' read -r SRC_RAW TGT_RAW NEEDS_SUDO ACTION; do
        if [[ "${ACTION}" == "nmcli-import" ]]; then
            local SRC conn_name
            SRC="$(make_absolute_source "${SRC_RAW}")"
            conn_name="$(nmcli_conn_name "${SRC}")"
            if [[ "${DRYRUN}" -eq 1 ]]; then
                msg "${DIM}DRY-RUN:${OFF} sudo nmcli connection delete ${BOLD}${conn_name}${OFF}"
            else
                if sudo nmcli connection show "${conn_name}" &>/dev/null; then
                    sudo nmcli connection delete "${conn_name}"
                    ok "Deleted NM connection: ${BOLD}${conn_name}${OFF}"
                else
                    warn "NM connection not found: ${BOLD}${conn_name}${OFF}"
                fi
            fi
            continue
        fi

        local TGT
        TGT="$(resolve_variables "${TGT_RAW}")"

        if maybe_sudo "${NEEDS_SUDO}" test -L "${TGT}" 2>/dev/null; then
            if [[ "${DRYRUN}" -eq 1 ]]; then
                msg "${DIM}DRY-RUN:${OFF} rm ${BOLD}${TGT}${OFF}"
            else
                maybe_sudo "${NEEDS_SUDO}" rm "${TGT}"
                ok "Removed symlink: ${BOLD}${TGT}${OFF}"
            fi
        else
            warn "No symlink: ${BOLD}${TGT}${OFF}"
        fi
    done
}

do_status() {
    read_mappings | while IFS=$'\t' read -r SRC_RAW TGT_RAW NEEDS_SUDO ACTION; do
        local SRC
        SRC="$(make_absolute_source "${SRC_RAW}")"

        if [[ "${ACTION}" == "nmcli-import" ]]; then
            local conn_name
            conn_name="$(nmcli_conn_name "${SRC}")"
            if ! [[ -e "${SRC}" ]]; then
                echo -e "${DIM}–${OFF} ${BOLD}${conn_name}${OFF} ${DIM}— source missing (${SRC})${OFF}"
            elif nmcli connection show "${conn_name}" &>/dev/null; then
                local state
                state="$(nmcli -g GENERAL.STATE connection show "${conn_name}" 2>/dev/null || echo 'unknown')"
                echo -e "${GRN}✓${OFF} ${BOLD}${conn_name}${OFF} ${DIM}(nmcli — ${state}) ← ${SRC}${OFF}"
            else
                echo -e "${YLW}⚠${OFF} ${BOLD}${conn_name}${OFF} ${DIM}— not imported yet${OFF}"
            fi
            continue
        fi

        local TGT
        TGT="$(resolve_variables "${TGT_RAW}")"

        local is_link=false is_exists=false
        maybe_sudo "${NEEDS_SUDO}" test -L "${TGT}" 2>/dev/null && is_link=true || true
        maybe_sudo "${NEEDS_SUDO}" test -e "${TGT}" 2>/dev/null && is_exists=true || true

        if [[ "${is_link}" == "true" ]] && [[ "${is_exists}" == "false" ]]; then
            echo -e "${RED}💀${OFF} ${BOLD}${TGT}${OFF} ${DIM}->${OFF} ${RED}BROKEN LINK${OFF} ${DIM}(source missing: ${SRC})${OFF}"
            continue
        fi

        if [[ "${is_link}" == "true" ]]; then
            local points
            points="$(maybe_sudo "${NEEDS_SUDO}" readlink "${TGT}")"

            case "${points}" in
                /*) ;;
                *) points="$(cd "$(dirname "${TGT}")" && pwd)/${points}";;
            esac

            local cpoints cexpected
            cpoints="$(canonical "${points}")"
            cexpected="$(canonical "${SRC}")"

            if [[ -n "${cexpected}" ]] && [[ -n "${cpoints}" ]] && [[ "${cpoints}" = "${cexpected}" ]]; then
                echo -e "${GRN}✓${OFF} ${BOLD}${TGT}${OFF} ${DIM}->${OFF} ${BLU}${SRC}${OFF}"
            else
                echo -e "${RED}✗${OFF} ${BOLD}${TGT}${OFF} ${DIM}->${OFF} ${YLW}${points}${OFF} ${RED}(expected ${SRC})${OFF}"
            fi
        elif [[ "${is_exists}" == "true" ]]; then
            echo -e "${YLW}⚠${OFF} ${BOLD}${TGT}${OFF} ${DIM}— regular file/folder, not symlink${OFF}"
        else
            echo -e "${DIM}–${OFF} ${BOLD}${TGT}${OFF} ${DIM}— missing${OFF}"
        fi
    done
}

do_doctor() {
    local ok_all=1

    echo "${BOLD}Running environment checks...${OFF}"
    echo ""

    if command -v git >/dev/null 2>&1; then
        ok "${GRN}✓${OFF} git found in PATH"
    else
        err "${RED}✗${OFF} git not found in PATH"
        ok_all=0
    fi

    if command -v jq >/dev/null 2>&1; then
        ok "${GRN}✓${OFF} jq found in PATH"
    else
        err "${RED}✗${OFF} jq not found in PATH"
        ok_all=0
    fi

    if is_git_repo; then
        ok "${GRN}✓${OFF} Git repository: ${BLU}${REPO_ROOT}${OFF}"
    else
        err "${RED}✗${OFF} Not a git repository: ${REPO_ROOT}"
        ok_all=0
    fi

    if [[ -f "${CONF_JSON}" ]]; then
        if jq empty "${CONF_JSON}" 2>/dev/null; then
            ok "${GRN}✓${OFF} JSON config valid: ${BLU}${CONF_JSON}${OFF}"
        else
            err "${RED}✗${OFF} Invalid JSON in ${CONF_JSON}"
            ok_all=0
        fi
    else
        err "${RED}✗${OFF} JSON config not found: ${CONF_JSON}"
        ok_all=0
    fi

    if [[ -f "${REPO_ROOT}/dotfiles.schema.json" ]]; then
        local schema_error=""
        if schema_error="$(validate_json_schema 2>&1)"; then
            ok "${GRN}✓${OFF} JSON config matches schema: ${BLU}${REPO_ROOT}/dotfiles.schema.json${OFF}"
        else
            err "${RED}✗${OFF} JSON config does not match schema: ${REPO_ROOT}/dotfiles.schema.json"
            if [[ -n "${schema_error}" ]]; then
                err "${schema_error}"
            fi
            ok_all=0
        fi
    else
        err "${RED}✗${OFF} JSON schema not found: ${REPO_ROOT}/dotfiles.schema.json"
        ok_all=0
    fi

    echo ""
    if [[ "${ok_all}" -eq 1 ]]; then
        ok "${GRN}All checks passed!${OFF}"
    else
        err "${RED}Some checks failed${OFF}"
        exit 1
    fi
}

# Systemd commands
services_enable_all() {
    if [[ ! -d "${SYSTEMD_DIR}" ]]; then
        err "Systemd user directory not found: ${SYSTEMD_DIR}"
        exit 1
    fi

    ok "Enabling all services and timers..."
    systemctl --user daemon-reload

    find "${SYSTEMD_DIR}" -type f \( -name "*.service" -o -name "*.timer" \) | while read -r file; do
        local service
        service="$(basename "${file}")"

        if systemctl --user enable "${service}" 2>/dev/null; then
            systemctl --user start "${service}" 2>/dev/null || true
            ok "✓ Enabled: ${service}"
        else
            warn "⚠ Failed to enable: ${service}"
        fi
    done

    echo ""
    ok "All services enabled!"
}

services_disable_all() {
    if [[ ! -d "${SYSTEMD_DIR}" ]]; then
        err "Systemd user directory not found: ${SYSTEMD_DIR}"
        exit 1
    fi

    ok "Disabling all services and timers..."

    find "${SYSTEMD_DIR}" -type f \( -name "*.service" -o -name "*.timer" \) | while read -r file; do
        local service
        service="$(basename "${file}")"

        systemctl --user stop "${service}" 2>/dev/null || true
        if systemctl --user disable "${service}" 2>/dev/null; then
            ok "✓ Disabled: ${service}"
        else
            warn "⚠ Failed to disable: ${service}"
        fi
    done

    echo ""
    ok "All services disabled!"
}

services_status() {
    if [[ ! -d "${SYSTEMD_DIR}" ]]; then
        err "Systemd user directory not found: ${SYSTEMD_DIR}"
        exit 1
    fi

    ok "Services status:"
    echo ""

    find "${SYSTEMD_DIR}" -type f \( -name "*.service" -o -name "*.timer" \) | sort | while read -r file; do
        local service
        service="$(basename "${file}")"

        local state
        state="$(systemctl --user is-enabled "${service}" 2>/dev/null || echo "disabled")"
        local active
        active="$(systemctl --user is-active "${service}" 2>/dev/null || echo "inactive")"

        local status_icon
        if [[ "${active}" = "active" ]]; then
            status_icon="${GRN}●${OFF}"
        elif [[ "${active}" = "inactive" ]] && [[ "${state}" = "enabled" ]]; then
            status_icon="${YLW}●${OFF}"
        else
            status_icon="${DIM}○${OFF}"
        fi

        printf "%s ${BOLD}%-40s${OFF} %s / %s\n" "${status_icon}" "${service}" "${state}" "${active}"
    done
}

services_list() {
    if [[ ! -d "${SYSTEMD_DIR}" ]]; then
        err "Systemd user directory not found: ${SYSTEMD_DIR}"
        exit 1
    fi

    ok "Services available in dotfiles:"
    echo ""
    find "${SYSTEMD_DIR}" -type f \( -name "*.service" -o -name "*.timer" \) | while read -r file; do
        basename "${file}"
    done | sort
}

# Setup command - bootstrap dotfiles on new system
do_setup() {
    cat <<EOF
${BOLD}╔═══════════════════════════════════════════════════════════╗
║           Workstation Dotfiles Bootstrap                  ║
╚═══════════════════════════════════════════════════════════╝${OFF}

This will:
  1. Check if running on Arch Linux
  2. Install Ansible (if needed)
  3. Run Ansible playbooks to provision system
  4. Create symlinks for dotfiles
  5. Enable systemd user services

EOF

    # Confirmation
    read -rp "${YLW}Continue? [y/N]${OFF} " confirm
    if [[ ! "${confirm}" =~ ^[Yy]$ ]]; then
        warn "Setup cancelled"
        exit 0
    fi

    echo ""
    ok "Starting bootstrap..."
    echo ""

    # Check if on Arch Linux
    if ! command -v pacman >/dev/null 2>&1; then
        err "This script is designed for Arch Linux"
        err "Please install dependencies manually"
        exit 1
    fi

    # Install Ansible if not present
    if ! command -v ansible-playbook >/dev/null 2>&1; then
        ok "Installing Ansible..."
        sudo pacman -S --needed --noconfirm ansible
    else
        ok "✓ Ansible already installed"
    fi

    # Install aur helper
    if ! ansible-galaxy collection list | grep -q '^kewlfft.aur '; then
        ok "Installing kewlfft.aur Ansible collection..."
        ansible-galaxy collection install kewlfft.aur
    else
        ok "✓ kewlfft.aur collection already installed"
    fi

    # Run Ansible playbooks
    ok "Running Ansible playbooks..."
    echo ""

    if [[ -f "${REPO_ROOT}/ansible/main.yml" ]]; then
        cd "${REPO_ROOT}"
        ansible-playbook ansible/main.yml --ask-become-pass
    else
        err "Ansible playbook not found: ${REPO_ROOT}/ansible/main.yml"
        exit 1
    fi

    echo ""
    ok "Ansible provisioning complete"
    echo ""

    # Enable systemd services
    ok "Setting up systemd services..."
    services_enable_all

    echo ""
    cat <<EOF
${GRN}╔═══════════════════════════════════════════════════════════╗
║                  Bootstrap Complete! 🎉                   ║
╚═══════════════════════════════════════════════════════════╝${OFF}

${BOLD}Next steps:${OFF}
  1. Logout and login again for changes to take effect
  2. Run ${BLU}workstation dotfiles doctor${OFF} to verify setup
  3. Check ${BLU}workstation dotfiles status${OFF} for symlink status
  4. View services with ${BLU}workstation services status${OFF}

${DIM}For help: workstation --help${OFF}
EOF
}

# Main command router
cmd="${1:-}"
shift || true

case "${cmd}" in
    # Setup command
    setup)
        do_setup
        ;;

    # Dotfiles commands
    dotfiles)
        subcmd="${1:-}"
        shift || true
        parse_args "$@"
        case "${subcmd}" in
            link) do_link ;;
            unlink) do_unlink ;;
            status) do_status ;;
            doctor) do_doctor ;;
            which)
                echo -e "${BOLD}Repository:${OFF} ${BLU}${REPO_ROOT}${OFF}"
                echo -e "${BOLD}Config JSON:${OFF} ${BLU}${CONF_JSON}${OFF}"
                ;;
            edit)
                ${EDITOR:-vi} "${CONF_JSON}"
                ;;
            *)
                err "Unknown dotfiles command: ${subcmd}"
                usage
                exit 1
                ;;
        esac
        ;;

    # Services commands
    services)
        subcmd="${1:-}"
        shift || true
        case "${subcmd}" in
            enable-all)
                services_enable_all
                ;;
            disable-all)
                services_disable_all
                ;;
            status)
                services_status
                ;;
            list)
                services_list
                ;;
            *)
                err "Unknown services command: ${subcmd}"
                usage
                exit 1
                ;;
        esac
        ;;

    help|-h|--help|"")
        usage
        ;;

    *)
        err "Unknown command: ${cmd}"
        usage
        exit 1
        ;;
esac
