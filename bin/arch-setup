#!/bin/bash

# Arch Linux System Setup Script
# Sets up a complete Wayland-based desktop environment with Sway

set -e

echo "=== Arch Linux System Setup ==="
echo "Setting up Wayland desktop environment with Sway, Waybar, and development tools"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Check if running on Arch Linux
if ! command -v pacman &> /dev/null; then
    log_error "This script is designed for Arch Linux only!"
    exit 1
fi

# Update system
log_info "Updating system packages..."
sudo pacman -Syu --noconfirm

# Install essential packages
log_info "Installing essential packages..."
sudo pacman -S --noconfirm --needed \
    base-devel \
    git \
    curl \
    jq \
    make \
    less \
    unzip \
    gcc

# Install shell and terminal
log_info "Installing shell and terminal..."
sudo pacman -S --noconfirm --needed \
    fish \
    zsh \
    alacritty \
    tmux

# Install editors
log_info "Installing editors..."
sudo pacman -S --noconfirm --needed neovim

# Install Wayland desktop environment
log_info "Installing Wayland desktop environment..."
sudo pacman -S --noconfirm --needed \
    sway \
    waybar \
    wofi \
    mako \
    swaylock \
    swayidle \
    swaybg \
    wl-clipboard \
    grim \
    slurp \
    brightnessctl

# Install display manager
log_info "Installing display manager..."
sudo pacman -S --noconfirm --needed sddm

# Install audio system
log_info "Installing audio system..."
sudo pacman -S --noconfirm --needed \
    pipewire \
    pipewire-alsa \
    pavucontrol \
    pipewire-pulse \
    wireplumber
    # pipewire-jack

# Install fonts
log_info "Installing fonts..."
sudo pacman -S --noconfirm --needed \
    ttf-jetbrains-mono-nerd \
    otf-font-awesome

# Install development tools
log_info "Installing development tools..."
sudo pacman -S --noconfirm --needed \
    php \
    composer \
    docker \
    docker-compose \
    python-pip \
    python-pipx

# Install utilities
log_info "Installing utilities..."
sudo pacman -S --noconfirm --needed \
    ripgrep \
    fd \
    bottom \
    firefox \
    wireguard-tools \
    github-cli \
    mesa \
    flatpak

# Install AUR helper (yay)
if ! command -v yay &> /dev/null; then
    log_info "Installing yay AUR helper..."
    cd /tmp
    git clone https://aur.archlinux.org/yay.git
    cd yay
    makepkg -si --noconfirm
    cd ~
    rm -rf /tmp/yay
fi

# System configuration
log_info "Configuring system services..."

# Enable and start essential services
sudo systemctl enable docker.service sddm.service systemd-resolved.service

# Add user to docker group
sudo usermod -aG docker "$USER"

# Configure locale (if not already set)
if ! grep -q "en_US.UTF-8" /etc/locale.gen; then
    log_info "Configuring locale..."
    echo "en_US.UTF-8 UTF-8" | sudo tee -a /etc/locale.gen
    sudo locale-gen
    localectl set-locale LANG=en_US.UTF-8
fi

# Enable audio services for user
log_info "Enabling audio services..."
systemctl --user enable pipewire pipewire-pulse wireplumber

# Setup Fish shell
if command -v fish &> /dev/null; then
    log_info "Configuring Fish shell..."

    # Change default shell to fish
    if [[ "$SHELL" != *"fish"* ]]; then
        log_info "Changing default shell to Fish..."
        chsh -s /usr/bin/fish
    fi

    # Install Fisher (Fish plugin manager)
    log_info "Installing Fisher plugin manager..."
    fish -c "curl -sL https://raw.githubusercontent.com/jorgebucaran/fisher/main/functions/fisher.fish | source && fisher install jorgebucaran/fisher"
fi

# Install Python development tools via pipx
if command -v pipx &> /dev/null; then
    log_info "Installing Python development tools..."
    pipx install pre-commit
    pipx install black
    pipx install flake8
    pipx install mypy
fi

# Install PHP development tools via composer
if command -v composer &> /dev/null; then
    log_info "Installing PHP development tools globally..."
    composer global require phpstan/phpstan --no-interaction
    composer global require friendsofphp/php-cs-fixer --no-interaction
    composer global require squizlabs/php_codesniffer --no-interaction
    composer global require rector/rector --no-interaction
fi

# Additional AUR packages
read -p "Do you want to replace sway with swayfx? (y/n) " -n 1 -r
echo
if [[ $REPLY =~ ^[Yy]$ ]]; then
    yay -S --noconfirm --needed swayfx
fi

# GitHub CLI authentication prompt
log_info "Setting up GitHub CLI (optional)..."
log_warn "You can authenticate with GitHub CLI later using: gh auth login"

# Final system cleanup
log_info "Cleaning up package cache..."
sudo pacman -Sc --noconfirm
if command -v yay &> /dev/null; then
    yay -Sc --noconfirm
fi

echo ""
log_info "=== Setup Complete! ==="
echo ""
log_warn "Important notes:"
echo "  1. Reboot your system to ensure all changes take effect"
echo "  2. Log out and log back in to use the new shell (Fish)"
echo "  3. Configure your WireGuard VPN in ~/.config/wireguard/ if needed"
echo "  4. Run 'gh auth login' to authenticate with GitHub"
echo "  5. The display manager (SDDM) is enabled and will start on boot"
echo ""
log_info "Your Arch Linux system is now ready with Sway desktop environment!"

read -p "Do you want to reboot now? (y/n) " -n 1 -r
echo
if [[ $REPLY =~ ^[Yy]$ ]]; then
    log_info "Rebooting system..."
    sudo reboot
fi
