#!/bin/bash

# Arch Linux System Setup Script
# Sets up a complete Wayland-based desktop environment with Sway

set -e

echo "=== Arch Linux System Setup ==="
echo "Setting up Wayland desktop environment with Sway, Waybar, and development tools"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

log_prompt() {
    echo -e "${BLUE}[PROMPT]${NC} $1"
}

# Get the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
INSTALL_PACKAGES_SCRIPT="$SCRIPT_DIR/install-packages"

# Helper function to call package installer
install_packages() {
    if [ ! -f "$INSTALL_PACKAGES_SCRIPT" ]; then
        log_error "Package installer script not found: $INSTALL_PACKAGES_SCRIPT"
        exit 1
    fi

    "$INSTALL_PACKAGES_SCRIPT" "$@"
}

# Helper function to enable service only if package exists
enable_service() {
    local service=$1
    local package=$2

    if pacman -Q "$package" &> /dev/null; then
        log_info "Enabling $service..."
        sudo systemctl enable "$service"
    else
        log_warn "Package $package not found, skipping $service"
    fi
}

# Helper function for user services
enable_user_service() {
    local service=$1
    local package=$2

    if pacman -Q "$package" &> /dev/null; then
        log_info "Enabling user service $service..."
        systemctl --user enable "$service"
    else
        log_warn "Package $package not found, skipping user service $service"
    fi
}

# Check if running on Arch Linux
if ! command -v pacman &> /dev/null; then
    log_error "This script is designed for Arch Linux only!"
    exit 1
fi

# User choices
log_prompt "Select CPU microcode updates:"
echo "1) AMD (amd-ucode)"
echo "2) Intel (intel-ucode)"
echo "3) Skip"
read -r -p "Choice (1-3): " cpu_choice

log_prompt "Select display manager:"
echo "1) SDDM (Simple Desktop Display Manager)"
echo "2) greetd (Lightweight)"
echo "3) KDE Plasma (full desktop environment)"
echo "4) None"
read -r -p "Choice (1-4): " dm_choice

log_prompt "Install additional development tools? (y/n): "
read -r -p "Choice (y/n): " dev_tools_choice

log_prompt "Install custom GRUB theme? (y/n): "
read -r -p "Choice (y/n): " grub_theme_choice

log_prompt "Select GPU drivers:"
echo "1) NVIDIA (proprietary)"
echo "2) AMD/Intel (open source)"
echo "3) Skip"
read -r -p "Choice (1-3): " gpu_choice

log_prompt "Install multimedia codecs? (y/n): "
read -r -p "Choice (y/n): " multimedia_choice

log_prompt "Configure timezone and locale? (y/n): "
read -r -p "Choice (y/n): " locale_choice

# Update system
log_info "Updating system packages..."
sudo pacman -Syu --noconfirm

# Update mirror list
log_info "Updating mirror list with reflector..."
sudo pacman -S --noconfirm --needed reflector
sudo reflector --country 'Russia' --latest 10 --age 24 --sort rate --save /etc/pacman.d/mirrorlist

# Install CPU microcode
case $cpu_choice in
    1)
        install_packages cpu-microcode amd
        ;;
    2)
        install_packages cpu-microcode intel
        ;;
    3)
        log_info "Skipping CPU microcode installation..."
        ;;
esac

# Install all basic packages
install_packages all-basic

# Install display manager based on user choice
case $dm_choice in
    1)
        install_packages display-manager sddm
        ;;
    2)
        install_packages display-manager greetd
        ;;
    3)
        install_packages display-manager kde
        ;;
    4)
        log_info "Skipping display manager installation..."
        ;;
esac

# Install GPU drivers based on user choice
case $gpu_choice in
    1)
        install_packages gpu-drivers nvidia
        ;;
    2)
        install_packages gpu-drivers amd-intel
        ;;
    3)
        log_info "Skipping GPU drivers installation..."
        ;;
esac

# Install AUR helper (yay)
install_packages yay

# System configuration
log_info "Configuring system services..."

# Enable and start essential services
enable_service "docker.service" "docker"
enable_service "NetworkManager.service" "networkmanager"
enable_service "bluetooth.service" "bluez"

# Configure display manager based on choice
case $dm_choice in
    1|3)
        enable_service "sddm.service" "sddm"
        ;;
    2)
        enable_service "greetd.service" "greetd"
        # Configure greetd for Sway with ReGreet
        log_info "Configuring greetd for Sway with ReGreet..."

        # Create greetd configuration directory
        sudo mkdir -p /etc/greetd

        # Create Sway configuration for greetd
        sudo tee /etc/greetd/sway-config > /dev/null <<EOF
# Sway configuration for greetd with ReGreet
# Do not modify this file unless you know what you're doing

# Output configuration (can be customized)
output * bg #1e1e2e solid_color

# Disable Sway decorations and bars
default_border none
default_floating_border none
font pango:monospace 0
titlebar_border_thickness 0
titlebar_padding 0

# Security: disable dangerous key bindings
bindsym --release Ctrl+Alt+t exec true
bindsym --release Ctrl+Alt+Delete exec true

# Run ReGreet and exit Sway when it's done
exec "regreet; swaymsg exit"

# Include system-wide Sway configuration if needed
include /etc/sway/config.d/*
EOF

        # Create greetd main configuration
        sudo tee /etc/greetd/config.toml > /dev/null <<EOF
[terminal]
vt = 1

[default_session]
command = "sway --config /etc/greetd/sway-config"
user = "greeter"
EOF

        # Create ReGreet configuration directory and sample config
        sudo mkdir -p /etc/greetd
        sudo tee /etc/greetd/regreet.toml > /dev/null <<EOF
[background]
# Path to background image (optional)
# path = "/usr/share/backgrounds/default.jpg"
# fit = "Cover"

[GTK]
application_prefer_dark_theme = true
cursor_theme_name = "Adwaita"
font_name = "JetBrains Mono Nerd Font 12"
icon_theme_name = "Adwaita"
theme_name = "Adwaita"

[commands]
reboot = ["systemctl", "reboot"]
poweroff = ["systemctl", "poweroff"]

[appearance]
greeting_msg = "Welcome to Arch Linux!"

[widget.clock]
format = "%a, %B %d  %H:%M"
EOF

        # Setup state and log directories
        sudo systemd-tmpfiles --create - <<EOF
d /var/lib/regreet 0755 greeter greeter - -
d /var/log/regreet 0755 greeter greeter - -
EOF

        # Create greeter user if it doesn't exist
        if ! id greeter &>/dev/null; then
            sudo useradd -r -s /bin/false -d /var/lib/greeter -c "Greeter user" greeter
        fi

        ;;
esac

# Configure firewall
enable_service "ufw.service" "ufw"
sudo ufw --force enable
sudo ufw default deny incoming
sudo ufw default allow outgoing

# Configure sudo access for wheel group
log_info "Configuring sudo access..."
if ! sudo grep -q "^%wheel.*NOPASSWD" /etc/sudoers; then
    log_info "Enabling wheel group in sudoers..."
    echo '%wheel ALL=(ALL:ALL) ALL' | sudo tee -a /etc/sudoers.d/wheel-group
    sudo chmod 440 /etc/sudoers.d/wheel-group
fi

# Add user to necessary groups
sudo usermod -aG docker "$USER" 2>/dev/null || true
sudo usermod -aG wheel "$USER" 2>/dev/null || true

# Configure timezone and locale if requested
if [[ $locale_choice =~ ^[Yy]$ ]]; then
    log_info "Configuring timezone..."

    # Set timezone (you can customize this or make it interactive)
    if [ ! -L /etc/localtime ]; then
        log_info "Setting timezone to Europe/Moscow..."
        sudo timedatectl set-timezone Europe/Moscow
    fi

    # Enable NTP time synchronization
    log_info "Enabling NTP time synchronization..."
    sudo timedatectl set-ntp true

    # Configure locale
    log_info "Configuring locale..."

    # Ensure en_US.UTF-8 is enabled
    if ! grep -q "^en_US.UTF-8" /etc/locale.gen; then
        sudo sed -i 's/#en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen
        echo "en_US.UTF-8 UTF-8" | sudo tee -a /etc/locale.gen
    fi

    # Also enable Russian locale if needed
    if ! grep -q "^ru_RU.UTF-8" /etc/locale.gen; then
        sudo sed -i 's/#ru_RU.UTF-8 UTF-8/ru_RU.UTF-8 UTF-8/' /etc/locale.gen
    fi

    sudo locale-gen
    sudo localectl set-locale LANG=en_US.UTF-8

    log_info "Timezone and locale configured successfully"

    # Configure hostname if not set properly
    current_hostname=$(hostnamectl hostname)
    if [[ "$current_hostname" == "localhost" ]] || [[ -z "$current_hostname" ]]; then
        log_prompt "Current hostname is '$current_hostname'. Set a new hostname? (y/n): "
        read -r hostname_choice
        if [[ $hostname_choice =~ ^[Yy]$ ]]; then
            read -r -p "Enter new hostname: " new_hostname
            if [[ -n "$new_hostname" ]]; then
                log_info "Setting hostname to '$new_hostname'..."
                echo "$new_hostname" | sudo tee /etc/hostname
                sudo sed -i "s/127\.0\.1\.1.*/127.0.1.1\t$new_hostname/" /etc/hosts
                # Add entry if it doesn't exist
                if ! grep -q "127.0.1.1" /etc/hosts; then
                    echo "127.0.1.1	$new_hostname" | sudo tee -a /etc/hosts
                fi
                sudo hostnamectl set-hostname "$new_hostname"
            fi
        fi
    fi
else
    # Just ensure basic locale is set
    if ! grep -q "en_US.UTF-8" /etc/locale.gen; then
        log_info "Ensuring basic locale configuration..."
        echo "en_US.UTF-8 UTF-8" | sudo tee -a /etc/locale.gen
        sudo locale-gen
        sudo localectl set-locale LANG=en_US.UTF-8
    fi
fi

# Setup environment variables for all users
log_info "Setting up environment variables..."

# Create base environment variables
cat > /tmp/environment_base <<EOF
# Base environment variables
MOZ_ENABLE_WAYLAND=1
# Disable portal issues that can cause startup delays
GTK_USE_PORTAL=0
GDK_DEBUG=no-portals
EOF

# Add display-specific variables based on choice
case $dm_choice in
    1)  # SDDM
        cat >> /tmp/environment_base <<EOF

# SDDM environment
XDG_SESSION_TYPE=x11
EOF
        ;;
    2)  # greetd with Sway
        cat >> /tmp/environment_base <<EOF

# Wayland/Sway environment variables
XDG_SESSION_TYPE=wayland
XDG_CURRENT_DESKTOP=sway
XDG_SESSION_DESKTOP=sway
QT_QPA_PLATFORM=wayland
GDK_BACKEND=wayland
EOF
        ;;
    3)  # KDE Plasma
        cat >> /tmp/environment_base <<EOF

# KDE Plasma environment
XDG_SESSION_TYPE=x11
XDG_CURRENT_DESKTOP=KDE
XDG_SESSION_DESKTOP=KDE
EOF
        ;;
    4)  # None - assume Sway will be used
        cat >> /tmp/environment_base <<EOF

# Wayland/Sway environment variables (no display manager)
XDG_SESSION_TYPE=wayland
XDG_CURRENT_DESKTOP=sway
XDG_SESSION_DESKTOP=sway
QT_QPA_PLATFORM=wayland
GDK_BACKEND=wayland
EOF
        ;;
esac

# Apply the environment configuration
sudo cp /tmp/environment_base /etc/environment
rm /tmp/environment_base

# Enable audio services for user
log_info "Enabling audio services..."
enable_user_service "pipewire.service" "pipewire"
enable_user_service "pipewire-pulse.service" "pipewire-pulse"
enable_user_service "wireplumber.service" "wireplumber"

# Setup Fish shell
if command -v fish &> /dev/null; then
    log_info "Configuring Fish shell..."

    # Change default shell to fish
    if [[ "$SHELL" != *"fish"* ]]; then
        log_info "Changing default shell to Fish..."
        chsh -s /usr/bin/fish
    fi

    # Install Fisher (Fish plugin manager)
    log_info "Installing Fisher plugin manager..."
    fish -c "curl -sL https://raw.githubusercontent.com/jorgebucaran/fisher/main/functions/fisher.fish | source && fisher install jorgebucaran/fisher"

    if [ -f "../fish/fish_plugins" ]; then
        log_info "Installing Fish plugins from fish_plugins file..."
        fish -c "fisher update"
    else
        log_warn "fish_plugins file not found, installing default plugins..."
        fish -c "fisher install jorgebucaran/hydro"
        fish -c "fisher install ilancosman/tide@v6"
        fish -c "fisher install jorgebucaran/nvm.fish"
    fi
fi

# Install multimedia codecs if requested
if [[ $multimedia_choice =~ ^[Yy]$ ]]; then
    install_packages multimedia
fi

if [[ $dev_tools_choice =~ ^[Yy]$ ]]; then
    # Install Python development tools via pipx
    if command -v pipx &> /dev/null; then
        log_info "Installing Python development tools..."
        pipx install pre-commit
        pipx install black
        pipx install flake8
        pipx install mypy
    fi

    # Install PHP development tools via composer
    if command -v composer &> /dev/null; then
        log_info "Installing PHP development tools globally..."
        composer global require friendsofphp/php-cs-fixer --no-interaction
        composer global require rector/rector --no-interaction
    fi
fi

# Install AUR packages if yay is available
if command -v yay &> /dev/null; then
    install_packages aur-essentials

    # Optional AUR packages
    log_prompt "Install Visual Studio Code? (y/n): "
    read -n 1 -r vscode_choice
    echo
    if [[ $vscode_choice =~ ^[Yy]$ ]]; then
        install_packages aur-app vscode
    fi

    log_prompt "Install SwayFX (enhanced Sway with effects)? (y/n): "
    read -n 1 -r swayfx_choice
    echo
    if [[ $swayfx_choice =~ ^[Yy]$ ]]; then
        install_packages aur-app swayfx
    fi

    log_prompt "Install Swaylock-effects? (y/n): "
    read -n 1 -r swaylock_choice
    echo
    if [[ $swaylock_choice =~ ^[Yy]$ ]]; then
        install_packages aur-app swaylock-effects
    fi
fi

# Optional applications installation
log_info "=== Optional Applications ==="
log_info "The following applications can be installed optionally:"

# Communication apps
log_prompt "Install Discord? (y/n): "
read -n 1 -r discord_choice
echo
if [[ $discord_choice =~ ^[Yy]$ ]]; then
    install_packages optional-app discord
fi

log_prompt "Install Telegram? (y/n): "
read -n 1 -r telegram_choice
echo
if [[ $telegram_choice =~ ^[Yy]$ ]]; then
    install_packages optional-app telegram
fi

# Media and entertainment
log_prompt "Install Spotify? (y/n): "
read -n 1 -r spotify_choice
echo
if [[ $spotify_choice =~ ^[Yy]$ ]]; then
    install_packages optional-app spotify
fi

log_prompt "Install VLC media player? (y/n): "
read -n 1 -r vlc_choice
echo
if [[ $vlc_choice =~ ^[Yy]$ ]]; then
    install_packages optional-app vlc
fi

# Productivity apps
log_prompt "Install Obsidian (note-taking app)? (y/n): "
read -n 1 -r obsidian_choice
echo
if [[ $obsidian_choice =~ ^[Yy]$ ]]; then
    install_packages optional-app obsidian
fi

# Logout manager
log_prompt "Install wlogout (Wayland logout manager)? (y/n): "
read -n 1 -r wlogout_choice
echo
if [[ $wlogout_choice =~ ^[Yy]$ ]]; then
    install_packages aur-app wlogout
fi

# Configure GRUB theme if requested
if [[ $grub_theme_choice =~ ^[Yy]$ ]]; then
    log_info "Installing and configuring custom GRUB theme..."
    install_packages aur-app grub-customizer

    # Check if Xenlism Arch theme exists locally
    DOTFILES_THEME_PATH="$HOME/Code/Dotfiles/grub/themes/Xenlism Arch"

    if [ -d "$DOTFILES_THEME_PATH" ] && [ -f "$DOTFILES_THEME_PATH/install.sh" ]; then
        log_info "Found local Xenlism Arch theme, using local installer..."

        # Copy theme to temporary location for installation
        cp -r "$DOTFILES_THEME_PATH" /tmp/xenlism-theme
        cd /tmp/xenlism-theme

        # Make install script executable and run it
        chmod +x install.sh
        log_info "Running Xenlism theme installer..."
        sudo ./install.sh

        # Cleanup
        cd ~
        rm -rf /tmp/xenlism-theme

    else
        log_info "Local theme not found, downloading from repository..."

        # Download Xenlism GRUB theme
        cd /tmp
        log_info "Downloading Xenlism GRUB theme..."
        curl -L -o xenlism-grub-arch.tar.gz "https://github.com/xenlism/Grub-themes/archive/refs/heads/main.tar.gz"

        # Extract theme
        log_info "Extracting GRUB theme archive..."
        tar -xzf xenlism-grub-arch.tar.gz

        # Find the Xenlism Arch theme directory
        if [ -d "Grub-themes-main/xenlism-grub-arch-2k" ]; then
            THEME_SRC="Grub-themes-main/xenlism-grub-arch-2k"
        elif [ -d "Grub-themes-main/Xenlism-Arch" ]; then
            THEME_SRC="Grub-themes-main/Xenlism-Arch"
        else
            log_error "Could not find Xenlism Arch theme in downloaded archive"
            cd ~
            rm -rf /tmp/Grub-themes-main /tmp/xenlism-grub-arch.tar.gz
            exit 1
        fi

        # Manual installation if no installer script found
        log_info "Installing theme manually..."

        # Create themes directory and install theme
        sudo mkdir -p /usr/share/grub/themes/Xenlism-Arch
        sudo cp -r "$THEME_SRC"/* /usr/share/grub/themes/Xenlism-Arch/

        # Backup original GRUB config
        if [ -f /etc/default/grub ]; then
            sudo cp /etc/default/grub /etc/default/grub.backup
            log_info "Backed up original GRUB config to /etc/default/grub.backup"
        fi

        # Remove existing GRUB_THEME lines and add new one
        sudo sed -i '/GRUB_THEME=/d' /etc/default/grub
        echo 'GRUB_THEME="/usr/share/grub/themes/Xenlism-Arch/theme.txt"' | sudo tee -a /etc/default/grub

        # Update GRUB configuration
        log_info "Updating GRUB configuration..."
        sudo grub-mkconfig -o /boot/grub/grub.cfg

        # Cleanup
        rm -rf /tmp/Grub-themes-main /tmp/xenlism-grub-arch.tar.gz
        cd ~
    fi

    log_info "GRUB theme installation completed!"
fi

# GitHub CLI authentication prompt
log_info "Setting up GitHub CLI (optional)..."
log_warn "You can authenticate with GitHub CLI later using: gh auth login"

# Final system cleanup
log_info "Cleaning up package cache..."
sudo pacman -Sc --noconfirm
if command -v yay &> /dev/null; then
    yay -Sc --noconfirm
fi

echo ""
log_info "=== Setup Complete! ==="
echo ""
log_warn "Important notes:"
echo "  1. Reboot your system to ensure all changes take effect"
echo "  2. Log out and log back in to use the new shell (Fish)"
case $dm_choice in
    1)
        echo "  3. SDDM is configured and will start on boot"
        ;;
    2)
        echo "  3. greetd with ReGreet is configured and will start on boot"
        echo "     ReGreet will automatically run Sway - just login with your user"
        ;;
    3)
        echo "  3. KDE Plasma is installed with SDDM"
        ;;
    4)
        echo "  3. No display manager - Sway auto-start is configured for tty1"
        echo "     Login on tty1 and Sway will start automatically"

        # Setup auto-start for Sway when no display manager
        if [ ! -f "$HOME/.profile" ] || ! grep -q "exec sway" "$HOME/.profile"; then
            log_info "Setting up Sway auto-start for tty1..."
            cat >> "$HOME/.profile" <<EOF

# Auto-start Sway on tty1
if [[ -z \$DISPLAY && \$(tty) == /dev/tty1 ]]; then
  exec sway
fi
EOF
        fi
        ;;
esac
echo "  4. Configure your WireGuard VPN in ~/.config/wireguard/ if needed"
echo "  5. Run 'gh auth login' to authenticate with GitHub"
echo "  6. Firewall (ufw) is enabled and configured"
if [[ $grub_theme_choice =~ ^[Yy]$ ]]; then
    echo "  7. Custom GRUB theme is installed and configured"
    echo "     Use 'sudo grub-customizer' to further customize GRUB appearance"
fi
if [[ $locale_choice =~ ^[Yy]$ ]]; then
    echo "  8. Timezone, locale, and hostname have been configured"
fi
if [[ $multimedia_choice =~ ^[Yy]$ ]]; then
    echo "  9. Multimedia codecs are installed"
fi
echo "  10. Optional applications have been installed based on your choices"
echo "  11. Your user has been added to wheel and docker groups"
echo ""

log_info "Your Arch Linux system is now ready!"

read -r -p "Do you want to reboot now? (y/n) " -n 1 REPLY
echo
if [[ $REPLY =~ ^[Yy]$ ]]; then
    log_info "Rebooting system..."
    sudo reboot
fi
