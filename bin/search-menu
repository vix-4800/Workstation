#!/usr/bin/env bash
# File and directory search menu for Sway with wofi
# Searches: files and directories in common locations

set -euo pipefail

# Colors for output
readonly RED='\033[0;31m'
readonly GRN='\033[0;32m'
readonly YLW='\033[1;33m'
readonly NC='\033[0m' # No Color

# Configuration
readonly MAX_FILE_RESULTS=100
readonly MAX_DIR_RESULTS=50
readonly SEARCH_PATHS=(
    "${HOME}/Documents"
    "${HOME}/Downloads"
    "${HOME}/Pictures"
    "${HOME}/Code"
    "${HOME}/.config"
    "${HOME}/Desktop"
)

# Cache directory
readonly CACHE_DIR="${HOME}/.cache/search-menu"
mkdir -p "${CACHE_DIR}"

# Functions
msg() { echo -e "${GRN}==>${NC} $*"; }
warn() { echo -e "${YLW}WARNING:${NC} $*" >&2; }
err() { echo -e "${RED}ERROR:${NC} $*" >&2; }

# Get recent files and directories
get_files_and_dirs() {
    local search_paths=()

    # Only include paths that exist
    for path in "${SEARCH_PATHS[@]}"; do
        [[ -d "${path}" ]] && search_paths+=("${path}")
    done

    if [[ ${#search_paths[@]} -eq 0 ]]; then
        warn "No search paths found"
        return 1
    fi

    # Find files modified in last 60 days
    find "${search_paths[@]}" \
        -type f \
        -not -path "*/.*" \
        -not -path "*/node_modules/*" \
        -not -path "*/.git/*" \
        -not -path "*/vendor/*" \
        -not -path "*/__pycache__/*" \
        -not -path "*/venv/*" \
        -not -path "*/.venv/*" \
        -mtime -60 \
        -printf "📄 %f | %p\n" \
        2>/dev/null | head -n "${MAX_FILE_RESULTS}" || true

    # Find directories (max depth 5)
    find "${search_paths[@]}" \
        -maxdepth 5 \
        -type d \
        -not -path "*/.*" \
        -not -path "*/node_modules" \
        -not -path "*/node_modules/*" \
        -not -path "*/.git" \
        -not -path "*/.git/*" \
        -not -path "*/vendor" \
        -not -path "*/vendor/*" \
        -not -path "*/__pycache__" \
        -not -path "*/__pycache__/*" \
        -printf "📁 %f | %p\n" \
        2>/dev/null | head -n "${MAX_DIR_RESULTS}" || true
}

# Build search index
build_search_index() {
    local cache_file="${CACHE_DIR}/search-index"
    local cache_age=1800 # 30 minutes

    # Check if cache is fresh
    if [[ -f "${cache_file}" ]]; then
        local age=$(($(date +%s) - $(stat -c %Y "${cache_file}")))
        if [[ ${age} -lt ${cache_age} ]]; then
            cat "${cache_file}"
            return
        fi
    fi

    # Build new index
    get_files_and_dirs | tee "${cache_file}"
}

# Handle selection
handle_selection() {
    local selection="$1"

    # Extract type and content
    local type="${selection%% *}"
    local content="${selection#* }"

    case "${type}" in
        "📄")
            # Open file with xdg-open
            local filepath
            filepath=$(echo "${content}" | cut -d'|' -f2 | xargs)
            if [[ -f "${filepath}" ]]; then
                xdg-open "${filepath}" &>/dev/null &
            fi
            ;;
        "📁")
            # Open directory in file manager
            local dirpath
            dirpath=$(echo "${content}" | cut -d'|' -f2 | xargs)
            if [[ -d "${dirpath}" ]]; then
                thunar "${dirpath}" &>/dev/null &
            fi
            ;;
        *)
            warn "Unknown selection type: ${type}"
            ;;
    esac
}

# Main function
main() {
    # Check dependencies
    for cmd in wofi find xdg-open; do
        if ! command -v "${cmd}" &>/dev/null; then
            err "Required command not found: ${cmd}"
            exit 1
        fi
    done

    # Build search index and show menu
    local selection
    selection=$(build_search_index | wofi \
        --dmenu \
        --prompt="🔍 Find Files & Folders" \
        --width=65% \
        --height=55% \
        --location=center \
        --allow-markup \
        --insensitive \
        --matching=fuzzy \
        --cache-file=/dev/null)

    # Handle selection
    if [[ -n "${selection}" ]]; then
        handle_selection "${selection}"
    fi
}

main "$@"
