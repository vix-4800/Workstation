---
# Desktop (second machine) — rename to <hostname>.yml

hostname: CHANGEME
cpu_vendor: intel
gpu_vendor: nvidia
has_battery: false
vpn_profile: desktop

# WireGuard (values from vault)
wg_private_key: "{{ vault_wg_private_key_desktop }}"
wg_address: "{{ vault_wg_address_desktop }}"
wg_dns: "{{ vault_wg_dns }}"
