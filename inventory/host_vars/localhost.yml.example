---
# Machine-specific variables for this host.
# Copy this file to localhost.yml and fill in the values.

username: vix        # local user account name
hostname: workstation
cpu_vendor: intel   # intel | amd
gpu_vendor: nvidia  # nvidia | amd | none
has_battery: false  # true for laptops
base_timezone: Europe/Saratov  # override default UTC, see timedatectl list-timezones
git_user_name: Your Name
git_user_email: your.email@example.com
